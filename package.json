{
  "name": "selfmade-haushaltsapp",
  "version": "19.3.0",
  "private": true,
  "type": "module",
  "description": "HaushaltKlar V19.3 mit proprietärem Rechte-, Datenschutz-, Anti-Crawling- und TDM-Schutz.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "reset": "node scripts/reset-db.mjs",
    "build": "node scripts/build-vercel.mjs",
    "vercel-build": "npm run build",
    "dev:vercel": "vercel dev",
    "prepare:assets": "node scripts/assemble-assets.mjs",
    "predev": "npm run prepare:assets",
    "prestart": "npm run prepare:assets",
    "pretest": "npm run prepare:assets",
    "prebuild": "npm run prepare:assets"
  }
}
