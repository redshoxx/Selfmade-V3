{
  "name": "selfmade-haushaltsapp",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Vercel- und iPhone-optimierte Haushalts-PWA mit Supabase Cloud, Geld, Einkauf, Vorrat, Notizen, Barcode und Kassenbon.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "reset": "node scripts/reset-db.mjs",
    "build": "node scripts/build-vercel.mjs",
    "vercel-build": "npm run build",
    "dev:vercel": "vercel dev"
  }
}
