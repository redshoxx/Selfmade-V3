:root {
  color-scheme: light;
  --bg: #f4f5f2;
  --surface: #ffffff;
  --surface-soft: #eef0eb;
  --surface-strong: #e5e8e1;
  --text: #171a16;
  --text-soft: #667065;
  --line: #dfe3dc;
  --accent: #355f3a;
  --accent-strong: #24482a;
  --accent-soft: #e3ece2;
  --positive: #2f6b3c;
  --positive-soft: #e3f1e6;
  --negative: #9a4139;
  --negative-soft: #f7e7e4;
  --warning: #946c1f;
  --warning-soft: #f6edd7;
  --shadow: 0 12px 32px rgba(29, 38, 28, .07);
  --shadow-strong: 0 24px 70px rgba(19, 27, 18, .18);
  --radius-sm: 12px;
  --radius: 18px;
  --radius-lg: 26px;
  --sidebar-width: 244px;
  --content-max: 1180px;
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 16px;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111510;
  --surface: #191e18;
  --surface-soft: #20261f;
  --surface-strong: #293027;
  --text: #f2f5ef;
  --text-soft: #aab3a7;
  --line: #313930;
  --accent: #92bd91;
  --accent-strong: #b5d7b3;
  --accent-soft: #263627;
  --positive: #8ac590;
  --positive-soft: #233626;
  --negative: #e49a92;
  --negative-soft: #3c2624;
  --warning: #e0bb67;
  --warning-soft: #3b3220;
  --shadow: 0 12px 32px rgba(0, 0, 0, .18);
  --shadow-strong: 0 24px 70px rgba(0, 0, 0, .46);
}

* { box-sizing: border-box; }
html, body { min-height: 100%; margin: 0; background: var(--bg); color: var(--text); }
body { min-height: 100dvh; overflow-x: hidden; }
body.modal-open { overflow: hidden; }
button, input, textarea, select { font: inherit; }
button { color: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 35%, transparent); outline-offset: 2px; }
button:disabled { opacity: .55; cursor: not-allowed; }
button { border: 0; background: none; cursor: pointer; }
input, textarea, select { width: 100%; min-height: 48px; border: 1px solid var(--line); border-radius: 13px; background: var(--surface); color: var(--text); padding: 12px 14px; transition: border-color .18s ease, box-shadow .18s ease, background .18s ease; }
textarea { resize: vertical; line-height: 1.55; }
input::placeholder, textarea::placeholder { color: color-mix(in srgb, var(--text-soft) 70%, transparent); }
input:focus, textarea:focus, select:focus { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent); }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3, strong { letter-spacing: -.018em; }
.icon { flex: 0 0 auto; }

.is-busy { cursor: progress; }
.is-busy::after { content: ""; position: fixed; inset: 0; z-index: 9999; background: transparent; cursor: progress; }

.app-layout { min-height: 100dvh; }
.side-nav { position: fixed; inset: 0 auto 0 0; z-index: 20; width: var(--sidebar-width); display: flex; flex-direction: column; gap: 28px; padding: 28px 20px; background: var(--surface); border-right: 1px solid var(--line); }
.brand { display: flex; align-items: center; gap: 12px; }
.brand > div:last-child { min-width: 0; display: grid; gap: 2px; }
.brand strong { font-size: 1.04rem; }
.brand span { color: var(--text-soft); font-size: .78rem; }
.brand-mark { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; color: #fff; background: var(--accent-strong); font-weight: 800; font-size: 1.16rem; box-shadow: 0 8px 20px color-mix(in srgb, var(--accent) 22%, transparent); }
.brand-mark-large { width: 64px; height: 64px; border-radius: 19px; font-size: 1.65rem; }
.side-nav nav { display: grid; gap: 7px; }
.nav-item { position: relative; min-height: 48px; display: flex; align-items: center; gap: 12px; padding: 0 14px; border-radius: 13px; color: var(--text-soft); font-weight: 650; text-align: left; transition: background .16s ease, color .16s ease, transform .16s ease; }
.nav-item:hover { background: var(--surface-soft); color: var(--text); }
.nav-item:active { transform: scale(.985); }
.nav-item.is-active { background: var(--accent-soft); color: var(--accent-strong); }
.nav-item b { margin-left: auto; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; display: grid; place-items: center; background: var(--accent); color: var(--surface); font-size: .72rem; }
.side-profile { margin-top: auto; display: flex; align-items: center; gap: 11px; padding: 14px; border-radius: 15px; background: var(--surface-soft); }
.side-profile > div:last-child { min-width: 0; display: grid; gap: 2px; }
.side-profile strong, .side-profile span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.side-profile strong { font-size: .9rem; }
.side-profile span { color: var(--text-soft); font-size: .74rem; }
.avatar { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--line); font-weight: 750; font-size: .78rem; }

.app-column { min-height: 100dvh; margin-left: var(--sidebar-width); }
.topbar { position: sticky; top: 0; z-index: 15; min-height: 104px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 22px clamp(24px, 4vw, 52px); background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(18px); border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent); }
.topbar h1 { margin: 0; font-size: clamp(1.72rem, 2.4vw, 2.25rem); line-height: 1.05; }
.eyebrow { margin: 0 0 6px; color: var(--text-soft); font-size: .82rem; font-weight: 650; text-transform: capitalize; }
.topbar-actions { display: flex; align-items: center; gap: 10px; }
.avatar-button { width: 44px; height: 44px; display: none; place-items: center; border-radius: 50%; background: var(--surface); border: 1px solid var(--line); font-weight: 760; }
.page-content { width: min(100%, var(--content-max)); margin: 0 auto; padding: 28px clamp(24px, 4vw, 52px) 64px; }
.bottom-nav { display: none; }

.primary-button, .secondary-button, .text-button { min-height: 44px; border-radius: 12px; padding: 0 17px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 700; transition: transform .16s ease, background .16s ease, border-color .16s ease, color .16s ease; }
.primary-button { background: var(--accent-strong); color: #fff; }
.primary-button:hover { background: color-mix(in srgb, var(--accent-strong) 90%, #000); }
.secondary-button { background: var(--surface); border: 1px solid var(--line); color: var(--text); }
.secondary-button:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); background: var(--surface-soft); }
.text-button { min-height: 36px; padding: 0 8px; color: var(--accent-strong); }
.primary-button:active, .secondary-button:active, .text-button:active { transform: scale(.98); }
.icon-label { padding-inline: 15px; }
.full { width: 100%; }
.centered { margin: 8px auto 0; display: flex; }
