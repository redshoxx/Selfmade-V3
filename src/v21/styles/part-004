/* V21.1 interaction and planning refinements */
.visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.shopping-quick-card {
  padding: 14px;
  margin-bottom: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.shopping-quick-form {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 110px 170px auto;
  gap: 10px;
  align-items: center;
}

.shopping-quick-form input,
.shopping-quick-form select { min-height: 48px; }

.suggestion-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  overflow-x: auto;
  padding-bottom: 2px;
  scrollbar-width: none;
}
.suggestion-row::-webkit-scrollbar { display: none; }
.suggestion-row > span {
  flex: 0 0 auto;
  color: var(--text-soft);
  font-size: .75rem;
  font-weight: 700;
}
.suggestion-row button {
  flex: 0 0 auto;
  min-height: 34px;
  padding: 0 12px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: .78rem;
  font-weight: 750;
}

.shopping-control-row {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) auto;
  gap: 12px;
  align-items: center;
  margin-bottom: 12px;
}
.shopping-search {
  min-height: 48px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
}
.shopping-status-strip {
  display: grid;
  grid-template-columns: 150px 180px 1fr;
  gap: 10px;
  align-items: stretch;
  margin-bottom: 12px;
}
.shopping-status-strip > div {
  min-height: 68px;
  display: grid;
  align-content: center;
  gap: 2px;
  padding: 12px 16px;
  border: 1px solid var(--line);
  border-radius: 15px;
  background: var(--surface);
}
.shopping-status-strip > div strong { font-size: 1.15rem; }
.shopping-status-strip > div span { color: var(--text-soft); font-size: .74rem; }
.shopping-status-strip > button { justify-self: end; align-self: center; }
.simple-shopping-list {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}
.shopping-item {
  min-height: 72px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto auto;
  gap: 11px;
  align-items: center;
  padding: 9px 14px;
  border-bottom: 1px solid var(--line);
}
.shopping-item:last-child { border-bottom: 0; }
.shopping-item.is-done { background: color-mix(in srgb, var(--surface-soft) 72%, transparent); }
.shopping-item.is-done .shopping-item-main strong { color: var(--text-soft); text-decoration: line-through; }
.shopping-item-main { min-width: 0; display: grid; gap: 5px; text-align: left; }
.shopping-item-main > strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: .96rem;
}
.shopping-item-main > span {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 7px;
  overflow: hidden;
  color: var(--text-soft);
  font-size: .74rem;
}
.shopping-item-main b { flex: 0 0 auto; color: var(--text); }
.shopping-item-main i {
  flex: 0 0 auto;
  padding: 3px 7px;
  border-radius: 999px;
  background: var(--surface-soft);
  font-style: normal;
}
.shopping-item-main em {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-style: normal;
}
.shopping-price { font-size: .84rem; font-weight: 750; }
.simple-shopping-list.store-mode .shopping-item { min-height: 82px; }
.simple-shopping-list.store-mode .check-button { width: 40px; height: 40px; border-radius: 13px; }

.week-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 13px;
  margin-bottom: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}
.week-navigation { display: flex; align-items: center; gap: 10px; }
.week-navigation > div { min-width: 210px; display: grid; gap: 2px; text-align: center; }
.week-navigation span { color: var(--text-soft); font-size: .72rem; }
.week-navigation strong { font-size: .92rem; }
.week-actions { display: flex; align-items: center; gap: 8px; }
.planner-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 14px;
  padding: 16px;
  border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--line));
  border-radius: var(--radius);
  background: var(--warning-soft);
}
.planner-notice > div { display: flex; align-items: center; gap: 12px; }
.planner-notice span { display: grid; gap: 3px; }
.planner-notice small { color: var(--text-soft); }
.planner-days { display: grid; gap: 12px; }
.planner-day {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  gap: 14px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}
.planner-day.is-today { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
.planner-day > header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  padding: 4px 2px;
}
.planner-day > header > div { display: grid; gap: 4px; }
.planner-day > header span { color: var(--text-soft); font-size: .75rem; font-weight: 750; text-transform: uppercase; }
.planner-day > header strong { font-size: 1rem; }
.planner-day > header > b {
  padding: 4px 8px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: .68rem;
}
.planner-slots { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.planner-slot {
  min-height: 84px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--surface-soft);
}
.planner-slot.is-empty {
  display: grid;
  place-items: center;
  align-content: center;
  gap: 3px;
  padding: 9px;
  color: var(--text-soft);
  text-align: center;
}
.planner-slot.is-empty:hover:not(:disabled) { border-color: var(--accent); color: var(--accent-strong); background: var(--accent-soft); }
.planner-slot.is-empty span { font-size: .68rem; font-weight: 750; text-transform: uppercase; }
.planner-slot.is-empty small { font-size: .7rem; }
.planner-slot.is-filled {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: 3px;
  padding: 4px;
  background: var(--accent-soft);
  border-color: color-mix(in srgb, var(--accent) 28%, var(--line));
}
.planner-meal {
  min-width: 0;
  min-height: 74px;
  display: grid;
  align-content: center;
  gap: 4px;
  padding: 8px;
  text-align: left;
}
.planner-meal span { color: var(--accent-strong); font-size: .66rem; font-weight: 800; text-transform: uppercase; }
.planner-meal strong, .planner-meal small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.planner-meal strong { font-size: .82rem; }
.planner-meal small { color: var(--text-soft); font-size: .68rem; }
.planner-slot.is-filled .icon-button { width: 32px; height: 32px; }
.planner-modal-empty { display: grid; justify-items: center; gap: 10px; padding: 28px 10px; text-align: center; }
.planner-modal-empty h3, .planner-modal-empty p { margin: 0; }
.planner-modal-empty p { color: var(--text-soft); }

@media (max-width: 1000px) {
  .shopping-quick-form { grid-template-columns: minmax(180px, 1fr) 100px 150px; }
  .shopping-quick-form .primary-button { grid-column: 1 / -1; }
  .planner-day { grid-template-columns: 120px minmax(0, 1fr); }
  .planner-slots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 820px) {
  .shopping-quick-card { padding: 11px; }
  .shopping-quick-form { grid-template-columns: minmax(0, 1fr) 86px; }
  .shopping-quick-form select { grid-column: 1 / 2; }
  .shopping-quick-form .primary-button { grid-column: 2 / 3; }
  .shopping-control-row { grid-template-columns: 1fr; }
  .shopping-control-row .segmented { overflow-x: auto; }
  .shopping-status-strip { grid-template-columns: 1fr 1fr; }
  .shopping-status-strip > button { grid-column: 1 / -1; width: 100%; justify-self: stretch; }
  .shopping-item { grid-template-columns: auto minmax(0, 1fr) auto; }
  .shopping-price { display: none; }
  .week-toolbar { align-items: stretch; flex-direction: column; }
  .week-navigation { justify-content: space-between; }
  .week-navigation > div { min-width: 0; flex: 1; }
  .week-actions { display: grid; grid-template-columns: 1fr 1fr; }
  .week-actions button { width: 100%; }
  .planner-day { grid-template-columns: 1fr; gap: 8px; }
  .planner-day > header { align-items: center; }
  .planner-slots { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 520px) {
  .shopping-quick-form { grid-template-columns: 1fr 76px; }
  .shopping-quick-form select { grid-column: 1 / -1; }
  .shopping-quick-form .primary-button { grid-column: 1 / -1; }
  .shopping-status-strip { grid-template-columns: 1fr 1fr; }
  .shopping-item { padding-inline: 10px; }
  .shopping-item-main > span em { display: none; }
  .week-actions { grid-template-columns: 1fr; }
  .planner-slots { grid-template-columns: 1fr; }
  .planner-slot { min-height: 70px; }
  .planner-meal { min-height: 62px; }
}
