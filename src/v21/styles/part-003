.loading-screen { min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
.loading-screen > strong { margin-top: 7px; font-size: 1.22rem; }
.loading-screen > span { color: var(--text-soft); font-size: .82rem; }
.loader { width: 28px; height: 28px; margin-top: 14px; border: 3px solid var(--surface-strong); border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
.auth-page { min-height: 100dvh; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(420px, .92fr); }
.auth-intro { position: relative; overflow: hidden; padding: clamp(28px, 5vw, 72px); display: flex; flex-direction: column; background: var(--accent-strong); color: #fff; }
.auth-intro::after { content: ""; position: absolute; width: 520px; height: 520px; right: -220px; bottom: -250px; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; box-shadow: 0 0 0 70px rgba(255,255,255,.035), 0 0 0 140px rgba(255,255,255,.025); }
.auth-brand { position: relative; z-index: 1; }
.auth-brand .brand-mark { background: #fff; color: var(--accent-strong); box-shadow: none; }
.auth-brand span { color: rgba(255,255,255,.7); }
.auth-copy { position: relative; z-index: 1; margin: auto 0; max-width: 620px; }
.auth-copy .pill { display: inline-flex; min-height: 30px; align-items: center; padding: 0 11px; border-radius: 999px; background: rgba(255,255,255,.12); font-size: .72rem; font-weight: 750; }
.auth-copy h1 { margin: 22px 0 18px; font-size: clamp(3rem, 7vw, 6.2rem); line-height: .94; letter-spacing: -.06em; }
.auth-copy > p { max-width: 520px; color: rgba(255,255,255,.76); font-size: clamp(1rem, 1.6vw, 1.25rem); line-height: 1.55; }
.auth-feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 34px; max-width: 520px; }
.auth-feature-grid div { min-height: 54px; padding: 0 14px; border: 1px solid rgba(255,255,255,.16); border-radius: 13px; display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.06); font-size: .82rem; font-weight: 650; }
.auth-panel { display: grid; place-items: center; padding: clamp(22px, 5vw, 64px); background: var(--bg); }
.auth-card { width: min(100%, 430px); }
.auth-tabs { margin-bottom: 30px; }
.auth-tabs button { flex: 1; }
.auth-heading h2 { margin: 0 0 8px; font-size: 2rem; }
.auth-heading p { margin: 0 0 26px; color: var(--text-soft); }
.auth-hint { margin: 20px 0 0; color: var(--text-soft); text-align: center; font-size: .72rem; line-height: 1.45; }

@keyframes spin { to { transform: rotate(360deg); } }
@keyframes fade-in { from { opacity: 0; } }
@keyframes modal-in { from { opacity: 0; transform: translate(-50%, -47%) scale(.98); } }
@keyframes toast-in { from { opacity: 0; transform: translate(-50%, -8px); } }

@media (max-width: 1080px) {
  :root { --sidebar-width: 214px; }
  .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .recipe-grid, .note-grid, .budget-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 820px) {
  .side-nav { display: none; }
  .app-column { margin-left: 0; padding-bottom: calc(82px + var(--safe-bottom)); }
  .topbar { min-height: 92px; padding: 17px 18px; }
  .topbar h1 { font-size: 1.72rem; }
  .topbar-actions .icon-label span { display: none; }
  .topbar-actions .icon-label { width: 44px; padding: 0; }
  .avatar-button { display: grid; }
  .page-content { padding: 18px 16px 34px; }
  .bottom-nav { position: fixed; z-index: 40; inset: auto 0 0; min-height: calc(68px + var(--safe-bottom)); display: grid; grid-template-columns: repeat(5, 1fr); align-items: start; padding: 7px 7px var(--safe-bottom); background: color-mix(in srgb, var(--surface) 94%, transparent); border-top: 1px solid var(--line); backdrop-filter: blur(18px); }
  .bottom-nav .nav-item { min-height: 56px; padding: 4px 2px; border-radius: 12px; display: flex; flex-direction: column; justify-content: center; gap: 4px; font-size: .66rem; }
  .bottom-nav .nav-item b { position: absolute; top: 2px; right: calc(50% - 24px); min-width: 18px; height: 18px; padding: 0 4px; font-size: .58rem; }
  .focus-card { grid-template-columns: auto 1fr; padding: 20px; }
  .focus-action { grid-column: 1 / -1; }
  .focus-action .primary-button { width: 100%; }
  .two-column-grid, .savings-grid { grid-template-columns: 1fr; }
  .auth-page { grid-template-columns: 1fr; }
  .auth-intro { display: none; }
  .auth-panel { min-height: 100dvh; padding: 24px 20px; }
  .auth-card::before { content: "H"; width: 58px; height: 58px; margin: 0 auto 24px; border-radius: 18px; display: grid; place-items: center; background: var(--accent-strong); color: #fff; font-weight: 800; font-size: 1.45rem; }
}

@media (max-width: 620px) {
  .eyebrow { font-size: .74rem; }
  .metric-grid { gap: 10px; }
  .metric-card { min-height: 146px; padding: 15px; }
  .metric-card strong { font-size: 1.25rem; }
  .quick-grid { grid-template-columns: 1fr; }
  .toolbar-card { align-items: stretch; flex-direction: column; padding: 8px; }
  .toolbar-card.single { display: block; }
  .search-field { min-width: 0; }
  .toolbar-card .segmented { overflow-x: auto; }
  .shopping-summary { grid-template-columns: 1fr 1fr; }
  .shopping-summary > button { grid-column: 1 / -1; width: 100%; }
  .list-row { grid-template-columns: auto minmax(0, 1fr) auto; padding-inline: 11px; }
  .list-row .row-price { display: none; }
  .pantry-row { grid-template-columns: auto minmax(0, 1fr) auto; }
  .pantry-row .row-meta { display: none; }
  .recipe-grid, .note-grid, .budget-grid { grid-template-columns: 1fr; }
  .recipe-card { display: grid; grid-template-columns: 112px 1fr; }
  .recipe-click { display: contents; }
  .recipe-image { aspect-ratio: auto; min-height: 154px; }
  .recipe-content { padding: 15px; }
  .recipe-content p { min-height: 0; -webkit-line-clamp: 2; }
  .money-hero > strong { font-size: 2.4rem; }
  .transaction-row { grid-template-columns: auto minmax(0, 1fr) auto; }
  .transaction-row .icon-button { display: none; }
  .transaction-amount { font-size: .8rem; }
  .settings-card { align-items: flex-start; flex-direction: column; }
  .settings-card > button, .settings-card > .segmented { width: 100%; }
  .settings-card .segmented button { flex: 1; }
  .modal-sheet { top: auto; bottom: 0; left: 0; width: 100%; max-height: 92dvh; transform: none; border-radius: 24px 24px 0 0; border-bottom: 0; animation: sheet-in .22s ease; }
  .modal-handle { width: 42px; height: 5px; display: block; margin: 9px auto 0; border-radius: 999px; background: var(--surface-strong); }
  .modal-sheet > header { min-height: 72px; padding-top: 12px; }
  .form-grid, .form-grid.thirds { grid-template-columns: 1fr; }
  .modal-footer-actions { flex-direction: column-reverse; }
  .modal-footer-actions button { width: 100%; }
  .ingredient-list li { grid-template-columns: 75px 1fr; }
  .sticky-checkout { bottom: calc(78px + var(--safe-bottom)); border-radius: 16px; }
  .challenge-actions { flex-direction: column; }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(30px); } }
}

@media (max-width: 390px) {
  :root { font-size: 15px; }
  .page-content { padding-inline: 12px; }
  .topbar { padding-inline: 14px; }
  .metric-grid { grid-template-columns: 1fr 1fr; }
  .metric-card { min-height: 138px; }
  .metric-icon { width: 34px; height: 34px; }
  .focus-icon { width: 48px; height: 48px; }
  .bottom-nav { padding-inline: 3px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
