.icon-button { width: 42px; height: 42px; display: inline-grid; place-items: center; border-radius: 12px; background: var(--surface-soft); color: var(--text-soft); }
.icon-button:hover { color: var(--text); background: var(--surface-strong); }
.icon-button.subtle { width: 38px; height: 38px; background: transparent; }
.icon-button.is-highlighted { color: var(--accent-strong); background: var(--accent-soft); }

.focus-card { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
.focus-icon { width: 56px; height: 56px; border-radius: 17px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.focus-card h2 { margin: 4px 0 7px; font-size: clamp(1.35rem, 2vw, 1.72rem); }
.focus-card p { margin: 0; color: var(--text-soft); line-height: 1.5; }
.section-kicker { display: block; color: var(--accent-strong); font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-top: 16px; }
.metric-card { min-height: 164px; padding: 20px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); text-align: left; display: grid; align-content: start; gap: 7px; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
.metric-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 28%, var(--line)); box-shadow: var(--shadow); }
.metric-icon { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: var(--surface-soft); color: var(--accent-strong); margin-bottom: 6px; }
.metric-label { color: var(--text-soft); font-size: .82rem; font-weight: 650; }
.metric-card strong { font-size: clamp(1.25rem, 2.1vw, 1.72rem); overflow-wrap: anywhere; }
.metric-card small { color: var(--text-soft); font-size: .78rem; }
.two-column-grid { display: grid; grid-template-columns: 1.08fr .92fr; gap: 16px; margin-top: 16px; }
.surface-card, .list-surface, .toolbar-card, .budget-card, .settings-card, .note-card, .recipe-card, .day-card { background: var(--surface); border: 1px solid var(--line); }
.surface-card { border-radius: var(--radius); padding: 22px; }
.surface-card.large-card { padding: clamp(22px, 3vw, 34px); }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 14px; }
.section-head h2 { margin: 3px 0 0; font-size: 1.15rem; }
.quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.quick-action { min-height: 72px; padding: 13px; border-radius: 14px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 11px; background: var(--surface-soft); text-align: left; }
.quick-action > span { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; color: var(--accent-strong); background: var(--surface); }
.quick-action > div { min-width: 0; display: grid; gap: 3px; }
.quick-action strong, .quick-action small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quick-action strong { font-size: .9rem; }
.quick-action small { color: var(--text-soft); font-size: .72rem; }
.mini-list { display: grid; }
.mini-row { width: 100%; min-height: 62px; padding: 10px 2px; display: grid; grid-template-columns: auto 1fr auto; gap: 11px; align-items: center; border-bottom: 1px solid var(--line); text-align: left; }
.mini-row:last-child { border-bottom: 0; }
.mini-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
.mini-row > span:nth-child(2) { min-width: 0; display: grid; gap: 3px; }
.mini-row strong, .mini-row small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mini-row strong { font-size: .9rem; }
.mini-row small { color: var(--text-soft); font-size: .76rem; }

.page-tabs { width: max-content; max-width: 100%; overflow-x: auto; display: flex; gap: 5px; padding: 5px; margin-bottom: 18px; border-radius: 14px; background: var(--surface-strong); scrollbar-width: none; }
.page-tabs::-webkit-scrollbar { display: none; }
.page-tabs button { min-height: 38px; padding: 0 16px; border-radius: 10px; color: var(--text-soft); font-weight: 700; white-space: nowrap; }
.page-tabs button.is-active { color: var(--text); background: var(--surface); box-shadow: 0 2px 8px rgba(20, 28, 19, .05); }
.toolbar-card { min-height: 66px; padding: 9px; border-radius: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.toolbar-card.single { display: block; }
.search-field { min-width: 220px; flex: 1; display: flex; align-items: center; gap: 9px; padding: 0 12px; }
.search-field .icon { color: var(--text-soft); }
.search-field input { min-height: 44px; padding: 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
.search-field input:focus { box-shadow: none; }
.segmented { display: flex; gap: 4px; padding: 4px; border-radius: 12px; background: var(--surface-soft); }
.segmented button { min-height: 38px; padding: 0 14px; border-radius: 9px; color: var(--text-soft); font-weight: 700; white-space: nowrap; }
.segmented button.is-active { color: var(--text); background: var(--surface); box-shadow: 0 2px 7px rgba(20, 28, 19, .06); }
.segmented button span { font-size: .72rem; opacity: .75; }
.segmented.compact button { min-height: 36px; padding-inline: 12px; font-size: .8rem; }
.segmented.wide { width: 100%; justify-content: center; }
.shopping-summary { display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: stretch; margin-bottom: 14px; }
.shopping-summary > div { min-height: 76px; padding: 14px 17px; display: grid; align-content: center; gap: 4px; border-radius: 15px; background: var(--surface); border: 1px solid var(--line); }
.shopping-summary span { color: var(--text-soft); font-size: .76rem; }
.shopping-summary strong { font-size: 1.25rem; }
.shopping-summary > button { align-self: center; }
.list-surface { border-radius: var(--radius); overflow: hidden; }
.list-group + .list-group { border-top: 8px solid var(--bg); }
.list-group-title { min-height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 0 18px; background: var(--surface-soft); border-bottom: 1px solid var(--line); }
.list-group-title h2 { margin: 0; font-size: .84rem; text-transform: uppercase; letter-spacing: .06em; }
.list-group-title span { min-width: 24px; height: 24px; border-radius: 999px; display: grid; place-items: center; color: var(--text-soft); background: var(--surface); font-size: .72rem; }
.list-row { min-height: 66px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--line); }
.list-row:last-child { border-bottom: 0; }
.list-row.is-done .row-main strong { color: var(--text-soft); text-decoration: line-through; }
.check-button { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; border: 1.5px solid var(--line); background: var(--surface); color: #fff; }
.check-button.is-checked { border-color: var(--accent); background: var(--accent); }
.row-main { min-width: 0; display: grid; gap: 3px; text-align: left; }
.row-main strong, .row-main span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row-main strong { font-size: .93rem; }
.row-main span { color: var(--text-soft); font-size: .76rem; }
.row-price { font-weight: 700; font-size: .86rem; }
.store-mode .list-row { min-height: 78px; }
.store-mode .check-button { width: 38px; height: 38px; border-radius: 12px; }
.sticky-checkout { position: sticky; bottom: 18px; z-index: 8; margin: 16px auto 0; min-height: 70px; max-width: 620px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 11px 12px 11px 20px; border-radius: 18px; background: var(--text); color: var(--surface); box-shadow: var(--shadow-strong); }
.sticky-checkout > div { display: grid; gap: 2px; }
.sticky-checkout span { opacity: .72; font-size: .76rem; }
.sticky-checkout strong { font-size: 1.08rem; }
.sticky-checkout .primary-button { background: var(--surface); color: var(--text); }

.recipe-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
.recipe-card { position: relative; border-radius: var(--radius); overflow: hidden; }
.recipe-click { width: 100%; text-align: left; }
.recipe-image { aspect-ratio: 16/9; display: grid; place-items: center; background: var(--surface-soft); color: var(--text-soft); background-position: center; background-size: cover; }
.recipe-content { padding: 17px; }
.recipe-content > span { color: var(--accent-strong); font-size: .72rem; font-weight: 760; text-transform: uppercase; letter-spacing: .06em; }
.recipe-content h2 { margin: 7px 0 6px; font-size: 1.08rem; }
.recipe-content p { min-height: 38px; margin: 0 0 14px; color: var(--text-soft); font-size: .8rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.recipe-content > div { display: flex; gap: 8px; flex-wrap: wrap; }
.recipe-content small, .recipe-detail-meta span { padding: 5px 8px; border-radius: 999px; background: var(--surface-soft); color: var(--text-soft); font-size: .7rem; }
.recipe-edit { position: absolute; top: 10px; right: 10px; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(8px); }
.pantry-row { grid-template-columns: auto minmax(0, 1fr) auto auto; }
.pantry-row.is-urgent { background: var(--warning-soft); }
.pantry-symbol { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.row-meta { min-width: 104px; display: grid; gap: 2px; text-align: right; }
.row-meta strong { font-size: .78rem; }
.row-meta span { color: var(--text-soft); font-size: .7rem; }
.week-grid { display: grid; grid-template-columns: repeat(7, minmax(150px, 1fr)); gap: 10px; overflow-x: auto; padding-bottom: 8px; }
.day-card { min-height: 250px; border-radius: 17px; padding: 14px; display: flex; flex-direction: column; }
.day-card.is-today { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
.day-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.day-head span { color: var(--text-soft); font-weight: 700; text-transform: uppercase; font-size: .72rem; }
.day-head strong { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-soft); }
.day-meals { flex: 1; display: grid; align-content: start; gap: 8px; }
.meal-chip { padding: 10px; border-radius: 11px; background: var(--accent-soft); display: grid; gap: 4px; text-align: left; }
.meal-chip span { color: var(--accent-strong); font-size: .66rem; font-weight: 750; text-transform: uppercase; }
.meal-chip strong { font-size: .78rem; line-height: 1.25; }
.empty-day { color: var(--text-soft); font-size: .78rem; }
.day-add { min-height: 36px; display: flex; align-items: center; justify-content: center; gap: 5px; border-radius: 10px; background: var(--surface-soft); font-size: .76rem; font-weight: 700; }

.money-hero { margin-bottom: 16px; padding: clamp(25px, 4vw, 42px); border-radius: var(--radius-lg); background: var(--text); color: var(--surface); }
.money-hero > span { display: block; opacity: .66; font-size: .82rem; }
