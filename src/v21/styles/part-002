.money-hero > strong { display: block; margin: 8px 0 22px; font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1; }
.money-hero > div { display: flex; gap: 12px; flex-wrap: wrap; }
.money-hero > div span { min-height: 34px; padding: 0 11px; border-radius: 999px; display: inline-flex; align-items: center; gap: 6px; background: color-mix(in srgb, var(--surface) 10%, transparent); font-size: .75rem; }
.transaction-list { display: grid; }
.transaction-row { min-height: 66px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 12px; border-bottom: 1px solid var(--line); }
.transaction-row:last-child { border-bottom: 0; }
.transaction-icon { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; }
.transaction-icon.income { color: var(--positive); background: var(--positive-soft); }
.transaction-icon.expense { color: var(--negative); background: var(--negative-soft); }
.transaction-row > div { min-width: 0; display: grid; gap: 3px; }
.transaction-row > div strong, .transaction-row > div small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.transaction-row > div strong { font-size: .88rem; }
.transaction-row > div small { color: var(--text-soft); font-size: .72rem; }
.transaction-amount { font-size: .88rem; }
.transaction-amount.income { color: var(--positive); }
.transaction-amount.expense { color: var(--text); }
.budget-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.budget-card { min-height: 190px; padding: 20px; border-radius: var(--radius); }
.budget-head { display: flex; justify-content: space-between; align-items: center; }
.budget-head > span { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.budget-head button { width: 36px; height: 36px; display: grid; place-items: center; color: var(--text-soft); }
.budget-card h2 { margin: 19px 0 10px; font-size: 1rem; }
.budget-values { display: flex; align-items: baseline; gap: 6px; }
.budget-values strong { font-size: 1.35rem; }
.budget-values span, .budget-card > small { color: var(--text-soft); font-size: .72rem; }
.progress { height: 7px; overflow: hidden; margin: 14px 0 8px; border-radius: 999px; background: var(--surface-strong); }
.progress i { display: block; height: 100%; border-radius: inherit; background: var(--accent); }
.progress.large { height: 10px; margin-block: 20px 10px; }
.savings-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 16px; }
.savings-balance, .challenge-card { min-height: 320px; padding: clamp(24px, 4vw, 38px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); }
.savings-balance { display: flex; flex-direction: column; align-items: flex-start; }
.savings-balance > span { color: var(--text-soft); font-size: .82rem; }
.savings-balance > strong { margin: 12px 0; font-size: clamp(2.15rem, 4vw, 3.35rem); }
.savings-balance p, .challenge-card p { color: var(--text-soft); line-height: 1.55; }
.savings-balance button { margin-top: auto; }
.challenge-card { position: relative; }
.challenge-icon { width: 52px; height: 52px; margin-bottom: 22px; border-radius: 16px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.challenge-icon.large { width: 64px; height: 64px; margin: 0; border-radius: 19px; }
.challenge-card h2 { margin: 6px 0 14px; }
.challenge-values { display: flex; align-items: baseline; gap: 7px; margin-top: 20px; }
.challenge-values strong { font-size: 1.8rem; }
.challenge-values span { color: var(--text-soft); font-size: .8rem; }
.challenge-meta { display: flex; justify-content: space-between; color: var(--text-soft); font-size: .74rem; margin-bottom: 18px; }
.challenge-overview { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
.challenge-overview h2 { margin: 5px 0; }
.challenge-overview p { margin: 0; color: var(--text-soft); }
.challenge-actions { display: flex; gap: 10px; margin-top: 20px; }

.note-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.note-card { position: relative; min-height: 200px; border-radius: var(--radius); overflow: hidden; }
.note-card.is-pinned { border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); }
.note-main { width: 100%; min-height: 200px; padding: 20px; text-align: left; display: flex; flex-direction: column; align-items: flex-start; }
.note-main > span { color: var(--accent-strong); font-size: .68rem; font-weight: 780; text-transform: uppercase; letter-spacing: .06em; }
.note-main h2 { margin: 12px 0 8px; font-size: 1.08rem; }
.note-main p { margin: 0; color: var(--text-soft); font-size: .82rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.note-main small { margin-top: auto; padding-top: 18px; color: var(--text-soft); font-size: .7rem; }
.note-delete { position: absolute; top: 10px; right: 10px; }
.settings-stack { display: grid; gap: 12px; }
.settings-card { min-height: 90px; border-radius: var(--radius); padding: 17px 18px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.settings-card > div:first-child { min-width: 0; display: flex; align-items: center; gap: 13px; }
.settings-card > div:first-child > div { min-width: 0; }
.settings-card h2 { margin: 0 0 4px; font-size: 1rem; }
.settings-card p { margin: 0; color: var(--text-soft); font-size: .78rem; }
.settings-card.danger { border-color: color-mix(in srgb, var(--negative) 28%, var(--line)); }
.settings-icon { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.settings-card.danger .settings-icon { color: var(--negative); background: var(--negative-soft); }
.version-note { padding: 16px; text-align: center; color: var(--text-soft); font-size: .72rem; }

.empty-state { min-height: 220px; padding: 30px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-state > span { width: 58px; height: 58px; border-radius: 18px; display: grid; place-items: center; color: var(--accent-strong); background: var(--accent-soft); }
.empty-state h3 { margin: 14px 0 6px; }
.empty-state p { max-width: 360px; margin: 0 0 18px; color: var(--text-soft); line-height: 1.5; font-size: .84rem; }

.modal-backdrop { position: fixed; inset: 0; z-index: 100; background: rgba(7, 11, 7, .48); backdrop-filter: blur(4px); animation: fade-in .18s ease; }
.modal-sheet { position: fixed; z-index: 101; top: 50%; left: 50%; width: min(620px, calc(100vw - 30px)); max-height: min(86dvh, 860px); transform: translate(-50%, -50%); display: flex; flex-direction: column; overflow: hidden; border-radius: 24px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-strong); animation: modal-in .2s ease; }
.modal-handle { display: none; }
.modal-sheet > header { min-height: 82px; padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); }
.modal-sheet > header span { color: var(--accent-strong); font-size: .7rem; font-weight: 780; text-transform: uppercase; letter-spacing: .07em; }
.modal-sheet > header h2 { margin: 4px 0 0; font-size: 1.35rem; }
.modal-body { overflow-y: auto; padding: 20px; overscroll-behavior: contain; }
.modal-action-list { display: grid; gap: 9px; }
.modal-action-list .quick-action { min-height: 74px; }
.form-stack { display: grid; gap: 15px; }
.form-stack label { display: grid; gap: 7px; color: var(--text); font-size: .8rem; font-weight: 700; }
.form-stack label small { color: var(--text-soft); font-weight: 500; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.form-grid.thirds { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.form-help { margin: -2px 0 2px; color: var(--text-soft); font-size: .78rem; line-height: 1.5; }
.switch-row { min-height: 50px; grid-template-columns: auto 1fr; align-items: center; padding: 10px 12px; border-radius: 13px; background: var(--surface-soft); }
.switch-row input { width: 20px; min-height: 20px; accent-color: var(--accent); }
.form-segment { width: 100%; }
.form-segment label { flex: 1; display: block; }
.form-segment input { position: absolute; opacity: 0; pointer-events: none; }
.form-segment span { min-height: 40px; border-radius: 9px; display: grid; place-items: center; color: var(--text-soft); }
.form-segment input:checked + span { background: var(--surface); color: var(--text); box-shadow: 0 2px 7px rgba(20, 28, 19, .06); }
.submit-button { margin-top: 4px; min-height: 50px; }
.recipe-detail-meta { display: flex; gap: 8px; flex-wrap: wrap; }
.recipe-description { margin: 18px 0 0; color: var(--text-soft); line-height: 1.6; }
.detail-section { margin-top: 25px; }
.detail-section h3 { margin-bottom: 12px; font-size: 1rem; }
.detail-section p { color: var(--text-soft); line-height: 1.55; }
.ingredient-list, .step-list { margin: 0; padding: 0; display: grid; gap: 9px; }
.ingredient-list { list-style: none; }
.ingredient-list li { min-height: 44px; display: grid; grid-template-columns: 90px 1fr; align-items: center; gap: 10px; padding: 8px 11px; border-radius: 11px; background: var(--surface-soft); }
.ingredient-list strong { color: var(--accent-strong); font-size: .8rem; }
.ingredient-list span { font-size: .84rem; }
.step-list { counter-reset: steps; list-style: none; }
.step-list li { position: relative; min-height: 46px; padding: 11px 12px 11px 48px; border-radius: 11px; background: var(--surface-soft); line-height: 1.5; font-size: .84rem; }
.step-list li::before { counter-increment: steps; content: counter(steps); position: absolute; left: 11px; top: 9px; width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-size: .72rem; font-weight: 800; }
.modal-footer-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 26px; }

.toast { position: fixed; z-index: 200; top: 18px; left: 50%; transform: translateX(-50%); max-width: min(92vw, 520px); padding: 13px 17px; border-radius: 13px; background: var(--text); color: var(--surface); box-shadow: var(--shadow-strong); font-size: .84rem; font-weight: 650; animation: toast-in .2s ease; }
.toast-success { background: var(--positive); color: #fff; }
.toast-error { background: var(--negative); color: #fff; }
