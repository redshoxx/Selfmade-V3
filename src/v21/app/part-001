  if (auth && session?.access_token) headers.authorization = `Bearer ${session.access_token}`;
  if (auth && session?.household_id) headers['x-selfmade-household'] = session.household_id;

  let response;
  try {
    response = await fetch(path, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
  } catch {
    throw new Error('Keine Verbindung zum Server. Bitte Internetverbindung prüfen.');
  }

  const text = await response.text();
  let payload = null;
  try { payload = text ? JSON.parse(text) : null; } catch { payload = { error: text }; }

  if (response.status === 401 && auth && retry && session?.refresh_token) {
    const refreshed = await refreshSession();
    if (refreshed) return request(path, { method, body, auth, retry: false });
  }

  if (!response.ok) {
    const message = payload?.error_description || payload?.msg || payload?.message || payload?.error || `Fehler ${response.status}`;
    const error = new Error(message);
    error.status = response.status;
    error.code = payload?.code;
    throw error;
  }
  return payload;
}

async function refreshSession() {
  try {
    const payload = await request('/api/auth/refresh', { method: 'POST', body: { refresh_token: session.refresh_token }, auth: false, retry: false });
    if (!payload?.access_token) return false;
    session = { ...session, ...payload };
    saveJson(STORAGE_KEY, session);
    return true;
  } catch {
    return false;
  }
}

function adopt(payload) {
  if (payload?.state?.settings) data = payload.state;
  else if (payload?.settings && payload?.summary) data = payload;
  if (data?.cloud?.household_id) {
    session = { ...session, household_id: data.cloud.household_id };
    saveJson(STORAGE_KEY, session);
  }
}

async function loadState({ quiet = false } = {}) {
  if (!quiet) setBusy(true);
  try {
    const payload = await request('/api/state');
    adopt(payload);
    currentUser = await request('/api/auth/user').catch(() => currentUser);
  } finally {
    if (!quiet) setBusy(false);
  }
}

function publicNotes() {
  return (data?.notes || []).filter((note) => note.tag !== SYSTEM_CHALLENGE_TAG);
}

function challengeNote() {
  return (data?.notes || []).find((note) => note.tag === SYSTEM_CHALLENGE_TAG) || null;
}

function challengeState() {
  const note = challengeNote();
  if (!note) return { target: 0, steps: 0, completed: 0, saved: 0, name: 'Meine Spar-Challenge' };
  try {
    return { name: 'Meine Spar-Challenge', target: 0, steps: 0, completed: 0, saved: 0, ...JSON.parse(note.content || '{}') };
  } catch {
    return { target: 0, steps: 0, completed: 0, saved: 0, name: 'Meine Spar-Challenge' };
  }
}

async function saveChallenge(next) {
  const note = challengeNote();
  const body = {
    title: 'Spar-Challenge',
    content: JSON.stringify(next),
    tag: SYSTEM_CHALLENGE_TAG,
    pinned: true,
    accent: 'green',
  };
  const payload = note
    ? await request(`/api/notes/${note.id}`, { method: 'PATCH', body })
    : await request('/api/notes', { method: 'POST', body });
  adopt(payload);
}

