    case 'checkout':
      return { title: 'Einkauf abschließen', kicker: 'Ladenmodus', content: form('checkout-form', `<label>Geschäft<input name="store_name" placeholder="z. B. Billa, Spar, Hofer"></label><p class="form-help">Erledigte Produkte werden aus der Liste entfernt, in den Vorrat übernommen und als Ausgabe gebucht.</p>${submitButton('Einkauf übernehmen')}`) };
    default:
