250 | g | Nudeln">${esc(formatIngredients(item.ingredients))}</textarea></label><label>Schritte <small>ein Schritt pro Zeile</small><textarea name="steps" rows="6" placeholder="Gemüse schneiden
Alles anbraten">${esc(formatSteps(item.steps))}</textarea></label><label>Persönliche Notiz<textarea name="notes" rows="3">${esc(item.notes || '')}</textarea></label><input type="hidden" name="id" value="${item.id || ''}">${submitButton(item.id ? 'Rezept speichern' : 'Rezept anlegen')}`) };
    case 'recipe-detail':
