function renderSettings() {
  const settings = data.settings || {};
  const theme = loadJson(UI_KEY, {}).theme || settings.theme || 'system';
  return `<section class="settings-stack">
    <article class="settings-card"><div><span class="settings-icon">${icon('settings')}</span><div><h2>Haushalt</h2><p>Name und Bezeichnung ändern.</p></div></div><button class="secondary-button" data-action="edit-settings">Bearbeiten</button></article>
    <article class="settings-card"><div><span class="settings-icon">${icon(theme === 'dark' ? 'moon' : 'sun')}</span><div><h2>Darstellung</h2><p>Hell, dunkel oder automatisch.</p></div></div><div class="segmented compact"><button class="${theme === 'light' ? 'is-active' : ''}" data-theme="light">Hell</button><button class="${theme === 'system' ? 'is-active' : ''}" data-theme="system">Auto</button><button class="${theme === 'dark' ? 'is-active' : ''}" data-theme="dark">Dunkel</button></div></article>
    <article class="settings-card danger"><div><span class="settings-icon">${icon('logout')}</span><div><h2>Abmelden</h2><p>Die lokale Sitzung auf diesem Gerät beenden.</p></div></div><button class="secondary-button" data-action="logout">Abmelden</button></article>
    <div class="version-note">HaushaltKlar V${APP_VERSION} · Clean Rebuild</div>
  </section>`;
}

function emptyState(iconName, title, text, action = '') {
  return `<div class="empty-state"><span>${icon(iconName, 28)}</span><h3>${esc(title)}</h3><p>${esc(text)}</p>${action}</div>`;
}

function groupBy(items, keyFn) {
  return items.reduce((groups, item) => {
    const key = keyFn(item);
    (groups[key] ||= []).push(item);
    return groups;
  }, {});
}

function applyTheme() {
  const selected = loadJson(UI_KEY, {}).theme || data?.settings?.theme || 'system';
  const dark = selected === 'dark' || (selected === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#111510' : '#f4f5f2');
}

function renderModal() {
  const modal = ui.modal;
  if (!modal) {
    dialogRoot.innerHTML = '';
    document.body.classList.remove('modal-open');
    return;
  }
  document.body.classList.add('modal-open');
  const body = modalContent(modal);
  dialogRoot.innerHTML = `<div class="modal-backdrop" data-action="close-modal"></div><section class="modal-sheet" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-handle"></div><header><div><span>${esc(body.kicker || '')}</span><h2 id="modal-title">${esc(body.title)}</h2></div><button class="icon-button" data-action="close-modal" aria-label="Schließen">${icon('close')}</button></header><div class="modal-body">${body.content}</div></section>`;
  setTimeout(() => dialogRoot.querySelector('input, textarea, select')?.focus(), 20);
}

