}

function recipeDetail(recipe) {
  const ingredients = parseArray(recipe.ingredients);
  const steps = parseArray(recipe.steps);
  return {
    title: recipe.name || 'Rezept',
    kicker: recipe.category || 'Rezept',
    content: `<div class="recipe-detail-meta"><span>${recipe.total_minutes || recipe.prep_minutes || 0} Minuten</span><span>${recipe.servings || 2} Portionen</span><span>${esc(recipe.difficulty || 'Einfach')}</span></div>${recipe.description ? `<p class="recipe-description">${esc(recipe.description)}</p>` : ''}<section class="detail-section"><h3>Zutaten</h3>${ingredients.length ? `<ul class="ingredient-list">${ingredients.map(ingredient => `<li><strong>${esc(ingredient.amount || '')} ${esc(ingredient.unit || '')}</strong><span>${esc(ingredient.name || '')}</span></li>`).join('')}</ul>` : '<p>Keine Zutaten eingetragen.</p>'}</section><section class="detail-section"><h3>Zubereitung</h3>${steps.length ? `<ol class="step-list">${steps.map(step => `<li>${esc(step.text || step)}</li>`).join('')}</ol>` : '<p>Keine Schritte eingetragen.</p>'}</section>${recipe.notes ? `<section class="detail-section"><h3>Notiz</h3><p>${esc(recipe.notes)}</p></section>` : ''}<div class="modal-footer-actions"><button class="secondary-button" data-action="recipe-to-shopping" data-id="${recipe.id}">${icon('shopping', 18)} Einkaufsliste</button><button class="primary-button" data-action="edit-recipe" data-id="${recipe.id}">${icon('edit', 18)} Bearbeiten</button></div>`,
  };
}

function form(id, content) {
  return `<form id="${id}" class="form-stack">${content}</form>`;
}

function submitButton(label) {
  return `<button class="primary-button full submit-button" type="submit">${esc(label)}</button>`;
}

function options(values, selected) {
  return values.map(value => `<option value="${esc(value)}" ${String(value) === String(selected) ? 'selected' : ''}>${esc(value || 'Keine')}</option>`).join('');
}

function parseArray(value) {
  if (Array.isArray(value)) return value;
  if (!value) return [];
  try { const parsed = JSON.parse(value); return Array.isArray(parsed) ? parsed : []; } catch { return []; }
}

function formatIngredients(value) {
  return parseArray(value).map(item => `${item.amount ?? ''} | ${item.unit ?? ''} | ${item.name ?? ''}`.trim()).join('\n');
}

function formatSteps(value) {
  return parseArray(value).map(item => item.text || item).join('\n');
}

function parseIngredients(text) {
  return String(text || '').split(/\r?\n/).map(line => line.trim()).filter(Boolean).map(line => {
    const [amount = '', unit = '', ...name] = line.split('|').map(part => part.trim());
    return { amount: Number(String(amount).replace(',', '.')) || 0, unit, name: name.join(' | ') || unit || amount };
  });
}

function parseSteps(text) {
  return String(text || '').split(/\r?\n/).map(line => line.trim()).filter(Boolean).map((text, index) => ({ order: index + 1, text }));
}

function openModal(type, item = null, extra = {}) {
