    case 'pantry':
      return { title: item.id ? 'Lebensmittel bearbeiten' : 'Lebensmittel eintragen', kicker: 'Vorrat', content: form('pantry-form', `<label>Name<input name="name" required value="${esc(item.name || '')}" placeholder="z. B. Joghurt"></label><div class="form-grid"><label>Menge<input name="quantity" value="${esc(item.quantity || '1')}"></label><label>Einheit<select name="unit">${options(['','Stück','g','kg','ml','l','Packung'], item.unit || '')}</select></label></div><div class="form-grid"><label>Kategorie<select name="category">${options(['Obst & Gemüse','Kühlregal','Backwaren','Vorrat','Tiefkühl','Getränke','Sonstiges'], item.category || 'Vorrat')}</select></label><label>Ort<select name="location">${options(['Vorratsschrank','Kühlschrank','Gefrierschrank','Keller','Sonstiges'], item.location || 'Vorratsschrank')}</select></label></div><div class="form-grid"><label>Ablaufdatum<input name="expiry_date" type="date" value="${esc(item.expiry_date || '')}"></label><label>Mindestbestand<input name="min_quantity" inputmode="decimal" value="${item.min_quantity ?? 0}"></label></div><label class="switch-row"><input type="checkbox" name="buy_again" ${item.buy_again ? 'checked' : ''}><span>Zum Nachkaufen markieren</span></label><input type="hidden" name="id" value="${item.id || ''}">${submitButton(item.id ? 'Änderungen speichern' : 'Zum Vorrat hinzufügen')}`) };
    case 'transaction':
