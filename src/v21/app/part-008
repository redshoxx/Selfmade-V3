function v211CaptureFocus() {
  const active = document.activeElement;
  if (!active || !active.matches('input, textarea, select')) return null;
  return {
    input: active.dataset.input || '',
    name: active.name || '',
    start: typeof active.selectionStart === 'number' ? active.selectionStart : null,
    end: typeof active.selectionEnd === 'number' ? active.selectionEnd : null,
  };
}

enqueueRender = function enqueueRenderV211() {
  if (renderQueued) return;
  const focus = v211CaptureFocus();
  renderQueued = true;
  requestAnimationFrame(() => {
    renderQueued = false;
    render();
    if (!focus) return;
    const selector = focus.input
      ? `[data-input="${CSS.escape(focus.input)}"]`
      : focus.name
        ? `[name="${CSS.escape(focus.name)}"]`
        : '';
    const next = selector ? document.querySelector(selector) : null;
    if (!next) return;
    next.focus({ preventScroll: true });
    if (focus.start != null && typeof next.setSelectionRange === 'function') {
      next.setSelectionRange(focus.start, focus.end ?? focus.start);
    }
  });
};

function v211ClearSession(message = '') {
  session = null;
  data = null;
  currentUser = null;
  saveJson(STORAGE_KEY, null);
  setBusy(false);
  renderAuth();
  if (message) showToast(message, 'error');
}

request = async function requestV211(path, { method = 'GET', body, auth = true, retry = true } = {}) {
  const headers = { accept: 'application/json' };
  if (body !== undefined) headers['content-type'] = 'application/json';
  if (auth && session?.access_token) headers.authorization = `Bearer ${session.access_token}`;
  if (auth && session?.household_id) headers['x-selfmade-household'] = session.household_id;

  let response;
  try {
    response = await fetch(path, {
      method,
      headers,
      body: body === undefined ? undefined : JSON.stringify(body),
    });
  } catch {
    throw new Error('Keine Verbindung zum Server. Bitte Internetverbindung prüfen.');
  }

  const text = await response.text();
  let payload = null;
  try { payload = text ? JSON.parse(text) : null; } catch { payload = { error: text }; }

  if (response.status === 401 && auth && retry && session?.refresh_token) {
    const refreshed = await refreshSession();
    if (refreshed) return request(path, { method, body, auth, retry: false });
    v211ClearSession('Deine Sitzung ist abgelaufen. Bitte erneut anmelden.');
    throw Object.assign(new Error('Sitzung abgelaufen.'), { status: 401, handled: true });
  }

  if (!response.ok) {
    const message = payload?.error_description || payload?.msg || payload?.message || payload?.error || `Fehler ${response.status}`;
    const error = new Error(message);
    error.status = response.status;
    error.code = payload?.code;
    throw error;
  }
  return payload;
};

refreshSession = async function refreshSessionV211() {
  try {
    if (!session?.refresh_token) return false;
    const payload = await request('/api/auth/refresh', {
      method: 'POST',
      body: { refresh_token: session.refresh_token },
      auth: false,
      retry: false,
    });
    if (!payload?.access_token) return false;
    session = { ...session, ...payload };
    saveJson(STORAGE_KEY, session);
    return true;
  } catch {
    return false;
  }
};

mutate = async function mutateV211(path, options, successMessage = '') {
  if (ui.busy) return null;
  setBusy(true);
  try {
    const payload = await request(path, options);
    adopt(payload);
    closeModal();
    render();
    if (successMessage) showToast(successMessage, 'success');
    return payload;
  } catch (error) {
    if (!error?.handled) showToast(error?.message || 'Aktion konnte nicht ausgeführt werden.', 'error');
    return null;
  } finally {
    setBusy(false);
  }
};

renderShopping = function renderShoppingV211() {
  const query = String(ui.shoppingQuery || '').trim().toLowerCase();
  const all = data.shopping || [];
  const open = all.filter((item) => !item.checked);
  const done = all.filter((item) => item.checked);
  const visible = all.filter((item) => {
    if (ui.shoppingFilter === 'open' && item.checked) return false;
    if (ui.shoppingFilter === 'done' && !item.checked) return false;
    if (!query) return true;
    return `${item.name} ${item.category} ${item.note || ''}`.toLowerCase().includes(query);
  });
  const estimated = open.reduce((sum, item) => sum + Number(item.price || 0), 0);
  const suggestions = (data.suggestions || []).slice(0, 6);

  return {
    eyebrow: 'Schnell erfassen und abhaken',
    title: 'Einkauf',
    action: `<button class="secondary-button icon-label" data-action="add-shopping">${icon('plus')}<span>Details</span></button>`,
    content: `
      <section class="shopping-quick-card">
        <form id="shopping-quick-form" class="shopping-quick-form">
          <label class="visually-hidden" for="quick-product">Produkt</label>
          <input id="quick-product" name="name" required autocomplete="off" placeholder="Was brauchst du?">
          <input name="quantity" value="1" aria-label="Menge" placeholder="Menge">
          <select name="category" aria-label="Kategorie">${options(['Obst & Gemüse','Kühlregal','Backwaren','Vorrat','Tiefkühl','Getränke','Haushalt','Sonstiges'], 'Sonstiges')}</select>
          <button class="primary-button" type="submit">${icon('plus', 18)} Hinzufügen</button>
        </form>
        ${suggestions.length ? `<div class="suggestion-row"><span>Vorschläge</span>${suggestions.map((item) => `<button data-action="add-suggestion" data-name="${esc(item.name)}" data-quantity="${esc(item.quantity || '1')}" data-category="${esc(item.category || 'Sonstiges')}">+ ${esc(item.name)}</button>`).join('')}</div>` : ''}
      </section>

      <section class="shopping-control-row">
        <div class="search-field shopping-search">${icon('search', 18)}<input data-input="shopping-query" value="${esc(ui.shoppingQuery || '')}" placeholder="Liste durchsuchen"></div>
        <div class="segmented compact">
          <button class="${ui.shoppingFilter === 'open' ? 'is-active' : ''}" data-shopping-filter="open">Offen <span>${open.length}</span></button>
          <button class="${ui.shoppingFilter === 'all' ? 'is-active' : ''}" data-shopping-filter="all">Alle</button>
          <button class="${ui.shoppingFilter === 'done' ? 'is-active' : ''}" data-shopping-filter="done">Erledigt <span>${done.length}</span></button>
        </div>
      </section>

      <section class="shopping-status-strip">
        <div><strong>${open.length}</strong><span>noch offen</span></div>
        <div><strong>${currency(estimated)}</strong><span>geschätzt</span></div>
        <button class="${ui.storeMode ? 'primary-button' : 'secondary-button'}" data-action="toggle-store-mode">${ui.storeMode ? 'Ladenmodus aktiv' : 'Ladenmodus starten'}</button>
      </section>

      <section class="simple-shopping-list ${ui.storeMode ? 'store-mode' : ''}">
        ${visible.length ? visible.map(renderShoppingRow).join('') : emptyState('shopping', 'Liste ist leer', ui.shoppingFilter === 'open' ? 'Füge oben dein erstes Produkt hinzu.' : 'Keine passenden Produkte gefunden.')}
      </section>

      ${ui.storeMode && done.length ? `<div class="sticky-checkout"><div><span>${done.length} erledigt</span><strong>${currency(done.reduce((sum, item) => sum + Number(item.price || 0), 0))}</strong></div><button class="primary-button" data-action="checkout">Einkauf abschließen</button></div>` : ''}
    `,
  };
};

renderShoppingRow = function renderShoppingRowV211(item) {
  return `<article class="shopping-item ${item.checked ? 'is-done' : ''}">
    <button class="check-button ${item.checked ? 'is-checked' : ''}" data-action="toggle-shopping" data-id="${item.id}" aria-label="${item.checked ? 'Als offen markieren' : 'Als erledigt markieren'}">${item.checked ? icon('check', 16) : ''}</button>
    <button class="shopping-item-main" data-action="edit-shopping" data-id="${item.id}">
      <strong>${esc(item.name)}</strong>
      <span><b>${esc(item.quantity || '1')}</b><i>${esc(item.category || 'Sonstiges')}</i>${item.note ? `<em>${esc(item.note)}</em>` : ''}</span>
    </button>
    ${item.price != null ? `<span class="shopping-price">${currency(item.price)}</span>` : ''}
    <button class="icon-button subtle" data-action="delete-shopping" data-id="${item.id}" aria-label="Löschen">${icon('trash', 18)}</button>
  </article>`;
};

function v211WeekStart(offset = 0) {
  const date = startOfWeek(new Date());
  date.setDate(date.getDate() + offset * 7);
  return date;
}

function v211AddDays(date, days) {
  const next = new Date(date);
  next.setDate(next.getDate() + days);
  return next;
}

renderMealPlan = function renderMealPlanV211() {
  const monday = v211WeekStart(ui.weekOffset);
  const sunday = v211AddDays(monday, 6);
  const recipes = data.recipes || [];
  const mealTypes = ['Frühstück', 'Mittagessen', 'Abendessen', 'Snack'];
  const days = Array.from({ length: 7 }, (_, index) => {
    const date = v211AddDays(monday, index);
    const iso = localIso(date);
    return { date, iso, meals: (data.meal_plan || []).filter((meal) => meal.plan_date === iso) };
  });
  const weekLabel = `${dateLabel(localIso(monday), { day: 'numeric', month: 'short' })} – ${dateLabel(localIso(sunday), { day: 'numeric', month: 'short', year: 'numeric' })}`;

  return `
    <section class="week-toolbar">
      <div class="week-navigation">
        <button class="icon-button" data-action="week-prev" aria-label="Vorherige Woche">${icon('back')}</button>
        <div><span>Ausgewählte Woche</span><strong>${esc(weekLabel)}</strong></div>
        <button class="icon-button" data-action="week-next" aria-label="Nächste Woche">${icon('forward')}</button>
      </div>
      <div class="week-actions">
        <button class="secondary-button" data-action="week-today">Aktuelle Woche</button>
        <button class="secondary-button" data-action="copy-previous-week">${icon('copy', 17)} Vorwoche übernehmen</button>
      </div>
    </section>

    ${recipes.length ? '' : `<section class="planner-notice"><div>${icon('recipe', 22)}<span><strong>Noch keine Rezepte</strong><small>Lege zuerst ein Rezept an, damit du Mahlzeiten planen kannst.</small></span></div><button class="primary-button" data-action="add-recipe">Rezept anlegen</button></section>`}

    <section class="planner-days">
      ${days.map((day) => `<article class="planner-day ${day.iso === todayIso() ? 'is-today' : ''}">
        <header><div><span>${new Intl.DateTimeFormat('de-AT', { weekday: 'long' }).format(day.date)}</span><strong>${dateLabel(day.iso, { day: '2-digit', month: '2-digit' })}</strong></div>${day.iso === todayIso() ? '<b>Heute</b>' : ''}</header>
        <div class="planner-slots">
          ${mealTypes.map((type) => {
            const meal = day.meals.find((entry) => entry.meal_type === type);
            const recipe = recipes.find((entry) => Number(entry.id) === Number(meal?.recipe_id));
            return meal ? `<div class="planner-slot is-filled">
              <button class="planner-meal" data-action="edit-meal" data-id="${meal.id}">
                <span>${esc(type)}</span><strong>${esc(recipe?.name || 'Rezept')}</strong><small>${meal.servings || recipe?.servings || 2} Portionen</small>
              </button>
              <button class="icon-button subtle" data-action="delete-meal" data-id="${meal.id}" aria-label="Mahlzeit entfernen">${icon('trash', 17)}</button>
            </div>` : `<button class="planner-slot is-empty" data-action="add-meal" data-date="${day.iso}" data-meal-type="${type}" ${recipes.length ? '' : 'disabled'}><span>${esc(type)}</span>${icon('plus', 16)}<small>Einplanen</small></button>`;
          }).join('')}
        </div>
      </article>`).join('')}
    </section>
  `;
};

const v211LegacyModalContent = modalContent;
modalContent = function modalContentV211(modal) {
  const item = modal.item || {};
  if (modal.type !== 'meal') return v211LegacyModalContent(modal);
  const recipes = data.recipes || [];
  if (!recipes.length) {
    return {
      title: 'Mahlzeit planen',
      kicker: 'Wochenplan',
      content: `<div class="planner-modal-empty">${icon('recipe', 28)}<h3>Zuerst ein Rezept anlegen</h3><p>Der Wochenplan verwendet deine gespeicherten Rezepte.</p><button class="primary-button" data-action="add-recipe">Rezept anlegen</button></div>`,
    };
  }
  return {
    title: item.id ? 'Mahlzeit bearbeiten' : 'Mahlzeit planen',
    kicker: 'Wochenplan',
    content: form('meal-form', `<input type="hidden" name="id" value="${item.id || ''}"><label>Tag<input name="plan_date" type="date" value="${esc(item.plan_date || modal.date || todayIso())}" required></label><div class="form-grid"><label>Mahlzeit<select name="meal_type">${options(['Frühstück','Mittagessen','Abendessen','Snack'], item.meal_type || modal.mealType || 'Abendessen')}</select></label><label>Portionen<input name="servings" inputmode="numeric" value="${item.servings || 2}"></label></div><label>Rezept<select name="recipe_id" required><option value="">Rezept wählen</option>${recipes.map((recipe) => `<option value="${recipe.id}" ${Number(recipe.id) === Number(item.recipe_id) ? 'selected' : ''}>${esc(recipe.name)}</option>`).join('')}</select></label>${submitButton(item.id ? 'Änderungen speichern' : 'Mahlzeit einplanen')}`),
  };
};

const v211LegacyHandleFormSubmit = handleFormSubmit;
handleFormSubmit = async function handleFormSubmitV211(form) {
  try {
    const values = Object.fromEntries(new FormData(form));
    if (form.id === 'shopping-quick-form') {
      await mutate('/api/shopping', {
        method: 'POST',
        body: { ...values, note: '', price: null },
      }, 'Produkt hinzugefügt.');
      return;
    }
    if (form.id === 'meal-form') {
      const id = values.id;
      const body = {
        plan_date: values.plan_date,
        meal_type: values.meal_type,
        recipe_id: Number(values.recipe_id),
        servings: Number(values.servings || 2),
      };
      await mutate(id ? `/api/meal-plan/${id}` : '/api/meal-plan', {
        method: id ? 'PATCH' : 'POST',
        body,
      }, id ? 'Mahlzeit aktualisiert.' : 'Mahlzeit eingeplant.');
      return;
    }
    await v211LegacyHandleFormSubmit(form);
  } catch (error) {
    showToast(error?.message || 'Formular konnte nicht gespeichert werden.', 'error');
  }
};

const v211LegacyHandleClick = handleClick;
handleClick = async function handleClickV211(target) {
  try {
    const button = target.closest?.('[data-action]');
    if (!button || button.disabled) return await v211LegacyHandleClick(target);
    const action = button.dataset.action;
    const id = Number(button.dataset.id);

    if (action === 'add-meal') {
      return openModal('meal', null, {
        date: button.dataset.date || todayIso(),
        mealType: button.dataset.mealType || 'Abendessen',
      });
    }
    if (action === 'edit-meal') {
      const meal = (data.meal_plan || []).find((item) => Number(item.id) === id);
      return meal ? openModal('meal', meal) : null;
    }
    if (action === 'delete-meal') {
      if (confirm('Mahlzeit aus dem Wochenplan entfernen?')) {
        await mutate(`/api/meal-plan/${id}`, { method: 'DELETE' }, 'Mahlzeit entfernt.');
      }
      return;
    }
    if (action === 'week-prev') {
      ui.weekOffset -= 1;
      render();
      return;
    }
    if (action === 'week-next') {
      ui.weekOffset += 1;
      render();
      return;
    }
    if (action === 'week-today') {
      ui.weekOffset = 0;
      render();
      return;
    }
    if (action === 'copy-previous-week') {
      const to = v211WeekStart(ui.weekOffset);
      const from = v211AddDays(to, -7);
      await mutate('/api/meal-plan/copy', {
        method: 'POST',
        body: { from_start: localIso(from), to_start: localIso(to) },
      }, 'Vorwoche übernommen.');
      return;
    }
    if (action === 'add-suggestion') {
      await mutate('/api/shopping', {
        method: 'POST',
        body: {
          name: button.dataset.name,
          quantity: button.dataset.quantity || '1',
          category: button.dataset.category || 'Sonstiges',
        },
      }, 'Vorschlag hinzugefügt.');
      return;
    }
    return await v211LegacyHandleClick(target);
  } catch (error) {
    if (!error?.handled) showToast(error?.message || 'Aktion konnte nicht ausgeführt werden.', 'error');
  }
};

window.addEventListener('unhandledrejection', (event) => {
  event.preventDefault();
  const message = event.reason?.message || 'Aktion konnte nicht ausgeführt werden.';
  showToast(message, 'error');
});
