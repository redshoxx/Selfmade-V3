function renderBudgets() {
  const budgets = data.budgets || [];
  return budgets.length ? `<section class="budget-grid">${budgets.map(budget => {
    const limit = Number(budget.limit_amount || 0);
    const spent = Number(budget.spent || 0);
    const percent = limit ? Math.min(100, Math.round(spent / limit * 100)) : 0;
    return `<article class="budget-card"><div class="budget-head"><span>${icon('wallet', 18)}</span><button data-action="edit-budget" data-id="${budget.id}">${icon('edit', 17)}</button></div><h2>${esc(budget.name)}</h2><div class="budget-values"><strong>${currency(spent)}</strong><span>von ${currency(limit)}</span></div><div class="progress"><i style="width:${percent}%"></i></div><small>${percent}% genutzt</small></article>`;
  }).join('')}</section>` : emptyState('wallet', 'Noch keine Budgets', 'Lege Grenzen für Lebensmittel, Freizeit oder Haushalt fest.', `<button class="primary-button" data-action="add-budget">Budget anlegen</button>`);
}

