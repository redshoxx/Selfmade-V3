      }).join('') : emptyState('pantry', 'Vorrat ist leer', 'Trage Lebensmittel ein und behalte Ablaufdaten im Blick.', `<button class="primary-button" data-action="add-pantry">Lebensmittel eintragen</button>`)}
    </section>
  `;
}

function renderMealPlan() {
  const monday = startOfWeek(new Date());
  const days = Array.from({ length: 7 }, (_, index) => {
    const date = new Date(monday);
    date.setDate(monday.getDate() + index);
    const iso = localIso(date);
    const meals = (data.meal_plan || []).filter((item) => item.plan_date === iso);
    return { date, iso, meals };
  });
  return `<section class="week-grid">${days.map(day => `
    <article class="day-card ${day.iso === todayIso() ? 'is-today' : ''}">
      <div class="day-head"><span>${new Intl.DateTimeFormat('de-AT', { weekday: 'short' }).format(day.date)}</span><strong>${day.date.getDate()}</strong></div>
      <div class="day-meals">
        ${day.meals.length ? day.meals.map(meal => {
          const recipe = (data.recipes || []).find(item => Number(item.id) === Number(meal.recipe_id));
          return `<button class="meal-chip" data-action="open-recipe" data-id="${recipe?.id || ''}"><span>${esc(meal.meal_type)}</span><strong>${esc(recipe?.name || 'Rezept')}</strong></button>`;
        }).join('') : '<span class="empty-day">Noch frei</span>'}
      </div>
      <button class="day-add" data-action="add-meal" data-date="${day.iso}">${icon('plus', 16)} Planen</button>
    </article>
  `).join('')}</section>`;
}

function startOfWeek(date) {
  const d = new Date(date);
  const day = d.getDay() || 7;
  d.setHours(12, 0, 0, 0);
  d.setDate(d.getDate() - day + 1);
  return d;
}

function localIso(date) {
  const d = new Date(date);
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().slice(0, 10);
}

function renderMoney() {
