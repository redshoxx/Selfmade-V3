  const stepAmount = challenge.steps ? challenge.target / challenge.steps : 0;
  return `
    <section class="savings-grid">
      <article class="savings-balance"><span>Gesamter Sparbetrag</span><strong>${currency(current)}</strong><p>Dieser Betrag wird in deinem Haushalt gespeichert.</p><button class="secondary-button" data-action="edit-savings">Betrag ändern</button></article>
      <article class="challenge-card">
        <div class="challenge-icon">${icon('challenge', 26)}</div>
        <span class="section-kicker">Spar-Challenge</span>
        <h2>${esc(challenge.name || 'Meine Spar-Challenge')}</h2>
        ${challenge.target ? `<div class="challenge-values"><strong>${currency(challenge.saved)}</strong><span>von ${currency(challenge.target)}</span></div><div class="progress large"><i style="width:${challengePercent}%"></i></div><div class="challenge-meta"><span>${challenge.completed} von ${challenge.steps} Schritten</span><span>${challengePercent}%</span></div><button class="primary-button full" data-action="complete-challenge-step" ${challenge.completed >= challenge.steps ? 'disabled' : ''}>${challenge.completed >= challenge.steps ? 'Challenge geschafft' : `${currency(stepAmount)} sparen`}</button><button class="text-button centered" data-action="setup-challenge">Challenge bearbeiten</button>` : `<p>Teile dein Sparziel in kleine, erreichbare Schritte.</p><button class="primary-button full" data-action="setup-challenge">Challenge starten</button>`}
