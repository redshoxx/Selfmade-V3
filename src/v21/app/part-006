  ui.modal = { type, item, ...extra };
  renderModal();
}

function closeModal() {
  ui.modal = null;
  renderModal();
}

async function mutate(path, options, successMessage) {
  setBusy(true);
  try {
    const payload = await request(path, options);
    adopt(payload);
    closeModal();
    enqueueRender();
    if (successMessage) showToast(successMessage, 'success');
    return payload;
  } catch (error) {
    showToast(error.message, 'error');
    throw error;
  } finally {
    setBusy(false);
  }
}

async function handleAuthSubmit(form) {
  const values = Object.fromEntries(new FormData(form));
  setBusy(true);
  try {
    const endpoint = ui.authMode === 'signup' ? '/api/auth/signup' : '/api/auth/signin';
    const payload = await request(endpoint, { method: 'POST', body: values, auth: false });
    if (!payload?.access_token) {
      showToast('Konto erstellt. Bitte bestätige zuerst die E-Mail.', 'success');
      ui.authMode = 'signin';
      renderAuth();
      return;
    }
    session = payload;
    saveJson(STORAGE_KEY, session);
    await loadState();
    location.hash = '#today';
    ui.view = 'today';
    render();
  } catch (error) {
    showToast(error.message, 'error');
  } finally {
    setBusy(false);
  }
}

async function handleFormSubmit(form) {
  const values = Object.fromEntries(new FormData(form));
  try {
    if (form.id === 'shopping-form') {
      const id = values.id;
      const body = { ...values, price: values.price ? Number(values.price.replace(',', '.')) : null };
      delete body.id;
      return mutate(id ? `/api/shopping/${id}` : '/api/shopping', { method: id ? 'PATCH' : 'POST', body }, id ? 'Produkt aktualisiert.' : 'Produkt hinzugefügt.');
    }
    if (form.id === 'pantry-form') {
      const id = values.id;
      const body = { ...values, min_quantity: Number(String(values.min_quantity || 0).replace(',', '.')), buy_again: form.elements.buy_again.checked };
      delete body.id;
      return mutate(id ? `/api/pantry/${id}` : '/api/pantry', { method: id ? 'PATCH' : 'POST', body }, id ? 'Vorrat aktualisiert.' : 'Lebensmittel eingetragen.');
    }
    if (form.id === 'transaction-form') {
      values.amount = Number(String(values.amount).replace(',', '.'));
      return mutate('/api/transactions', { method: 'POST', body: values }, 'Buchung gespeichert.');
    }
    if (form.id === 'budget-form') {
      const id = values.id;
      const body = { name: values.name, limit_amount: Number(String(values.limit_amount).replace(',', '.')) };
      return mutate(id ? `/api/budgets/${id}` : '/api/budgets', { method: id ? 'PATCH' : 'POST', body }, 'Budget gespeichert.');
    }
    if (form.id === 'note-form') {
      const id = values.id;
      const body = { ...values, pinned: form.elements.pinned.checked };
      delete body.id;
      return mutate(id ? `/api/notes/${id}` : '/api/notes', { method: id ? 'PATCH' : 'POST', body }, 'Notiz gespeichert.');
    }
    if (form.id === 'recipe-form') {
      const id = values.id;
      const body = { ...values, prep_minutes: Number(values.prep_minutes || 0), total_minutes: Number(values.total_minutes || 0), servings: Number(values.servings || 2), ingredients: parseIngredients(values.ingredients), steps: parseSteps(values.steps) };
      delete body.id;
      return mutate(id ? `/api/recipes/${id}` : '/api/recipes', { method: id ? 'PATCH' : 'POST', body }, 'Rezept gespeichert.');
    }
    if (form.id === 'meal-form') {
      values.recipe_id = Number(values.recipe_id);
      values.servings = Number(values.servings || 2);
      return mutate('/api/meal-plan', { method: 'POST', body: values }, 'Mahlzeit eingeplant.');
    }
    if (form.id === 'savings-form') {
      const savings = Number(String(values.savings).replace(',', '.'));
      return mutate('/api/settings', { method: 'PATCH', body: { savings } }, 'Sparbetrag gespeichert.');
    }
    if (form.id === 'challenge-form') {
      const existing = challengeState();
      const next = { ...existing, name: values.name, target: Number(String(values.target).replace(',', '.')), steps: Math.max(1, Number(values.steps || 1)) };
      await saveChallenge(next);
      closeModal(); enqueueRender(); showToast('Challenge gespeichert.', 'success');
      return;
    }
    if (form.id === 'settings-form') {
      return mutate('/api/settings', { method: 'PATCH', body: values }, 'Einstellungen gespeichert.');
    }
    if (form.id === 'checkout-form') {
      const items = (data.shopping || []).filter(item => item.checked).map(item => ({ id: item.id, price: item.price || 0 }));
      return mutate('/api/checkout', { method: 'POST', body: { store_name: values.store_name, items } }, 'Einkauf übernommen.');
    }
  } catch {
    // mutate already reports the error
  }
}

