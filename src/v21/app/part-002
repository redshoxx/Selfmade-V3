          </div>
        </header>
        <main id="main-content" class="page-content">${page.content}</main>
      </div>

      <nav class="bottom-nav" aria-label="Hauptnavigation">
        ${navItems().map(([view, label, iconName]) => navButton(view, label, iconName, 'bottom')).join('')}
      </nav>
    </div>
  `;
  renderModal();
  applyTheme();
}

function navButton(view, label, iconName, placement) {
  const active = ui.view === view;
  return `<button class="nav-item ${active ? 'is-active' : ''}" data-view="${view}" aria-current="${active ? 'page' : 'false'}">${icon(iconName, placement === 'bottom' ? 22 : 20)}<span>${label}</span>${view === 'shopping' && (data?.badges?.shopping || 0) ? `<b>${data.badges.shopping}</b>` : ''}</button>`;
}

function renderLoading() {
  appRoot.innerHTML = `<div class="loading-screen"><div class="brand-mark brand-mark-large">H</div><strong>HaushaltKlar</strong><span>Dein Haushalt wird geladen …</span><div class="loader"></div></div>`;
}

