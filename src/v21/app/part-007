  if (authMode) { ui.authMode = authMode.dataset.authMode; renderAuth(); return; }
  const kitchenTab = target.closest('[data-kitchen-tab]');
  if (kitchenTab) { ui.kitchenTab = kitchenTab.dataset.kitchenTab; enqueueRender(); return; }
  const moneyTab = target.closest('[data-money-tab]');
  if (moneyTab) { ui.moneyTab = moneyTab.dataset.moneyTab; enqueueRender(); return; }
  const moreTab = target.closest('[data-more-tab]');
  if (moreTab) { ui.moreTab = moreTab.dataset.moreTab; enqueueRender(); return; }
  const shoppingFilter = target.closest('[data-shopping-filter]');
  if (shoppingFilter) { ui.shoppingFilter = shoppingFilter.dataset.shoppingFilter; enqueueRender(); return; }
  const pantryFilter = target.closest('[data-pantry-filter]');
  if (pantryFilter) { ui.pantryFilter = pantryFilter.dataset.pantryFilter; enqueueRender(); return; }
  const themeButton = target.closest('[data-theme]');
  if (themeButton) { saveJson(UI_KEY, { ...loadJson(UI_KEY, {}), theme: themeButton.dataset.theme }); applyTheme(); enqueueRender(); return; }

  const button = target.closest('[data-action]');
  if (!button) return;
  const action = button.dataset.action;
  const id = Number(button.dataset.id);

  if (action === 'close-modal') return closeModal();
  if (action === 'quick-add') return openModal('quick-add');
  if (action === 'open-modal') return openModal(button.dataset.modal);
  if (action === 'add-shopping') return openModal('shopping');
  if (action === 'edit-shopping') return openModal('shopping', data.shopping.find(item => Number(item.id) === id));
  if (action === 'add-pantry') return openModal('pantry');
  if (action === 'edit-pantry') return openModal('pantry', data.pantry.find(item => Number(item.id) === id));
  if (action === 'add-transaction') return openModal('transaction');
  if (action === 'add-budget') return openModal('budget');
  if (action === 'edit-budget') return openModal('budget', data.budgets.find(item => Number(item.id) === id));
  if (action === 'add-note') return openModal('note');
  if (action === 'edit-note') return openModal('note', publicNotes().find(item => Number(item.id) === id));
  if (action === 'add-recipe') return openModal('recipe');
  if (action === 'edit-recipe') return openModal('recipe', data.recipes.find(item => Number(item.id) === id));
  if (action === 'open-recipe') return openModal('recipe-detail', data.recipes.find(item => Number(item.id) === id));
  if (action === 'add-meal') return openModal('meal', null, { date: button.dataset.date || todayIso() });
  if (action === 'edit-savings') return openModal('savings');
  if (action === 'setup-challenge') return openModal('challenge');
  if (action === 'edit-settings' || action === 'open-settings') { ui.view = 'more'; ui.moreTab = 'settings'; location.hash = '#more'; enqueueRender(); return; }
  if (action === 'checkout') return openModal('checkout');
  if (action === 'toggle-store-mode') { ui.storeMode = !ui.storeMode; enqueueRender(); return; }

  if (action === 'toggle-shopping') {
    const item = data.shopping.find(entry => Number(entry.id) === id);
    if (!item) return;
    return mutate(`/api/shopping/${id}`, { method: 'PATCH', body: { checked: !item.checked } });
  }
  if (action === 'delete-shopping') {
    if (!confirm('Produkt wirklich löschen?')) return;
    return mutate(`/api/shopping/${id}`, { method: 'DELETE' }, 'Produkt gelöscht.');
  }
  if (action === 'toggle-buy-again') {
    const item = data.pantry.find(entry => Number(entry.id) === id);
    return mutate(`/api/pantry/${id}`, { method: 'PATCH', body: { buy_again: !item.buy_again } }, item.buy_again ? 'Markierung entfernt.' : 'Zum Nachkaufen markiert.');
  }
  if (action === 'delete-transaction') {
    if (!confirm('Buchung wirklich löschen?')) return;
    return mutate(`/api/transactions/${id}`, { method: 'DELETE' }, 'Buchung gelöscht.');
  }
  if (action === 'delete-note') {
    if (!confirm('Notiz wirklich löschen?')) return;
    return mutate(`/api/notes/${id}`, { method: 'DELETE' }, 'Notiz gelöscht.');
  }
  if (action === 'recipe-to-shopping') {
    return mutate(`/api/recipes/${id}/shopping`, { method: 'POST', body: { consider_pantry: true } }, 'Fehlende Zutaten wurden hinzugefügt.');
  }
  if (action === 'complete-challenge-step') {
    const challenge = challengeState();
    if (!challenge.target || challenge.completed >= challenge.steps) return;
    const amount = challenge.target / challenge.steps;
    setBusy(true);
    try {
      await saveChallenge({ ...challenge, completed: challenge.completed + 1, saved: Math.min(challenge.target, challenge.saved + amount) });
      const payload = await request('/api/settings', { method: 'PATCH', body: { savings: Number(data.summary?.savings || 0) + amount } });
      adopt(payload);
      enqueueRender();
      showToast(`${currency(amount)} gespart.`, 'success');
    } catch (error) { showToast(error.message, 'error'); }
    finally { setBusy(false); }
    return;
  }
  if (action === 'logout') {
    setBusy(true);
    try { await request('/api/auth/signout', { method: 'POST' }); } catch {}
    session = null; data = null; currentUser = null; saveJson(STORAGE_KEY, null); setBusy(false); renderAuth();
  }
}

document.addEventListener('click', (event) => handleClick(event.target));
document.addEventListener('submit', (event) => {
  event.preventDefault();
  if (event.target.id === 'auth-form') handleAuthSubmit(event.target);
  else handleFormSubmit(event.target);
});
document.addEventListener('input', (event) => {
  const type = event.target.dataset.input;
  if (type === 'shopping-query') { ui.shoppingQuery = event.target.value; enqueueRender(); }
  if (type === 'recipe-query') { ui.recipeQuery = event.target.value; enqueueRender(); }
  if (type === 'note-query') { ui.noteQuery = event.target.value; enqueueRender(); }
});
window.addEventListener('hashchange', () => {
  const view = location.hash.replace('#', '');
  if (navItems().some(([id]) => id === view)) { ui.view = view; enqueueRender(); }
});
matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', applyTheme);

async function boot() {
  applyTheme();
  if (!session?.access_token) return renderAuth();
  renderLoading();
  try {
    await loadState();
    render();
  } catch (error) {
    if (error.status === 401) {
      session = null;
      saveJson(STORAGE_KEY, null);
      renderAuth();
      showToast('Bitte erneut anmelden.', 'error');
    } else {
      renderAuth();
      showToast(error.message, 'error');
    }
  }
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
}

boot();
