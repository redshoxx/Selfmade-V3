function icon(name, size = 20) {
  return `<svg class="icon" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name] || icons.more}</svg>`;
}

function esc(value = '') {
  return String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char]));
}

function loadJson(key, fallback) {
  try { return JSON.parse(localStorage.getItem(key)) ?? fallback; } catch { return fallback; }
}

function saveJson(key, value) {
  if (value == null) localStorage.removeItem(key);
  else localStorage.setItem(key, JSON.stringify(value));
}

function currency(value) {
  return new Intl.NumberFormat('de-AT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 2 }).format(Number(value || 0));
}

function dateLabel(value, options = { day: '2-digit', month: '2-digit', year: 'numeric' }) {
  if (!value) return 'Kein Datum';
  const date = new Date(`${String(value).slice(0, 10)}T12:00:00`);
  return Number.isNaN(date.getTime()) ? 'Kein Datum' : new Intl.DateTimeFormat('de-AT', options).format(date);
}

function todayIso() {
  const d = new Date();
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().slice(0, 10);
}

function daysUntil(value) {
  if (!value) return Infinity;
  const now = new Date(`${todayIso()}T12:00:00`);
  const target = new Date(`${String(value).slice(0, 10)}T12:00:00`);
  return Math.ceil((target - now) / 86400000);
}

function initials(name = '') {
  const parts = String(name).trim().split(/\s+/).filter(Boolean);
  return (parts[0]?.[0] || 'H') + (parts[1]?.[0] || '');
}

function enqueueRender() {
  if (renderQueued) return;
  renderQueued = true;
  requestAnimationFrame(() => {
    renderQueued = false;
    render();
  });
}

function showToast(message, tone = 'neutral') {
  clearTimeout(toastTimer);
  toastRoot.innerHTML = `<div class="toast toast-${tone}">${esc(message)}</div>`;
  toastTimer = setTimeout(() => { toastRoot.innerHTML = ''; }, 3200);
}

function setBusy(value) {
  ui.busy = value;
  document.documentElement.classList.toggle('is-busy', value);
}

