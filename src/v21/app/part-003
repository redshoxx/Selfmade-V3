        </article>
      </section>
    `,
  };
}

function metricCard(iconName, label, value, detail, view, tab = '') {
  return `<button class="metric-card" data-view="${view}" ${tab ? `data-${view === 'kitchen' ? 'kitchen' : view}-tab="${tab}"` : ''}><span class="metric-icon">${icon(iconName)}</span><span class="metric-label">${esc(label)}</span><strong>${esc(value)}</strong><small>${esc(detail)}</small></button>`;
}

function quickAction(iconName, title, text, modal) {
  return `<button class="quick-action" data-action="open-modal" data-modal="${modal}"><span>${icon(iconName)}</span><div><strong>${esc(title)}</strong><small>${esc(text)}</small></div>${icon('chevron', 16)}</button>`;
}

function renderShopping() {
  const query = String(ui.shoppingQuery || '').trim().toLowerCase();
  let items = (data.shopping || []).filter((item) => !query || item.name.toLowerCase().includes(query) || item.category.toLowerCase().includes(query));
  if (ui.shoppingFilter === 'open') items = items.filter((item) => !item.checked);
  if (ui.shoppingFilter === 'done') items = items.filter((item) => item.checked);
  const grouped = groupBy(items, (item) => item.category || 'Sonstiges');
  const openCount = (data.shopping || []).filter((item) => !item.checked).length;
  const checkedCount = (data.shopping || []).filter((item) => item.checked).length;
  const estimated = (data.shopping || []).filter((item) => !item.checked).reduce((sum, item) => sum + Number(item.price || 0), 0);

  return {
    eyebrow: 'Alles für den nächsten Einkauf',
    title: 'Einkauf',
    action: `<button class="primary-button icon-label" data-action="add-shopping">${icon('plus')}<span>Produkt</span></button>`,
    content: `
      <section class="toolbar-card">
        <div class="search-field">${icon('search', 18)}<input data-input="shopping-query" value="${esc(ui.shoppingQuery || '')}" placeholder="Produkte durchsuchen"></div>
        <div class="segmented compact">
          <button class="${ui.shoppingFilter === 'open' ? 'is-active' : ''}" data-shopping-filter="open">Offen <span>${openCount}</span></button>
          <button class="${ui.shoppingFilter === 'all' ? 'is-active' : ''}" data-shopping-filter="all">Alle</button>
          <button class="${ui.shoppingFilter === 'done' ? 'is-active' : ''}" data-shopping-filter="done">Erledigt <span>${checkedCount}</span></button>
        </div>
      </section>

      <section class="shopping-summary">
        <div><span>Noch offen</span><strong>${openCount}</strong></div>
        <div><span>Geschätzt</span><strong>${currency(estimated)}</strong></div>
        <button class="${ui.storeMode ? 'primary-button' : 'secondary-button'}" data-action="toggle-store-mode">${ui.storeMode ? 'Ladenmodus aktiv' : 'Ladenmodus'}</button>
      </section>

      <section class="list-surface ${ui.storeMode ? 'store-mode' : ''}">
        ${items.length ? Object.entries(grouped).map(([category, rows]) => `
          <div class="list-group">
            <div class="list-group-title"><h2>${esc(category)}</h2><span>${rows.length}</span></div>
            ${rows.map(renderShoppingRow).join('')}
          </div>
        `).join('') : emptyState('shopping', 'Keine Produkte gefunden', ui.shoppingFilter === 'open' ? 'Deine Einkaufsliste ist leer.' : 'Passe Filter oder Suche an.', `<button class="primary-button" data-action="add-shopping">Produkt hinzufügen</button>`)}
      </section>
      ${ui.storeMode && checkedCount ? `<div class="sticky-checkout"><div><span>${checkedCount} ausgewählt</span><strong>${currency((data.shopping || []).filter(i => i.checked).reduce((sum, i) => sum + Number(i.price || 0), 0))}</strong></div><button class="primary-button" data-action="checkout">Einkauf abschließen</button></div>` : ''}
    `,
  };
}

function renderShoppingRow(item) {
  return `<div class="list-row ${item.checked ? 'is-done' : ''}">
    <button class="check-button ${item.checked ? 'is-checked' : ''}" data-action="toggle-shopping" data-id="${item.id}" aria-label="${item.checked ? 'Als offen markieren' : 'Als erledigt markieren'}">${item.checked ? icon('check', 16) : ''}</button>
    <button class="row-main" data-action="edit-shopping" data-id="${item.id}"><strong>${esc(item.name)}</strong><span>${esc(item.quantity || '1')} ${item.note ? `· ${esc(item.note)}` : ''}</span></button>
    ${item.price != null ? `<span class="row-price">${currency(item.price)}</span>` : ''}
    <button class="icon-button subtle" data-action="delete-shopping" data-id="${item.id}" aria-label="Löschen">${icon('trash', 18)}</button>
  </div>`;
}

function renderKitchen() {
  const tabs = [
    ['recipes', 'Rezepte'],
    ['pantry', 'Vorrat'],
    ['plan', 'Wochenplan'],
  ];
  let content = '';
  let action = '';
  if (ui.kitchenTab === 'pantry') {
    content = renderPantry();
    action = `<button class="primary-button icon-label" data-action="add-pantry">${icon('plus')}<span>Lebensmittel</span></button>`;
  } else if (ui.kitchenTab === 'plan') {
    content = renderMealPlan();
    action = `<button class="primary-button icon-label" data-action="add-meal">${icon('plus')}<span>Mahlzeit</span></button>`;
  } else {
    content = renderRecipes();
    action = `<button class="primary-button icon-label" data-action="add-recipe">${icon('plus')}<span>Rezept</span></button>`;
  }
  return {
    eyebrow: 'Kochen und Vorräte gemeinsam planen',
    title: 'Küche',
    action,
    content: `<div class="page-tabs">${tabs.map(([id, label]) => `<button class="${ui.kitchenTab === id ? 'is-active' : ''}" data-kitchen-tab="${id}">${label}</button>`).join('')}</div>${content}`,
  };
}

function renderRecipes() {
  const query = ui.recipeQuery.trim().toLowerCase();
  const recipes = (data.recipes || []).filter((recipe) => !query || recipe.name.toLowerCase().includes(query) || String(recipe.category || '').toLowerCase().includes(query));
  return `
    <section class="toolbar-card single"><div class="search-field">${icon('search', 18)}<input data-input="recipe-query" value="${esc(ui.recipeQuery)}" placeholder="Rezepte durchsuchen"></div></section>
    ${recipes.length ? `<section class="recipe-grid">${recipes.map(recipe => `
      <article class="recipe-card">
        <button class="recipe-click" data-action="open-recipe" data-id="${recipe.id}">
          <div class="recipe-image ${recipe.image_data_url ? 'has-image' : ''}" ${recipe.image_data_url ? `style="background-image:url('${esc(recipe.image_data_url)}')"` : ''}>${recipe.image_data_url ? '' : icon('recipe', 30)}</div>
          <div class="recipe-content"><span>${esc(recipe.category || 'Rezept')}</span><h2>${esc(recipe.name)}</h2><p>${esc(recipe.description || 'Ohne Beschreibung')}</p><div><small>${recipe.total_minutes || recipe.prep_minutes || 0} Min.</small><small>${recipe.servings || 2} Portionen</small></div></div>
        </button>
        <button class="icon-button recipe-edit" data-action="edit-recipe" data-id="${recipe.id}" aria-label="Rezept bearbeiten">${icon('edit', 17)}</button>
      </article>
    `).join('')}</section>` : emptyState('recipe', 'Noch keine Rezepte', 'Speichere eigene Rezepte mit Zutaten und Schritten.', `<button class="primary-button" data-action="add-recipe">Erstes Rezept anlegen</button>`)}
  `;
}

function renderPantry() {
  let items = [...(data.pantry || [])];
  if (ui.pantryFilter === 'expiring') items = items.filter((item) => daysUntil(item.expiry_date) <= 7);
  if (ui.pantryFilter === 'low') items = items.filter((item) => item.low_stock || item.buy_again);
  const expiring = (data.pantry || []).filter((item) => daysUntil(item.expiry_date) <= 7).length;
  const low = (data.pantry || []).filter((item) => item.low_stock || item.buy_again).length;
  return `
    <section class="toolbar-card"><div class="segmented compact wide"><button class="${ui.pantryFilter === 'all' ? 'is-active' : ''}" data-pantry-filter="all">Alle <span>${data.pantry?.length || 0}</span></button><button class="${ui.pantryFilter === 'expiring' ? 'is-active' : ''}" data-pantry-filter="expiring">Bald fällig <span>${expiring}</span></button><button class="${ui.pantryFilter === 'low' ? 'is-active' : ''}" data-pantry-filter="low">Nachkaufen <span>${low}</span></button></div></section>
    <section class="list-surface">
      ${items.length ? items.map(item => {
        const remaining = daysUntil(item.expiry_date);
        const expiryText = Number.isFinite(remaining) ? (remaining < 0 ? 'Abgelaufen' : remaining === 0 ? 'Heute fällig' : `Noch ${remaining} Tage`) : 'Kein Ablaufdatum';
        return `<div class="list-row pantry-row ${remaining <= 1 ? 'is-urgent' : ''}">
          <div class="pantry-symbol">${icon('pantry', 18)}</div>
          <button class="row-main" data-action="edit-pantry" data-id="${item.id}"><strong>${esc(item.name)}</strong><span>${esc(item.quantity || '1')} ${esc(item.unit || '')} · ${esc(item.location || 'Vorrat')}</span></button>
          <div class="row-meta"><strong>${esc(expiryText)}</strong><span>${item.expiry_date ? dateLabel(item.expiry_date) : ''}</span></div>
          <button class="icon-button subtle ${item.buy_again ? 'is-highlighted' : ''}" data-action="toggle-buy-again" data-id="${item.id}" aria-label="Nachkaufen markieren">${icon('shopping', 18)}</button>
        </div>`;
