    if (body.plan_date !== undefined && /^\d{4}-\d{2}-\d{2}$/.test(body.plan_date)) row.plan_date = body.plan_date;
    if (body.meal_type !== undefined && ['Frühstück','Mittagessen','Abendessen','Snack'].includes(body.meal_type)) row.meal_type = body.meal_type;
