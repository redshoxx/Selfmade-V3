
/* Version 16 – neu gestaltete Einkaufsseite und schnelles Hinzufügen */
let shoppingDraftV16 = '';
let showCompletedShoppingV16 = false;

const headerBeforeShoppingV16 = header;
header = function headerV16() {
  if (activeTab !== 'shopping') return headerBeforeShoppingV16();
  const openCount = data.shopping.filter((item) => !item.checked).length;
  return `<header class="page-header shopping-page-header">
    <div class="page-title-wrap">
      <h1 class="page-title compact">Einkauf</h1>
      <p class="shopping-header-meta">${openCount ? `${openCount} ${openCount === 1 ? 'Artikel offen' : 'Artikel offen'}` : 'Liste vollständig'}</p>
    </div>
    <button class="btn btn-primary small shopping-store-button" data-action="start-store" ${openCount ? '' : 'disabled'}>${icon('store', 16)} Im Laden</button>
  </header>`;
};

function normalizeShoppingTextV16(value) {
  return String(value || '').trim().toLocaleLowerCase('de-AT');
}

function inferShoppingCategoryV16(name) {
  const normalized = normalizeShoppingTextV16(name);
  const exactSources = [
    ...(data.product_catalog || []).map((item) => ({ name: item.name, category: item.category })),
    ...(data.pantry || []).map((item) => ({ name: item.name, category: item.category })),
    ...(data.recurring || []).map((item) => ({ name: item.name, category: item.category }))
  ];
  const exact = exactSources.find((item) => normalizeShoppingTextV16(item.name) === normalized && item.category);
  if (exact) return exact.category;

  const rules = [
    ['Obst & Gemüse', /\b(apfel|äpfel|banane|orange|zitrone|tomate|gurke|paprika|kartoffel|zwiebel|salat|karotte|möhre|gemüse|obst|beere|traube|avocado)\b/],
    ['Backwaren', /\b(brot|semmel|brötchen|weckerl|toast|croissant|baguette|gebäck)\b/],
    ['Kühlregal', /\b(milch|joghurt|käse|butter|rahm|sahne|topfen|quark|frischkäse|wurst|schinken|ei|eier)\b/],
    ['Tiefkühl', /\b(tk|tiefkühl|eis|pizza|pommes|fischstäbchen)\b/],
    ['Haushalt', /\b(spülmittel|waschmittel|reiniger|toilettenpapier|klopapier|küchenrolle|müllsack|schwamm|seife|shampoo|zahnpasta)\b/],
    ['Vorrat', /\b(nudel|reis|mehl|zucker|salz|öl|essig|kaffee|tee|müsli|haferflocken|dose|konserve|gewürz)\b/]
  ];
  return rules.find(([, pattern]) => pattern.test(normalized))?.[0] || 'Sonstiges';
}

function parseShoppingDraftV16(rawValue) {
  const raw = String(rawValue || '').trim();
  const match = raw.match(/^(\d+(?:[,.]\d+)?\s*(?:x|kg|g|l|ml|stk\.?|stück|packung|pkg\.?|becher|dose|flasche|bund)?)\s+(.+)$/i);
  const quantity = match ? match[1].replace(/\s+/g, ' ').trim() : '1';
  const name = match ? match[2].trim() : raw;
  return { name, quantity, category: inferShoppingCategoryV16(name) };
}

function shoppingCatalogMatchesV16(query) {
  const normalized = normalizeShoppingTextV16(query);
  if (!normalized) return [];
  const listed = new Set(data.shopping.map((item) => normalizeShoppingTextV16(item.name)));
  const seen = new Set();
  const candidates = [
    ...(data.product_catalog || []).map((item) => ({
      name: item.name,
      quantity: item.default_quantity || '1',
      category: item.category || 'Sonstiges',
      source: item.brand || 'Produktkatalog'
    })),
    ...(data.recurring || []).map((item) => ({
      name: item.name,
      quantity: item.quantity || '1',
      category: item.category || 'Sonstiges',
      source: 'Routine'
    })),
    ...(data.pantry || []).map((item) => ({
      name: item.name,
      quantity: item.unit ? `${item.quantity} ${item.unit}` : item.quantity || '1',
      category: item.category || 'Sonstiges',
      source: 'Vorrat'
    }))
  ];
  return candidates
    .filter((item) => {
      const key = normalizeShoppingTextV16(item.name);
      if (!key || seen.has(key) || listed.has(key) || !key.includes(normalized)) return false;
      seen.add(key);
      return true;
    })
    .sort((a, b) => {
      const aName = normalizeShoppingTextV16(a.name);
      const bName = normalizeShoppingTextV16(b.name);
      return Number(!aName.startsWith(normalized)) - Number(!bName.startsWith(normalized)) || aName.localeCompare(bName, 'de');
    })
    .slice(0, 5);
}

function shoppingInlineMatchesHtmlV16() {
  const matches = shoppingCatalogMatchesV16(shoppingDraftV16);
  if (!matches.length) return '';
  return `<div class="shopping-inline-results" role="listbox" aria-label="Passende Produkte">
    ${matches.map((item) => `<button type="button" class="shopping-inline-result" data-action="add-shopping-match-v16" data-name="${escapeHtml(item.name)}" data-quantity="${escapeHtml(item.quantity)}" data-category="${escapeHtml(item.category)}">
      <span class="shopping-result-emoji">${emojiForCategory(item.category)}</span>
      <span class="shopping-result-copy"><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.source)} · ${escapeHtml(item.quantity)}</small></span>
      <span class="shopping-result-add">${icon('plus', 16)}</span>
    </button>`).join('')}
  </div>`;
}

function shoppingRowV16(item, completed = false) {
  const numeric = /^\d+$/.test(String(item.quantity));
  const details = [item.quantity && `${item.quantity}`, item.note, memberName(item.member_id)].filter(Boolean).map(escapeHtml).join(' · ');
  return `<article class="shopping-item-v16 ${completed ? 'is-completed' : ''}">
    <button class="check shopping-check-v16 ${item.checked ? 'checked' : ''}" data-action="toggle-shopping" data-id="${item.id}" aria-label="${item.checked ? 'Artikel wieder öffnen' : 'Artikel abhaken'}">${item.checked ? icon('check', 16) : ''}</button>
    <button class="shopping-item-main" data-action="edit-shopping" data-id="${item.id}">
      <span class="shopping-item-title">${escapeHtml(item.name)}</span>
      ${details ? `<span class="shopping-item-details">${details}</span>` : ''}
    </button>
    ${!completed && numeric ? `<span class="quantity-stepper shopping-stepper-v16">
      <button class="step-button" data-action="quantity" data-id="${item.id}" data-delta="-1" aria-label="Menge verringern">−</button>
      <span class="step-value">${escapeHtml(item.quantity)}</span>
      <button class="step-button" data-action="quantity" data-id="${item.id}" data-delta="1" aria-label="Menge erhöhen">+</button>
    </span>` : `<button class="shopping-edit-v16" data-action="edit-shopping" data-id="${item.id}" aria-label="Artikel bearbeiten">${icon('chevronRight', 18)}</button>`}
  </article>`;
}

function shoppingGroupsForV16(items) {
  const order = ['Obst & Gemüse', 'Backwaren', 'Kühlregal', 'Tiefkühl', 'Vorrat', 'Haushalt', 'Sonstiges'];
  const map = new Map();
  for (const item of items) {
    const category = item.category || 'Sonstiges';
    if (!map.has(category)) map.set(category, []);
    map.get(category).push(item);
  }
  return [...map.entries()].sort((a, b) => {
    const ai = order.indexOf(a[0]);
    const bi = order.indexOf(b[0]);
    return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi);
  });
}

renderShopping = function renderShoppingV16() {
  const openItems = data.shopping.filter((item) => !item.checked);
  const completedItems = data.shopping.filter((item) => item.checked);
  const total = data.shopping.length;
  const completed = completedItems.length;
  const progress = total ? completed / total * 100 : 0;
  const suggestions = data.suggestions || [];

  return `<div class="content-stack shopping-screen-v16">
    <section class="card shopping-add-card-v16">
      <div class="shopping-add-heading">
        <div><span class="shopping-add-kicker">SCHNELL HINZUFÜGEN</span><h2>Was brauchst du?</h2></div>
        <span class="shopping-open-count">${openItems.length}</span>
      </div>
      <form class="shopping-quick-form-v16" data-form="shopping-quick-v16">
        <label class="sr-only" for="shopping-quick-input">Artikelname und Menge</label>
        <div class="shopping-input-shell-v16">${icon('search', 18)}<input id="shopping-quick-input" name="name" value="${escapeHtml(shoppingDraftV16)}" placeholder="z. B. Milch oder 2 kg Kartoffeln" autocomplete="off" autocapitalize="words" enterkeyhint="done"></div>
        <button class="btn btn-primary shopping-add-submit-v16" type="submit">Hinzufügen</button>
      </form>
      <div data-shopping-inline-results>${shoppingInlineMatchesHtmlV16()}</div>
      <div class="shopping-add-actions-v16">
        <button type="button" data-action="scan-barcode">${icon('scan', 17)}<span>Scannen</span></button>
        <button type="button" data-action="open-shopping-details-v16" ${shoppingDraftV16.trim() ? '' : 'disabled'}>${icon('edit', 17)}<span>Mit Details</span></button>
        <button type="button" data-action="recurring">${icon('repeat', 17)}<span>Routinen</span></button>
      </div>
    </section>

    ${total ? `<section class="shopping-progress-card-v16">
      <div><strong>${openItems.length ? `${openItems.length} noch offen` : 'Alles erledigt'}</strong><span>${completed} von ${total} erledigt</span></div>
      <div class="progress-track"><div class="progress-fill green" style="width:${progress}%"></div></div>
    </section>` : ''}

    ${suggestions.length ? `<section class="shopping-suggestions-v16">
      <div class="section-title-row"><h2 class="section-title">Zum Nachkaufen</h2><span class="section-meta">aus deinen Daten</span></div>
      <div class="shopping-suggestion-list-v16">
        ${suggestions.map((item) => `<button class="shopping-suggestion-v16" data-action="add-suggestion" data-name="${escapeHtml(item.name)}" data-quantity="${escapeHtml(item.quantity)}" data-category="${escapeHtml(item.category)}">
          <span>${emojiForCategory(item.category)}</span><span><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.reason || item.quantity || '')}</small></span>${icon('plus', 16)}
        </button>`).join('')}
      </div>
    </section>` : ''}

    ${shoppingGroupsForV16(openItems).map(([category, items]) => `<section class="shopping-category-v16">
      <div class="shopping-category-heading-v16"><span><i>${emojiForCategory(category)}</i><strong>${escapeHtml(category)}</strong></span><small>${items.length}</small></div>
      <div class="shopping-items-v16">${items.map((item) => shoppingRowV16(item)).join('')}</div>
    </section>`).join('')}

    ${!openItems.length && !completedItems.length ? `<section class="card shopping-empty-v16">
      <span class="shopping-empty-icon-v16">${icon('cart', 26)}</span>
      <strong>Deine Einkaufsliste ist leer</strong>
      <span>Tippe oben einen Artikel ein oder scanne einen Barcode.</span>
      <button class="btn btn-primary" data-action="focus-shopping-input-v16">Ersten Artikel hinzufügen</button>
    </section>` : ''}

    ${completedItems.length ? `<section class="shopping-completed-v16">
      <button class="shopping-completed-toggle-v16" data-action="toggle-completed-shopping-v16" aria-expanded="${showCompletedShoppingV16}">
        <span>${icon('check', 16)} Erledigt</span><span>${completedItems.length} ${icon(showCompletedShoppingV16 ? 'chevronLeft' : 'chevronRight', 16)}</span>
      </button>
      ${showCompletedShoppingV16 ? `<div class="shopping-items-v16 completed-list-v16">${completedItems.map((item) => shoppingRowV16(item, true)).join('')}</div>` : ''}
    </section>` : ''}
  </div>`;
};

async function addShoppingItemV16(payload, message) {
  await mutate(async () => {
    const result = await api('/api/shopping', { method: 'POST', body: JSON.stringify(payload) });
    shoppingDraftV16 = '';
    return result;
  }, message);
}

shell.addEventListener('input', (event) => {
  if (event.target.id !== 'shopping-quick-input') return;
  shoppingDraftV16 = event.target.value;
  const target = shell.querySelector('[data-shopping-inline-results]');
  if (target) target.innerHTML = shoppingInlineMatchesHtmlV16();
  const details = shell.querySelector('[data-action="open-shopping-details-v16"]');
  if (details) details.disabled = !shoppingDraftV16.trim();
});

shell.addEventListener('submit', async (event) => {
  const form = event.target.closest('form[data-form="shopping-quick-v16"]');
  if (!form) return;
  event.preventDefault();
  const parsed = parseShoppingDraftV16(new FormData(form).get('name'));
  if (!parsed.name) return;
  await addShoppingItemV16(parsed, `${parsed.name} hinzugefügt`);
  queueMicrotask(() => shell.querySelector('#shopping-quick-input')?.focus({ preventScroll: true }));
});

shell.addEventListener('click', async (event) => {
  const target = event.target.closest('[data-action]');
  if (!target) return;
  const action = target.dataset.action;
  if (action === 'focus-shopping-input-v16') {
    shell.querySelector('#shopping-quick-input')?.focus({ preventScroll: false });
  } else if (action === 'open-shopping-details-v16') {
    const parsed = parseShoppingDraftV16(shell.querySelector('#shopping-quick-input')?.value || shoppingDraftV16);
    openShopping(parsed.name ? parsed : null);
  } else if (action === 'add-shopping-match-v16') {
    await addShoppingItemV16({
      name: target.dataset.name,
      quantity: target.dataset.quantity || '1',
      category: target.dataset.category || 'Sonstiges'
    }, `${target.dataset.name} hinzugefügt`);
  } else if (action === 'toggle-completed-shopping-v16') {
    showCompletedShoppingV16 = !showCompletedShoppingV16;
    renderApp();
  }
});
