storeCategories = function storeCategoriesV17() {
  return shoppingGroupsForV16(data.shopping).map(([category, items]) => ({ category, items }));
};

function storeProgressV17() {
  const total = data.shopping.length;
  const checked = data.shopping.filter((item) => item.checked).length;
  return { total, checked, percent: total ? checked / total * 100 : 0 };
}

function storePriceLabelV17(item) {
  const value = Number(storeMode.prices.get(item.id) ?? item.price ?? 0);
  return value > 0 ? money(value) : 'Preis';
}

function storeItemV17(item) {
  const done = Boolean(item.checked);
  return `<article class="store-item-v17 ${done ? 'is-done' : ''}">
    <button class="check store-check-v17 ${done ? 'checked' : ''}" data-action="toggle-store-item-v17" data-id="${item.id}" aria-label="${done ? 'Artikel wieder öffnen' : 'In den Wagen legen'}">${done ? icon('check', 16) : ''}</button>
    <button class="store-item-main-v17" data-action="toggle-store-item-v17" data-id="${item.id}">
      <strong>${escapeHtml(item.name)}</strong>
      <small>${escapeHtml(item.quantity || '1')}${item.note ? ` · ${escapeHtml(item.note)}` : ''}</small>
    </button>
    <button class="store-price-button-v17 ${Number(storeMode.prices.get(item.id) ?? item.price ?? 0) > 0 ? 'has-price' : ''}" data-action="open-store-price-v17" data-id="${item.id}">${escapeHtml(storePriceLabelV17(item))}</button>
  </article>`;
}

renderStoreMode = function renderStoreModeV17() {
  const groups = storeCategories();
  if (!groups.length) {
    storeMode.active = false;
    queueMicrotask(renderApp);
    return '';
  }
  const idx = clamp(storeMode.categoryIndex, 0, groups.length - 1);
  storeMode.categoryIndex = idx;
  if (storeMode.checkout) return renderCheckout(groups);
  const current = groups[idx];
  const currentChecked = current.items.filter((item) => item.checked).length;
  const progress = storeProgressV17();
  const openCurrent = current.items.filter((item) => !item.checked);
  const doneCurrent = current.items.filter((item) => item.checked);
  const nextLabel = idx === groups.length - 1 ? 'Einkauf abschließen' : 'Nächste Abteilung';

  return `<div class="store-mode store-mode-v17">
    <header class="store-header-v17">
      <div class="store-nav-v17"><div><span>IM LADEN</span><strong>${progress.checked} von ${progress.total}</strong></div><button data-action="end-store">Beenden</button></div>
      <div class="store-overall-progress-v17"><i style="width:${progress.percent}%"></i></div>
      <div class="store-section-heading-v17"><span>${emojiForCategory(current.category)}</span><div><h1>${escapeHtml(current.category)}</h1><p>Abteilung ${idx + 1} von ${groups.length} · ${currentChecked} von ${current.items.length} erledigt</p></div></div>
    </header>
    <main class="store-content-v17">
      <div class="store-items-v17">${[...openCurrent, ...doneCurrent].map(storeItemV17).join('')}</div>
      ${progress.checked ? `<button class="store-cart-summary-v17" data-action="store-checkout-v17"><span>${icon('cart', 18)} Im Wagen · ${progress.checked}</span><strong>${money(storeTotal())}</strong></button>` : ''}
    </main>
    <footer class="store-footer-v17">
      <button class="store-back-v17" data-action="store-prev-v17" ${idx === 0 ? 'disabled' : ''} aria-label="Vorherige Abteilung">${icon('chevronLeft', 20)}</button>
      <button class="btn btn-primary store-next-v17" data-action="store-next-v17">${nextLabel}</button>
    </footer>
  </div>`;
};

renderCheckout = function renderCheckoutV17(groups) {
  const checked = data.shopping.filter((item) => item.checked);
  const total = storeTotal();
  const missingPrices = checked.filter((item) => Number(storeMode.prices.get(item.id) ?? item.price ?? 0) <= 0).length;
  return `<div class="store-mode store-mode-v17 checkout-v17">
    <header class="store-header-v17">
      <div class="store-nav-v17"><div><span>ABSCHLUSS</span><strong>Einkauf prüfen</strong></div><button data-action="end-store">Beenden</button></div>
      <div class="store-overall-progress-v17"><i style="width:100%"></i></div>
    </header>
    <main class="store-checkout-content-v17">
      <section class="store-checkout-card-v17">
        <span class="store-checkout-icon-v17">${icon('check', 24)}</span>
        <h1>Einkauf abschließen</h1>
        <p>${checked.length} ${checked.length === 1 ? 'Artikel' : 'Artikel'} im Wagen</p>
        <strong class="store-checkout-total-v17">${money(total)}</strong>
        ${missingPrices ? `<div class="store-missing-price-v17">${missingPrices} ${missingPrices === 1 ? 'Artikel hat' : 'Artikel haben'} noch keinen Preis.</div>` : `<div class="store-ready-v17">Alle Preise sind erfasst.</div>`}
      </section>
      <section class="store-checkout-list-v17">
        ${checked.map((item) => `<button data-action="open-store-price-v17" data-id="${item.id}"><span>${emojiForCategory(item.category)} ${escapeHtml(item.name)}</span><strong>${escapeHtml(storePriceLabelV17(item))}</strong></button>`).join('')}
      </section>
    </main>
    <footer class="store-footer-v17">
      <button class="store-back-v17" data-action="store-back-from-checkout-v17" aria-label="Zurück">${icon('chevronLeft', 20)}</button>
      <button class="btn btn-primary store-next-v17" data-action="checkout">Abschließen</button>
    </footer>
  </div>`;
};

function openStorePriceSheetV17(item) {
  if (!item) return;
  const current = Number(storeMode.prices.get(item.id) ?? item.price ?? 0);
  openDialog(`Preis für ${item.name}`, `
    <div class="store-price-sheet-v17">
      <div class="store-price-product-v17"><span>${emojiForCategory(item.category)}</span><div><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.quantity || '1')}</small></div></div>
      <div class="field"><label for="store-price-input-v17">Preis in Euro</label><div class="store-price-input-v17"><input id="store-price-input-v17" inputmode="decimal" enterkeyhint="done" value="${current > 0 ? escapeHtml(number.format(current)) : ''}" placeholder="0,00" autofocus><span>€</span></div></div>
      <div class="dialog-actions"><button type="button" class="btn btn-secondary" data-action="clear-store-price-v17" data-id="${item.id}">Ohne Preis</button><button type="button" class="btn btn-primary" data-action="save-store-price-v17" data-id="${item.id}">Übernehmen</button></div>
    </div>
  `);
}

