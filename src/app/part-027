
/* Version 19.1 – einzelner GuteKueche-Linkimport */
function openGuteKuecheImportV191() {
  openDialog('Von GuteKueche importieren', `<div class="gutekueche-import-v191"><div class="gutekueche-brand-v191"><span>GK</span><div><strong>GuteKueche.at</strong><small>Ein einzelnes Rezept für den persönlichen Gebrauch</small></div></div><p>Füge den direkten Link zu einer Rezeptseite ein. Vor dem Speichern öffnet Selfmade das normale Rezeptformular zur Kontrolle.</p>${field('Rezeptlink', 'gutekueche_url', '', 'url', 'required inputmode="url" autocomplete="url" placeholder="https://www.gutekueche.at/...-rezept-123" autofocus')}<div class="gutekueche-rules-v191"><span>${icon('check', 13)} Kein automatischer Massenimport</span><span>${icon('check', 13)} Quellenangabe bleibt gespeichert</span><span>${icon('check', 13)} Originalbild wird nicht kopiert</span></div></div><div class="dialog-actions"><button type="button" class="btn btn-secondary" data-action="close-dialog">Abbrechen</button><button class="btn btn-primary">Rezept prüfen</button></div>`, 'gutekueche-import-v191');
  dialogRoot.querySelector('.dialog')?.classList.add('gutekueche-dialog-v191');
}
shell.addEventListener('click', (event) => { if (event.target.closest('[data-action="import-gutekueche-v191"]')) openGuteKuecheImportV191(); });
dialogRoot.addEventListener('submit', async (event) => {
  const form = event.target.closest('form[data-form="gutekueche-import-v191"]'); if (!form) return;
  event.preventDefault(); event.stopImmediatePropagation(); if (!beginFormSubmission(form)) return;
  try { const url = new FormData(form).get('gutekueche_url'); const response = await api('/api/recipes/import/gutekueche/preview', { method: 'POST', body: JSON.stringify({ url }) }); closeDialog(); openRecipeEditorV19(response.recipe); toast('Rezept geladen – bitte prüfen und speichern'); }
  catch (error) { toast(error.message || 'Rezept konnte nicht importiert werden.', 'error'); }
  finally { endFormSubmission(form); }
}, true);
