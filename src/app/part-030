shell.addEventListener('click', (event) => {
  const target = event.target.closest('[data-action]');
  if (!target) return;
  if (target.dataset.action === 'show-rights-v193') openRightsV193();
  if (target.dataset.action === 'show-ai-policy-v193') openAiPolicyV193();
});

exportData = async function exportDataV193() {
  try {
    const payload = await api('/api/export');
    const protectedPayload = {
      _haushaltklar: {
        product: 'HaushaltKlar',
        version: '19.3.0',
        exported_at: new Date().toISOString(),
        copyright: HAUSHALTKLAR_RIGHTS_V193.copyright,
        confidentiality: 'Benutzerdaten – nicht für Weitergabe, KI-Training oder Text- und Data-Mining freigegeben.'
      },
      ...payload
    };
    const blob = new Blob([JSON.stringify(protectedPayload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `haushaltklar-backup-${todayLocal()}.json`;
    link.click();
    URL.revokeObjectURL(url);
    toast('Geschütztes Backup erstellt');
  } catch (error) { toast(error.message, 'error'); }
};
