    try { items = JSON.parse(values.items_json || '[]'); } catch {}
    const ocrText = dialogRoot.querySelector('#receipt-ocr')?.value || '';
    const payload = {
      store_name: values.store_name,
      receipt_date: values.receipt_date,
      total: values.total === '' ? null : Number(values.total),
      transaction_category: values.transaction_category,
      items,
      ocr_text: ocrText,
      image_data_url: receiptImageData,
      book_transaction: fd.has('book_transaction'),
      transfer_to_pantry: fd.has('transfer_to_pantry')
    };
    await mutate(() => api('/api/receipts', { method: 'POST', body: JSON.stringify(payload) }), 'Kassenbon importiert');
  }
  } finally {
    endFormSubmission(form);
  }
});

toastRoot.addEventListener('click', async (event) => {
  const button = event.target.closest('[data-toast-action]');
  if (!button) return;
  const fn = toastActions.get(button.dataset.toastAction);
  toastActions.delete(button.dataset.toastAction);
  button.closest('.toast')?.remove();
  if (fn) await fn();
});

document.addEventListener('invalid', (event) => {
  if (event.target instanceof HTMLElement) event.target.setAttribute('aria-invalid', 'true');
}, true);

document.addEventListener('input', (event) => {
  if (event.target instanceof HTMLElement && event.target.matches('input, textarea, select')) {
    event.target.removeAttribute('aria-invalid');
    event.target.closest('form')?.classList.remove('was-validated');
  }
});

document.addEventListener('keydown', (event) => {
  if (event.key !== 'Enter' || event.isComposing) return;
  const current = event.target;
  if (!(current instanceof HTMLInputElement) || current.type === 'submit' || current.type === 'button' || current.type === 'search') return;
  const form = current.closest('form');
  if (!form) return;
  const controls = [...form.querySelectorAll('input:not([type="hidden"]):not([disabled]), select:not([disabled]), textarea:not([disabled])')]
    .filter((control) => !['checkbox', 'radio', 'file'].includes(control.type));
  const index = controls.indexOf(current);
  if (index > -1 && index < controls.length - 1) {
    event.preventDefault();
    controls[index + 1].focus();
  }
});

// Native iPhone-PWA-Viewport: Safe-Areas, Bildschirmtastatur und Rotation.
let stableViewportHeight = Math.max(window.innerHeight, window.visualViewport?.height || 0);
let viewportSyncFrame = 0;

function activeFormControl() {
  const element = document.activeElement;
  return element instanceof HTMLElement && element.matches('input, textarea, select, [contenteditable="true"]');
}

function syncNativeViewport() {
  cancelAnimationFrame(viewportSyncFrame);
  viewportSyncFrame = requestAnimationFrame(() => {
    const viewport = window.visualViewport;
    const height = Math.max(320, Math.round(viewport?.height || window.innerHeight));
    const offsetTop = Math.max(0, Math.round(viewport?.offsetTop || 0));
    const editorActive = activeFormControl();
    if (!editorActive && height > stableViewportHeight - 80) stableViewportHeight = Math.max(stableViewportHeight, height);
    const keyboardInset = editorActive ? Math.max(0, stableViewportHeight - height - offsetTop) : 0;
    const keyboardOpen = editorActive && keyboardInset > 110;
    document.documentElement.style.setProperty('--app-viewport-height', `${height}px`);
    document.documentElement.style.setProperty('--app-viewport-offset', `${offsetTop}px`);
    document.documentElement.style.setProperty('--keyboard-inset', `${keyboardInset}px`);
    document.body.classList.toggle('keyboard-open', keyboardOpen);
  });
}

function revealFocusedControl() {
  if (!activeFormControl()) return;
  window.setTimeout(() => {
    document.activeElement?.scrollIntoView?.({ block: 'center', inline: 'nearest', behavior: 'smooth' });
  }, 260);
}

window.visualViewport?.addEventListener('resize', syncNativeViewport);
window.visualViewport?.addEventListener('scroll', syncNativeViewport);
window.addEventListener('resize', syncNativeViewport);
window.addEventListener('orientationchange', () => {
  stableViewportHeight = 0;
  window.setTimeout(() => {
    stableViewportHeight = Math.max(window.innerHeight, window.visualViewport?.height || 0);
    syncNativeViewport();
  }, 350);
});
window.addEventListener('pageshow', () => {
  window.scrollTo(0, 0);
  syncNativeViewport();
});
document.addEventListener('focusin', (event) => {
  if (event.target instanceof HTMLElement && event.target.matches('input, textarea, select')) {
    syncNativeViewport();
    revealFocusedControl();
  }
});
document.addEventListener('focusout', () => window.setTimeout(syncNativeViewport, 220));
document.addEventListener('dragstart', (event) => event.preventDefault());
syncNativeViewport();

// iPhone-/PWA-Viewport sperren: vertikales Scrollen bleibt erhalten,
// Pinch-Zoom, Doppeltipp-Zoom und Trackpad-/Tastatur-Zoom werden verhindert.
const preventViewportScale = (event) => event.preventDefault();
['gesturestart', 'gesturechange', 'gestureend'].forEach((eventName) => {
  document.addEventListener(eventName, preventViewportScale, { passive: false });
});

document.addEventListener('touchmove', (event) => {
  if (event.touches.length > 1) event.preventDefault();
}, { passive: false });

let lastViewportTouchEnd = 0;
document.addEventListener('touchend', (event) => {
  const now = Date.now();
  if (now - lastViewportTouchEnd < 320) event.preventDefault();
  lastViewportTouchEnd = now;
}, { passive: false });

document.addEventListener('wheel', (event) => {
  if (event.ctrlKey || event.metaKey) event.preventDefault();
}, { passive: false });

window.addEventListener('keydown', (event) => {
  const zoomKey = ['+', '-', '=', '0'].includes(event.key);
  if (zoomKey && (event.ctrlKey || event.metaKey)) event.preventDefault();
});

window.addEventListener('online', flushOfflineQueue);

window.addEventListener('hashchange', () => {
  const tab = location.hash.slice(1);
  if (tabs.includes(tab)) { activeTab = tab; localStorage.setItem('selfmade-tab', tab); renderApp(); }
});

window.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') {
    if (dialogRoot.innerHTML) closeDialog();
    else if (storeMode.active) { storeMode.active = false; renderApp(); }
  }
});

matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
  if (data?.settings?.theme === 'system') applyTheme();
});

if ('serviceWorker' in navigator && location.protocol !== 'file:') {
  let reloadingForServiceWorker = false;
  const reloadForFreshApp = () => {
    if (reloadingForServiceWorker) return;
    reloadingForServiceWorker = true;
    location.reload();
  };
  navigator.serviceWorker.addEventListener('controllerchange', reloadForFreshApp);
  navigator.serviceWorker.addEventListener('message', (event) => {
    if (event.data?.type === 'SELFMADE_UPDATED' && Number(event.data.version) >= 14) reloadForFreshApp();
  });
  window.addEventListener('load', () => {
    const register = async () => {
      try {
        const registration = await navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });
        await registration.update();
      } catch {}
    };
    if ('requestIdleCallback' in window) requestIdleCallback(register, { timeout: 1800 });
    else setTimeout(register, 350);
  }, { once: true });
}


