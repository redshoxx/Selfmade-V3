  return `<div class="field"><label for="field-${name}">${label}</label><select class="select" id="field-${name}" name="${name}" autocomplete="off">${options.map((option) => `<option value="${escapeHtml(option)}" ${option === value ? 'selected' : ''}>${escapeHtml(option)}</option>`).join('')}</select></div>`;
}

function enhanceFormNavigation(root = document) {
  root.querySelectorAll('form').forEach((form) => {
    const controls = [...form.querySelectorAll('input:not([type="hidden"]):not([disabled]), select:not([disabled]), textarea:not([disabled])')];
    const textControls = controls.filter((control) => !['checkbox', 'radio', 'file'].includes(control.type));
    textControls.forEach((control, index) => {
      if (control instanceof HTMLTextAreaElement) return;
      control.enterKeyHint = index === textControls.length - 1 ? 'done' : 'next';
    });
  });
}

function beginFormSubmission(form) {
  form.classList.add('was-validated');
  if (!form.checkValidity()) {
    const invalid = form.querySelector(':invalid');
    invalid?.focus({ preventScroll: true });
    invalid?.scrollIntoView({ block: 'center', behavior: 'smooth' });
    form.reportValidity();
    return false;
  }
  if (form.dataset.submitting === 'true') return false;
  form.dataset.submitting = 'true';
  form.querySelectorAll('button[type="submit"], button:not([type])').forEach((button) => {
    button.dataset.wasDisabled = button.disabled ? '1' : '0';
    button.disabled = true;
  });
  return true;
}

function endFormSubmission(form) {
  if (!form?.isConnected) return;
  form.dataset.submitting = 'false';
  form.querySelectorAll('button[data-was-disabled]').forEach((button) => {
    button.disabled = button.dataset.wasDisabled === '1';
    delete button.dataset.wasDisabled;
  });
}

