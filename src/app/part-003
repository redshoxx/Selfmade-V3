        <div class="progress-track"><div class="progress-fill" style="width:${challengeRatio * 100}%"></div></div>
        <div class="challenge-meta">${data.challenge.completed_fields} von ${data.challenge.total_fields} Feldern</div>
      </button>
    </section>` : ''}
  </div>`;
}

