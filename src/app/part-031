const v20Profiles = Object.freeze({
  comfort: { label: 'Komfort', description: 'Größere Schrift und besonders klare Bedienflächen' },
  balanced: { label: 'Standard', description: 'Ausgewogene Darstellung für den Alltag' },
  compact: { label: 'Kompakt', description: 'Mehr Inhalt auf einmal, ohne Funktionen zu verstecken' }
});

let v20Profile = localStorage.getItem('haushaltklar-v20-profile');
if (!v20Profiles[v20Profile]) v20Profile = 'balanced';

function applyV20Experience() {
  document.documentElement.classList.add('haushaltklar-v20');
  document.documentElement.dataset.v20Profile = v20Profile;
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.dataset.theme === 'dark' ? '#11151a' : '#edf3f1');
}

applyV20Experience();

const applyThemeBeforeV20 = applyTheme;
applyTheme = function applyThemeV20() {
  applyThemeBeforeV20();
  applyV20Experience();
};

function v20ShoppingOpen() {
  return (data?.shopping || []).filter((item) => !item.checked);
}

function v20UrgentPantry() {
  return (data?.pantry || [])
    .filter((item) => !item.inbox && item.expiry_date && expiryInfo(item.expiry_date).days <= 3)
    .sort((a, b) => String(a.expiry_date).localeCompare(String(b.expiry_date)));
}

function v20LatestNotes() {
  return [...(data?.notes || [])]
    .sort((a, b) => String(b.updated_at || b.created_at || '').localeCompare(String(a.updated_at || a.created_at || '')))
    .slice(0, 2);
}

function v20TodayMeal() {
  const today = todayLocal();
  return (data?.meal_plan || []).find((entry) => entry.plan_date === today && mealRecipeV19(entry));
}

function v20FocusCard() {
  const urgent = v20UrgentPantry();
  const shopping = v20ShoppingOpen();
  const meal = v20TodayMeal();

  if (meal) {
    const recipe = mealRecipeV19(meal);
    return {
      eyebrow: 'Dein Plan für heute',
      title: recipe.name,
      text: `${meal.meal_type} · ${meal.servings || recipe.servings || 1} Portionen`,
      icon: 'chef',
      action: 'start-cooking-v19',
      id: recipe.id,
      cta: 'Kochmodus starten'
    };
  }
  if (urgent.length) {
    return {
      eyebrow: 'Lebensmittel retten',
      title: `${urgent[0].name} zuerst verwenden`,
      text: urgent.length > 1 ? `${urgent.length} Produkte sollten bald verbraucht werden.` : expiryInfo(urgent[0].expiry_date).label,
      icon: 'leaf',
      action: 'tab',
      tab: 'recipes',
      cta: 'Passende Rezepte'
    };
  }
  if (shopping.length) {
    return {
      eyebrow: 'Einkauf vorbereiten',
      title: `${shopping.length} ${shopping.length === 1 ? 'Produkt ist' : 'Produkte sind'} offen`,
      text: 'Liste prüfen und anschließend direkt in den Ladenmodus wechseln.',
      icon: 'cart',
      action: 'tab',
      tab: 'shopping',
      cta: 'Liste öffnen'
    };
  }
  return {
    eyebrow: 'Alles im grünen Bereich',
    title: 'Dein Haushalt ist organisiert',
    text: 'Nutze die Schnellaktion für Einkauf, Notiz, Ausgabe oder Rezept.',
    icon: 'sparkles',
    action: 'open-v20-quick',
    cta: 'Etwas hinzufügen'
  };
}

function v20FocusCardHtml() {
  const focus = v20FocusCard();
  const attributes = [
    `data-action="${focus.action}"`,
    focus.tab ? `data-tab="${focus.tab}"` : '',
    focus.id ? `data-id="${focus.id}"` : ''
  ].filter(Boolean).join(' ');
  return `<button class="v20-focus-card" ${attributes}>
    <span class="v20-focus-icon">${icon(focus.icon, 25)}</span>
    <span class="v20-focus-copy"><small>${escapeHtml(focus.eyebrow)}</small><strong>${escapeHtml(focus.title)}</strong><span>${escapeHtml(focus.text)}</span></span>
    <b>${escapeHtml(focus.cta)} ${icon('chevronRight', 15)}</b>
  </button>`;
}

function v20MoneyCard() {
  const income = Number(data?.summary?.income || 0);
  const expense = Number(data?.summary?.expense || 0);
  const remaining = Number(data?.summary?.remaining || 0);
  const ratio = income > 0 ? clamp(expense / income, 0, 1) : 0;
  const status = remaining >= 0 ? 'Noch verfügbar' : 'Über dem Monatsrahmen';
  return `<button class="v20-money-card" data-action="tab" data-tab="money">
    <span class="v20-card-kicker">${icon('wallet', 16)} Finanzen</span>
    <strong>${signedMoney(remaining)}</strong>
    <small>${status}</small>
    <span class="v20-progress"><i style="width:${Math.round(ratio * 100)}%"></i></span>
    <span class="v20-money-meta"><b>${money(expense)} ausgegeben</b><b>${money(data?.summary?.savings || 0)} gespart</b></span>
  </button>`;
}

function v20KitchenCard() {
  const recipes = data?.recipes || [];
  const urgent = v20UrgentPantry();
  const meal = v20TodayMeal();
  const recipe = meal ? mealRecipeV19(meal) : recipes.find((item) => item.favorite) || recipes[0];
  return `<button class="v20-kitchen-card" data-action="${recipe ? 'open-recipe-v19' : 'add-recipe-v19'}" ${recipe ? `data-id="${recipe.id}"` : ''}>
    <span class="v20-card-kicker">${icon('chef', 16)} Küche</span>
    <span class="v20-kitchen-visual">${recipe?.image_data_url ? `<img src="${escapeHtml(recipe.image_data_url)}" alt="">` : icon('utensils', 27)}</span>
    <span class="v20-kitchen-copy"><strong>${recipe ? escapeHtml(recipe.name) : 'Erstes Rezept anlegen'}</strong><small>${urgent.length ? `${urgent.length} bald fällige Zutaten berücksichtigen` : `${recipes.length} Rezepte gespeichert`}</small></span>
  </button>`;
}

function v20ActivityStrip() {
  const shopping = v20ShoppingOpen().length;
  const pantry = (data?.pantry || []).filter((item) => !item.inbox).length;
  const recipes = (data?.recipes || []).length;
  const notes = (data?.notes || []).length;
  return `<section class="v20-activity-strip" aria-label="Haushaltsstatus">
    <button data-action="tab" data-tab="shopping"><strong>${shopping}</strong><span>offen</span></button>
    <button data-action="tab" data-tab="pantry"><strong>${pantry}</strong><span>im Vorrat</span></button>
    <button data-action="tab" data-tab="recipes"><strong>${recipes}</strong><span>Rezepte</span></button>
    <button data-action="tab" data-tab="notes"><strong>${notes}</strong><span>Notizen</span></button>
  </section>`;
}

function v20NotesSection() {
  const notes = v20LatestNotes();
  return `<section class="v20-section">
    <div class="v20-section-head"><div><small>Festhalten</small><h2>Notizen & Ideen</h2></div><button data-action="add-note">${icon('plus', 16)} Neu</button></div>
    <div class="v20-note-grid">
      ${notes.length ? notes.map((note) => `<button class="v20-note-card" data-action="edit-note" data-id="${note.id}"><span>${icon('notes', 17)}</span><strong>${escapeHtml(note.title || 'Notiz')}</strong><small>${escapeHtml(String(note.content || note.text || '').slice(0, 90) || 'Antippen zum Bearbeiten')}</small></button>`).join('') : `<button class="v20-note-empty" data-action="add-note"><span>${icon('pen', 20)}</span><strong>Gedanken sofort notieren</strong><small>Listen, Ideen und Erinnerungen bleiben an einem Ort.</small></button>`}
    </div>
  </section>`;
}

header = function headerV20() {
  const titles = {
    money: ['Finanzen', 'Budgets, Sparziele und Buchungen'],
    shopping: ['Einkauf', `${v20ShoppingOpen().length} offene Einträge`],
    pantry: ['Vorrat', `${(data?.pantry || []).filter((item) => !item.inbox).length} Produkte im Haushalt`],
    recipes: ['Küche', 'Rezepte, Wochenplan und Kochmodus'],
    notes: ['Notizen', `${(data?.notes || []).length} gespeicherte Einträge`]
  };
  if (activeTab === 'start') {
    const name = displayNameV192();
    return `<header class="v20-header v20-home-header">
      <div class="v20-brand"><img src="/icon-192.png" alt=""><div><strong>HaushaltKlar</strong><span>${escapeHtml(data?.settings?.household_name || 'Mein Haushalt')}</span></div></div>
      <div class="v20-header-actions"><button data-action="global-search" aria-label="Suchen">${icon('search', 19)}</button><button data-action="open-v20-experience" aria-label="Darstellung anpassen">${icon('accessibility', 19)}</button><button data-action="settings" aria-label="Einstellungen">${icon('settings', 19)}</button></div>
      <div class="v20-greeting"><small>${escapeHtml(dateLabel())}</small><h1>${greetingV192()}${name ? `, ${escapeHtml(name)}` : ''}</h1><p>Was möchtest du heute erledigen?</p></div>
    </header>`;
  }
  const [title, subtitle] = titles[activeTab] || ['HaushaltKlar', 'Alles an einem Ort'];
  return `<header class="v20-header v20-page-header">
    <div><small>${escapeHtml(subtitle)}</small><h1>${escapeHtml(title)}</h1></div>
    <div class="v20-header-actions"><button data-action="global-search" aria-label="Suchen">${icon('search', 19)}</button><button data-action="open-v20-quick" aria-label="Schnell hinzufügen">${icon('plus', 20)}</button></div>
  </header>`;
};

