tabBar = function tabBarV20() {
  const tabData = [
    ['start', 'home', 'Heute', 0],
    ['money', 'wallet', 'Finanzen', 0],
    ['shopping', 'cart', 'Einkauf', data?.badges?.shopping || 0],
    ['pantry', 'pantry', 'Vorrat', data?.badges?.pantry || 0],
    ['recipes', 'recipes', 'Küche', 0],
    ['notes', 'notes', 'Notizen', 0]
