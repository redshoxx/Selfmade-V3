  return `<nav class="v20-tab-bar" aria-label="Hauptnavigation">
    ${tabData.map(([id, iconName, label, badge]) => `<button class="v20-tab ${activeTab === id ? 'active' : ''}" data-action="tab" data-tab="${id}"><span>${icon(iconName, 20)}${badge ? `<b>${badge}</b>` : ''}</span><small>${label}</small></button>`).join('')}
    <button class="v20-floating-add" data-action="open-v20-quick" aria-label="Schnell hinzufügen">${icon('plus', 23)}</button>
  </nav>`;
};

