function v20ProfileOptions() {
  return Object.entries(v20Profiles).map(([id, profile]) => `<button type="button" class="v20-profile-option ${v20Profile === id ? 'active' : ''}" data-action="v20-profile" data-profile="${id}"><span>${icon(id === 'comfort' ? 'accessibility' : id === 'compact' ? 'bolt' : 'sparkles', 19)}</span><div><strong>${profile.label}</strong><small>${profile.description}</small></div>${v20Profile === id ? icon('check', 18) : ''}</button>`).join('');
}

function openV20Experience() {
  openDialog('Darstellung', `<div class="v20-experience-dialog"><p>Die Darstellung wird nur auf diesem Gerät gespeichert.</p>${v20ProfileOptions()}</div>`, null);
}

function setV20Profile(profile) {
  if (!v20Profiles[profile]) return;
  v20Profile = profile;
  localStorage.setItem('haushaltklar-v20-profile', profile);
  applyV20Experience();
  closeDialog();
  renderApp(true);
  toast(`Darstellung: ${v20Profiles[profile].label}`);
}

function v20SwitchTab(tab, followUpAction = '') {
  if (tabs.includes(tab)) {
    activeTab = tab;
    localStorage.setItem('selfmade-tab', activeTab);
  }
  closeDialog();
  renderApp(true);
  if (followUpAction) queueMicrotask(() => shell.querySelector(`[data-action="${followUpAction}"]`)?.click());
}

function launchV20Target(target) {
  if (target === 'shopping') return v20SwitchTab('shopping', 'open-shopping-add-v17');
  if (target === 'note') return v20SwitchTab('notes', 'add-note');
  if (target === 'money') return v20SwitchTab('money', 'add-transaction');
  if (target === 'recipe') return v20SwitchTab('recipes', 'add-recipe-v19');
  if (target === 'scan') { closeDialog(); openBarcodeScanner(); return; }
  if (target === 'receipt') return v20SwitchTab('money', 'import-receipt');
}

const openSettingsBeforeV20 = openSettings;
openSettings = function openSettingsV20() {
  openSettingsBeforeV20();
  if (dialogRoot.querySelector('.v20-settings-card')) return;
  const anchor = dialogRoot.querySelector('.rights-card-v193') || dialogRoot.querySelector('.section-title-row');
  const html = `<section class="v20-settings-card"><div><span>${icon('accessibility', 19)}</span><div><strong>Bedienung & Darstellung</strong><small>Aktuell: ${v20Profiles[v20Profile].label}</small></div></div><button type="button" data-action="open-v20-experience">Anpassen</button></section>`;
  if (anchor) anchor.insertAdjacentHTML('beforebegin', html);
};

shell.addEventListener('click', (event) => {
  const target = event.target.closest('[data-action]');
  if (!target) return;
  if (target.dataset.action === 'open-v20-quick') openV20QuickActions();
  else if (target.dataset.action === 'open-v20-experience') openV20Experience();
});

dialogRoot.addEventListener('click', (event) => {
  const target = event.target.closest('[data-action]');
  if (!target) return;
  if (target.dataset.action === 'v20-profile') setV20Profile(target.dataset.profile);
  else if (target.dataset.action === 'v20-launch') launchV20Target(target.dataset.target);
  else if (target.dataset.action === 'open-v20-experience') openV20Experience();
});

window.addEventListener('storage', (event) => {
  if (event.key !== 'haushaltklar-v20-profile') return;
  if (v20Profiles[event.newValue]) v20Profile = event.newValue;
  applyV20Experience();
  renderApp(true);
});
