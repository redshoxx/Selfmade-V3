
function renderRecipesAreaV19() {
  return `<div class="content-stack recipes-area-v19">
    <div class="segmented recipes-mode-v19">
      <button class="${recipesModeV19 === 'recipes' ? 'active' : ''}" data-action="recipes-mode-v19" data-mode="recipes">Rezepte</button>
      <button class="${recipesModeV19 === 'planner' ? 'active' : ''}" data-action="recipes-mode-v19" data-mode="planner">Wochenplan</button>
    </div>
    ${recipesModeV19 === 'planner' ? renderMealPlannerV19() : renderRecipeLibraryV19()}
  </div>`;
}

function recipeCategoriesPresentV19() {
  return [...new Set((data.recipes || []).map((recipe) => recipe.category).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'de'));
}

function filteredRecipesV19() {
  const query = normalizeFoodV19(recipeSearchV19);
  return (data.recipes || []).filter((recipe) => {
    if (recipeFavoritesOnlyV19 && !recipe.favorite) return false;
    if (recipeCategoryV19 !== 'Alle' && recipe.category !== recipeCategoryV19) return false;
    if (!query) return true;
    const haystack = normalizeFoodV19(`${recipe.name} ${recipe.description} ${(recipe.ingredients || []).map((item) => item.name).join(' ')}`);
    return haystack.includes(query);
  });
}

function expiringPantryV19() {
  return (data.pantry || []).filter((item) => !item.inbox && item.expiry_date && expiryInfo(item.expiry_date).days <= 5).slice(0, 6);
}

function recipeCardV19(recipe) {
  const missing = recipeMissingCountV19(recipe);
  return `<article class="recipe-card-v19" data-action="open-recipe-v19" data-id="${recipe.id}" tabindex="0">
    <div class="recipe-image-v19">${recipe.image_data_url ? `<img src="${escapeHtml(recipe.image_data_url)}" alt="">` : `<span>${icon('utensils', 28)}</span>`}<button class="recipe-favorite-v19 ${recipe.favorite ? 'active' : ''}" data-action="toggle-recipe-favorite-v19" data-id="${recipe.id}" aria-label="Favorit">${icon('star', 16, recipe.favorite)}</button></div>
    <div class="recipe-card-body-v19">
      <div class="recipe-card-kicker-v19"><span>${escapeHtml(recipe.category || 'Sonstiges')}</span><span>${escapeHtml(recipe.difficulty || 'Einfach')}</span></div>
      <h2>${escapeHtml(recipe.name)}</h2>
      <div class="recipe-card-meta-v19"><span>${icon('clock', 13)} ${escapeHtml(recipeTimeLabelV19(recipe))}</span><span>${recipe.servings} Portionen</span>${missing ? `<span class="missing">${missing} fehlen</span>` : `<span class="ready">Vorrat passt</span>`}</div>
    </div>
  </article>`;
}

function renderRecipeLibraryV19() {
  const recipes = filteredRecipesV19();
  const expiring = expiringPantryV19();
  return `<div class="recipe-library-v19">
    <div class="recipe-search-v19">${icon('search', 17)}<input id="recipe-search-v19" class="input" value="${escapeHtml(recipeSearchV19)}" placeholder="Nach Rezept oder Zutat suchen" autocomplete="off"><button class="recipe-filter-star-v19 ${recipeFavoritesOnlyV19 ? 'active' : ''}" data-action="recipe-favorites-v19" aria-label="Nur Favoriten">${icon('star', 17, recipeFavoritesOnlyV19)}</button></div>
    <div class="recipe-category-strip-v19"><button class="${recipeCategoryV19 === 'Alle' ? 'active' : ''}" data-action="recipe-category-v19" data-category="Alle">Alle</button>${recipeCategoriesPresentV19().map((category) => `<button class="${recipeCategoryV19 === category ? 'active' : ''}" data-action="recipe-category-v19" data-category="${escapeHtml(category)}">${escapeHtml(category)}</button>`).join('')}</div>
    ${expiring.length ? `<section class="use-soon-v19"><div><strong>Bald verwenden</strong><span>Diese Vorräte laufen zuerst ab</span></div><div class="use-soon-chips-v19">${expiring.map((item) => `<button data-action="recipe-search-expiring-v19" data-name="${escapeHtml(item.name)}">${emojiForItem(item)} ${escapeHtml(item.name)} · ${escapeHtml(expiryInfo(item.expiry_date).label)}</button>`).join('')}</div></section>` : ''}
    ${recipes.length ? `<div class="recipe-grid-v19">${recipes.map(recipeCardV19).join('')}</div>` : `<div class="card empty-state recipe-empty-v19"><div class="empty-icon">${icon('recipes', 25)}</div><strong>${data.recipes?.length ? 'Keine passenden Rezepte' : 'Noch keine Rezepte'}</strong><span>${data.recipes?.length ? 'Passe Suche oder Filter an.' : 'Lege dein erstes persönliches Rezept an.'}</span><button class="btn btn-primary" data-action="add-recipe-v19">Rezept anlegen</button></div>`}
  </div>`;
}

function recipeDetailHtmlV19(recipe, servings = recipe.servings) {
  const scaled = (recipe.ingredients || []).map((item) => scaledIngredientV19(item, servings, recipe.servings));
  return `<div class="recipe-detail-v19" data-recipe-id="${recipe.id}" data-servings="${servings}">
    <div class="recipe-detail-hero-v19">${recipe.image_data_url ? `<img src="${escapeHtml(recipe.image_data_url)}" alt="${escapeHtml(recipe.name)}">` : `<div>${icon('utensils', 38)}</div>`}</div>
    <div class="recipe-detail-title-v19"><div><span>${escapeHtml(recipe.category || 'Sonstiges')} · ${escapeHtml(recipe.difficulty || 'Einfach')}</span><h2>${escapeHtml(recipe.name)}</h2></div><button class="recipe-favorite-v19 ${recipe.favorite ? 'active' : ''}" data-action="toggle-recipe-favorite-v19" data-id="${recipe.id}">${icon('star', 18, recipe.favorite)}</button></div>
    ${recipe.description ? `<p class="recipe-description-v19">${escapeHtml(recipe.description)}</p>` : ''}
    <div class="recipe-facts-v19"><span>${icon('clock', 16)}<strong>${recipe.prep_minutes || 0} Min.</strong><small>Zubereitung</small></span><span>${icon('timer', 16)}<strong>${recipe.total_minutes || recipe.prep_minutes || 0} Min.</strong><small>Gesamt</small></span><span>${icon('star', 16, recipe.rating > 0)}<strong>${recipe.rating ? `${recipe.rating}/5` : '–'}</strong><small>Bewertung</small></span></div>
    <div class="portion-control-v19"><div><strong>Portionen</strong><span>Mengen werden automatisch angepasst</span></div><div><button data-action="recipe-portions-v19" data-delta="-1">−</button><strong id="recipe-portions-value-v19">${servings}</strong><button data-action="recipe-portions-v19" data-delta="1">+</button></div></div>
    <section class="recipe-section-v19"><div class="recipe-section-title-v19"><h3>Zutaten</h3><span>${scaled.length}</span></div><div class="recipe-ingredient-list-v19">${scaled.map((ingredient) => { const pantry = pantryMatchV19(ingredient.name); return `<div><span class="ingredient-check-v19 ${pantry.length ? 'available' : ''}">${pantry.length ? icon('check', 12) : ''}</span><span><strong>${escapeHtml(ingredient.name)}</strong>${ingredient.alternative ? `<small>Alternative: ${escapeHtml(ingredient.alternative)}</small>` : ''}</span><b>${formatAmountV19(ingredient.amount)} ${escapeHtml(ingredient.unit || '')}</b></div>`; }).join('')}</div></section>
    <section class="recipe-section-v19"><div class="recipe-section-title-v19"><h3>Zubereitung</h3><span>${(recipe.steps || []).length}</span></div><div class="recipe-step-preview-v19">${(recipe.steps || []).map((step, index) => `<div><i>${index + 1}</i><span><strong>${escapeHtml(step.title || `Schritt ${index + 1}`)}</strong><small>${escapeHtml(step.text || '')}</small></span></div>`).join('')}</div></section>
    ${recipe.notes ? `<section class="recipe-note-v19"><strong>Persönliche Notiz</strong><p>${escapeHtml(recipe.notes)}</p></section>` : ''}
    ${recipe.source_name ? `<section class="recipe-source-v191"><div><strong>Quelle: ${escapeHtml(recipe.source_name)}</strong><span>Für den persönlichen Gebrauch importiert und vor dem Speichern geprüft.</span></div>${recipe.source_url ? `<code>${escapeHtml(recipe.source_url)}</code>` : ''}</section>` : ''}
    <div class="recipe-detail-actions-v19"><button class="btn btn-secondary" data-action="recipe-shopping-preview-v19" data-id="${recipe.id}">${icon('cart', 16)} Zutaten einkaufen</button><button class="btn btn-primary" data-action="start-cooking-v19" data-id="${recipe.id}">${icon('chef', 16)} Kochmodus starten</button></div>
    <div class="recipe-detail-secondary-v19"><button data-action="plan-recipe-v19" data-id="${recipe.id}">${icon('calendar', 15)} Einplanen</button><button data-action="edit-recipe-v19" data-id="${recipe.id}">${icon('edit', 15)} Bearbeiten</button><button class="danger" data-action="delete-recipe-v19" data-id="${recipe.id}">${icon('trash', 15)} Löschen</button></div>
  </div>`;
}

function openRecipeDetailV19(recipe, servings = recipe.servings) {
  openDialog(recipe.name, recipeDetailHtmlV19(recipe, servings));
  dialogRoot.querySelector('.dialog')?.classList.add('recipe-detail-dialog-v19');
}
