
/* Version 15 – iPhone-12 Scanner-Fallbacks und vollständig stille Cloud-Synchronisierung */
ensureZxingLibrary = async function ensureZxingLibraryV15() {
  if (window.ZXingBrowser?.BrowserMultiFormatReader) return window.ZXingBrowser;

  const sources = [
    'https://unpkg.com/@zxing/browser@0.2.1',
    'https://cdn.jsdelivr.net/npm/@zxing/browser@0.2.1/umd/zxing-browser.min.js'
  ];
  const initial = document.querySelector('#zxing-browser-library');

  async function waitForScript(script) {
    if (window.ZXingBrowser?.BrowserMultiFormatReader) return;
    if (script?.dataset.ready === '1') return;
    await new Promise((resolve, reject) => {
      const timeout = setTimeout(() => reject(new Error('scanner_library_unavailable')), 10000);
      const loaded = () => { clearTimeout(timeout); script.dataset.ready = '1'; resolve(); };
      const failed = () => { clearTimeout(timeout); script.dataset.failed = '1'; reject(new Error('scanner_library_unavailable')); };
      script.addEventListener('load', loaded, { once: true });
      script.addEventListener('error', failed, { once: true });
    });
  }

  if (initial && initial.dataset.failed !== '1') {
    try { await waitForScript(initial); } catch {}
    if (window.ZXingBrowser?.BrowserMultiFormatReader) return window.ZXingBrowser;
  }

  for (const src of sources) {
    const existing = [...document.scripts].find((script) => script.src === src);
    const script = existing || Object.assign(document.createElement('script'), {
      src,
      async: true,
      crossOrigin: 'anonymous'
    });
    script.id = 'zxing-browser-library';
    if (!existing) document.head.append(script);
    try { await waitForScript(script); } catch { script.remove(); continue; }
    if (window.ZXingBrowser?.BrowserMultiFormatReader) return window.ZXingBrowser;
  }

  throw new Error('scanner_library_unavailable');
};

toast = function toastV15(message, type = '', actionLabel = '', actionFn = null) {
  const normalizedMessage = String(message || '')
    .toLocaleLowerCase('de-AT')
    .replace(/[–—]/g, '-')
    .replace(/\s+/g, ' ')
    .trim();
  const silentCloudMessages = [
    'cloud-daten aktualisiert',
    'cloud daten aktualisiert',
    'cloud-daten synchronisiert',
    'cloud daten synchronisiert',
    'offline-änderungen synchronisiert',
    'offline änderungen synchronisiert',
    'supabase-synchronisierung abgeschlossen'
  ];
  if (silentCloudMessages.some((text) => normalizedMessage.includes(text))) return;

  if (!actionFn) {
    [...toastRoot.querySelectorAll('.toast:not([data-has-action="true"])')].forEach((item) => item.remove());
  }

  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.dataset.hasAction = actionFn ? 'true' : 'false';
  const id = actionFn ? `toast-${Date.now()}-${Math.random().toString(16).slice(2)}` : '';
  if (actionFn) toastActions.set(id, actionFn);
  el.innerHTML = `<span>${escapeHtml(message)}</span>${actionFn ? `<button data-toast-action="${id}">${escapeHtml(actionLabel)}</button>` : ''}`;
  toastRoot.prepend(el);

  const duration = actionFn ? 4200 : (type === 'error' ? 2800 : 1800);
  setTimeout(() => {
    toastActions.delete(id);
    el.animate(
      [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-8px)' }],
      { duration: 150, easing: 'ease-in', fill: 'forwards' }
    ).finished.finally(() => el.remove());
  }, duration);
};
