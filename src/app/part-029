finishCookTimerV19 = function finishCookTimerV192(timer) {
  timer.remaining = 0;
  timer.running = false;
  timerSignalV19();
  if ('Notification' in window && Notification.permission === 'granted') {
    new Notification('HaushaltKlar Küchentimer', { body: `${timer.label} ist fertig.`, icon: '/icon-192.png' });
  }
  toast(`${timer.label}: Timer abgelaufen`, 'error');
};
