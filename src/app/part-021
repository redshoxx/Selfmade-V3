function recipeByIdV19(id) { return (data?.recipes || []).find((item) => Number(item.id) === Number(id)); }
function mealRecipeV19(entry) { return recipeByIdV19(entry?.recipe_id); }
function padV19(value) { return String(value).padStart(2, '0'); }
function dateIsoV19(date) {
  const d = new Date(date);
  d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
  return d.toISOString().slice(0, 10);
}
function shiftIsoV19(value, days) {
  const d = new Date(`${value}T12:00:00`);
  d.setDate(d.getDate() + days);
  return dateIsoV19(d);
}
function weekDatesV19(start = mealWeekStartV19) { return Array.from({ length: 7 }, (_, index) => shiftIsoV19(start, index)); }
function shortDayV19(value) { return new Intl.DateTimeFormat('de-AT', { weekday: 'short', day: 'numeric', month: 'numeric' }).format(new Date(`${value}T12:00:00`)); }
function weekLabelV19() {
  const dates = weekDatesV19();
  return `${new Intl.DateTimeFormat('de-AT', { day: 'numeric', month: 'short' }).format(new Date(`${dates[0]}T12:00:00`))} – ${new Intl.DateTimeFormat('de-AT', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(`${dates[6]}T12:00:00`))}`;
}
function scaledIngredientV19(ingredient, servings, recipeServings) {
  const factor = Math.max(1, Number(servings || 1)) / Math.max(1, Number(recipeServings || 1));
  return { ...ingredient, amount: Number((Number(ingredient.amount || 0) * factor).toFixed(2)) };
}
function formatAmountV19(amount) {
  const value = Number(amount || 0);
  return Number.isInteger(value) ? String(value) : String(Number(value.toFixed(2))).replace('.', ',');
}
function normalizeFoodV19(value) {
  return String(value || '').toLocaleLowerCase('de-AT').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9äöüß]+/g, ' ').trim();
}
function pantryMatchV19(name) {
  const key = normalizeFoodV19(name);
  return (data?.pantry || []).filter((item) => {
    const itemKey = normalizeFoodV19(item.name);
    return itemKey && (itemKey === key || itemKey.includes(key) || key.includes(itemKey));
  });
}
function recipeMissingCountV19(recipe, servings = recipe.servings) {
  return (recipe.ingredients || []).filter((ingredient) => {
    const scaled = scaledIngredientV19(ingredient, servings, recipe.servings);
    return scaled.amount > 0 && !pantryMatchV19(ingredient.name).length;
  }).length;
}
function recipeTimeLabelV19(recipe) {
  const total = Number(recipe.total_minutes || recipe.prep_minutes || 0);
  if (!total) return 'Zeit offen';
  if (total < 60) return `${total} Min.`;
  return `${Math.floor(total / 60)} Std. ${total % 60 ? `${total % 60} Min.` : ''}`.trim();
}

