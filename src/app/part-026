  else if (action === 'recipe-search-expiring-v19') { recipeSearchV19 = target.dataset.name || ''; renderApp(true); queueMicrotask(() => shell.querySelector('#recipe-search-v19')?.focus()); }
  else if (action === 'open-recipe-v19') { event.stopPropagation(); const recipe = recipeByIdV19(target.dataset.id); if (recipe) openRecipeDetailV19(recipe); }
  else if (action === 'toggle-recipe-favorite-v19') { event.stopPropagation(); const recipe = recipeByIdV19(target.dataset.id); if (recipe) await mutate(() => api(`/api/recipes/${recipe.id}`, { method: 'PATCH', body: JSON.stringify({ favorite: !recipe.favorite }) })); }
  else if (action === 'meal-week-v19') { mealWeekStartV19 = shiftIsoV19(mealWeekStartV19, Number(target.dataset.delta || 0)); localStorage.setItem('selfmade-meal-week-v19', mealWeekStartV19); renderApp(true); }
  else if (action === 'add-meal-v19') openMealPickerV19(target.dataset.date || todayLocal(), target.dataset.mealType || 'Abendessen');
  else if (action === 'planned-meal-menu-v19') { const entry = (data.meal_plan || []).find((item) => Number(item.id) === Number(target.dataset.id)); if (entry) openPlannedMealMenuV19(entry); }
  else if (action === 'copy-previous-week-v19') await mutate(() => api('/api/meal-plan/copy', { method: 'POST', body: JSON.stringify({ from_start: shiftIsoV19(mealWeekStartV19, -7), to_start: mealWeekStartV19 }) }), 'Vorwoche übernommen');
  else if (action === 'planner-expiry-recipes-v19') { recipesModeV19 = 'recipes'; recipeSearchV19 = expiringPantryV19()[0]?.name || ''; renderApp(true); }
  else if (action === 'cooking-view-v19') { cookingModeV19.view = target.dataset.view; renderApp(true); }
  else if (action === 'cooking-prev-v19') cookingPrevV19();
  else if (action === 'cooking-next-v19') cookingNextV19();
  else if (action === 'exit-cooking-v19') await exitCookingV19();
  else if (action === 'toggle-voice-v19') toggleVoiceControlV19();
  else if (action === 'toggle-temperature-v19') { cookingModeV19.temperatureUnit = cookingModeV19.temperatureUnit === 'C' ? 'F' : 'C'; renderApp(true); }
  else if (action === 'cooking-portions-v19') { cookingModeV19.servings = Math.max(1, Math.min(50, cookingModeV19.servings + Number(target.dataset.delta || 0))); renderApp(true); }
  else if (action === 'toggle-cook-ingredient-v19') { const index = Number(target.dataset.index); if (cookingModeV19.usedIngredients.has(index)) cookingModeV19.usedIngredients.delete(index); else cookingModeV19.usedIngredients.add(index); renderApp(true); }
  else if (action === 'cooking-missing-shopping-v19') { const recipe = cookingRecipeV19(); if (recipe) { cookingModeV19.view = 'ingredients'; await mutate(() => api(`/api/recipes/${recipe.id}/shopping`, { method: 'POST', body: JSON.stringify({ servings: cookingModeV19.servings, consider_pantry: true }) }), 'Fehlende Zutaten hinzugefügt'); cookingModeV19.active = true; renderApp(true); } }
  else if (action === 'custom-cook-timer-v19') openDialog('Küchentimer', `${field('Bezeichnung', 'timer_label', '', 'text', 'required maxlength="60" autofocus')}<div class="form-row">${field('Minuten', 'timer_minutes', '5', 'number', 'min="0" max="1440" step="1" required')}${field('Sekunden', 'timer_seconds', '0', 'number', 'min="0" max="59" step="1"')}</div><div class="dialog-actions"><button type="button" class="btn btn-secondary" data-action="close-dialog">Abbrechen</button><button class="btn btn-primary">Timer starten</button></div>`, 'custom-timer-v19');
  else if (action === 'start-cook-timer-v19') startCookTimerV19(Number(target.dataset.seconds), target.dataset.label);
  else if (action === 'pause-cook-timer-v19') { const timer = cookingTimersV19.get(target.dataset.id); if (timer) { timer.running = !timer.running; timer.lastTick = Date.now(); updateCookingTimersV19(); } }
  else if (action === 'extend-cook-timer-v19') { const timer = cookingTimersV19.get(target.dataset.id); if (timer) { timer.remaining += 60; timer.duration += 60; timer.lastTick = Date.now(); timer.running = true; updateCookingTimersV19(); } }
  else if (action === 'cancel-cook-timer-v19') { cookingTimersV19.delete(target.dataset.id); updateCookingTimersV19(); }
});

