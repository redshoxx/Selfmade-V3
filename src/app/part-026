dialogRoot.addEventListener('submit', async (event) => {
  const form = event.target.closest('form[data-form]'); if (!form) return;
  const kind = form.dataset.form;
  if (!['recipe-v19','recipe-shopping-v19','plan-recipe-v19','custom-timer-v19'].includes(kind)) return;
  event.preventDefault(); event.stopImmediatePropagation();
  if (kind === 'custom-timer-v19') { const fd = new FormData(form); const seconds = Number(fd.get('timer_minutes') || 0) * 60 + Number(fd.get('timer_seconds') || 0); if (seconds <= 0) { toast('Die Timerdauer muss größer als 0 sein.', 'error'); return; } const label = String(fd.get('timer_label') || 'Küchentimer'); closeDialog(); startCookTimerV19(seconds, label); return; }
  if (kind === 'recipe-v19') {
    const payload = collectRecipeEditorV19(form); const id = new FormData(form).get('id');
    if (!payload.ingredients.length || !payload.steps.length) { toast('Mindestens eine Zutat und ein Arbeitsschritt sind erforderlich.', 'error'); return; }
    await mutate(() => id ? api(`/api/recipes/${id}`, { method: 'PATCH', body: JSON.stringify(payload) }) : api('/api/recipes', { method: 'POST', body: JSON.stringify(payload) }), 'Rezept gespeichert');
  } else if (kind === 'recipe-shopping-v19') {
    const fd = new FormData(form); const recipe = recipeByIdV19(fd.get('recipe_id')); if (!recipe) return;
    const selected = new Set(fd.getAll('ingredient_selected').map(Number));
    const ingredients = (recipe.ingredients || []).map((item, index) => ({ ...item, amount: Number(fd.get(`ingredient_amount_${index}`) || 0), unit: fd.get(`ingredient_unit_${index}`), selected: selected.has(index) }));
    const result = await api(`/api/recipes/${recipe.id}/shopping`, { method: 'POST', body: JSON.stringify({ servings: Number(fd.get('servings')), consider_pantry: fd.has('consider_pantry'), ingredients }) });
    data = result.state; closeDialog(); activeTab = 'shopping'; localStorage.setItem('selfmade-tab', activeTab); renderApp(true); toast(`${result.added_count} Zutaten hinzugefügt`);
  } else if (kind === 'plan-recipe-v19') {
    const fd = new FormData(form); await mutate(() => api('/api/meal-plan', { method: 'POST', body: JSON.stringify(Object.fromEntries(fd)) }), 'Rezept eingeplant');
  }
}, true);

