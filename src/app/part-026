
function updateRecipeEditorIndexesV19() {
  [...dialogRoot.querySelectorAll('.recipe-step-editor-v19')].forEach((row, index) => {
    row.dataset.index = index;
    const badge = row.querySelector('.recipe-step-number-v19');
    if (badge) badge.textContent = index + 1;
  });
}

function startCookTimerV19(seconds, label = 'Küchentimer') {
  const id = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
  cookingTimersV19.set(id, { id, label: label || 'Küchentimer', duration: seconds, remaining: seconds, running: true, lastTick: Date.now() });
  if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission().catch(() => {});
  if (!cookingTimerTickerV19) cookingTimerTickerV19 = setInterval(tickCookingTimersV19, 500);
  renderApp(true);
}

function tickCookingTimersV19() {
  const now = Date.now();
  let changed = false;
  for (const timer of cookingTimersV19.values()) {
    if (!timer.running) continue;
    const elapsed = (now - timer.lastTick) / 1000;
    timer.lastTick = now;
    timer.remaining -= elapsed;
    changed = true;
    if (timer.remaining <= 0) finishCookTimerV19(timer);
  }
  if (changed) updateCookingTimersV19();
  if (!cookingTimersV19.size) { clearInterval(cookingTimerTickerV19); cookingTimerTickerV19 = 0; }
}

function updateCookingTimersV19() {
  const target = shell.querySelector('#active-timers-v19');
  if (target) target.innerHTML = renderActiveTimersV19();
  else if (cookingTimersV19.size && cookingModeV19?.active) renderApp(true);
}

function timerSignalV19() {
  try {
    const context = new (window.AudioContext || window.webkitAudioContext)();
    [0, .28, .56].forEach((delay) => {
      const oscillator = context.createOscillator();
      const gain = context.createGain();
      oscillator.frequency.value = 880;
      gain.gain.setValueAtTime(.0001, context.currentTime + delay);
      gain.gain.exponentialRampToValueAtTime(.22, context.currentTime + delay + .02);
      gain.gain.exponentialRampToValueAtTime(.0001, context.currentTime + delay + .22);
      oscillator.connect(gain).connect(context.destination);
      oscillator.start(context.currentTime + delay);
      oscillator.stop(context.currentTime + delay + .24);
    });
  } catch {}
  navigator.vibrate?.([250, 120, 250, 120, 400]);
}

function finishCookTimerV19(timer) {
  timer.remaining = 0;
  timer.running = false;
  timerSignalV19();
  if ('Notification' in window && Notification.permission === 'granted') new Notification('Selfmade Küchentimer', { body: `${timer.label} ist fertig.`, icon: '/icon-192.png' });
  toast(`${timer.label}: Timer abgelaufen`, 'error');
}

function toggleVoiceControlV19() {
  if (cookingVoiceEnabledV19) { stopVoiceControlV19(); renderApp(true); return; }
  const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!Recognition) { toast('Sprachsteuerung wird auf diesem Gerät nicht unterstützt.', 'error'); return; }
  try {
    const recognition = new Recognition();
    recognition.lang = 'de-AT';
    recognition.continuous = true;
    recognition.interimResults = false;
    recognition.onresult = (event) => {
      const transcript = [...event.results].slice(event.resultIndex).map((result) => result[0].transcript).join(' ').toLocaleLowerCase('de-AT');
      if (/\bweiter\b|\bnächster schritt\b/.test(transcript)) cookingNextV19();
      else if (/\bzurück\b|\bvorheriger schritt\b/.test(transcript)) cookingPrevV19();
      else if (/timer starten/.test(transcript)) {
        const step = cookingRecipeV19()?.steps?.[cookingModeV19.stepIndex];
        const timer = stepTimersV19(step?.text)[0];
        if (timer) startCookTimerV19(timer.seconds, timer.label);
        else toast('In diesem Schritt wurde keine Zeit erkannt.', 'error');
      }
    };
    recognition.onerror = () => { cookingVoiceEnabledV19 = false; };
    recognition.onend = () => { if (cookingVoiceEnabledV19) try { recognition.start(); } catch {} };
    recognition.start();
    cookingRecognitionV19 = recognition;
    cookingVoiceEnabledV19 = true;
    renderApp(true);
  } catch { toast('Mikrofon konnte nicht aktiviert werden.', 'error'); }
}

function stopVoiceControlV19() {
  cookingVoiceEnabledV19 = false;
  try { cookingRecognitionV19?.stop(); } catch {}
  cookingRecognitionV19 = null;
}
function cookingPrevV19() { if (!cookingModeV19) return; cookingModeV19.stepIndex = Math.max(0, cookingModeV19.stepIndex - 1); cookingModeV19.view = 'steps'; renderApp(true); }
function cookingNextV19() {
  if (!cookingModeV19) return;
  const steps = cookingRecipeV19()?.steps || [];
  if (cookingModeV19.stepIndex >= steps.length - 1) cookingModeV19.completion = true;
  else cookingModeV19.stepIndex += 1;
  cookingModeV19.view = 'steps';
  renderApp(true);
}

