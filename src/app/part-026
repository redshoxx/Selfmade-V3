shell.addEventListener('touchstart', (event) => {
  if (!cookingModeV19 || !event.target.closest('#cook-swipe-area-v19')) return;
  const touch = event.touches[0];
  cookingTouchStartV19 = { x: touch.clientX, y: touch.clientY };
}, { passive: true });
shell.addEventListener('touchend', (event) => {
  if (!cookingTouchStartV19 || !cookingModeV19) return;
  const touch = event.changedTouches[0];
  const dx = touch.clientX - cookingTouchStartV19.x;
  const dy = touch.clientY - cookingTouchStartV19.y;
  cookingTouchStartV19 = null;
  if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.3) return;
  dx < 0 ? cookingNextV19() : cookingPrevV19();
}, { passive: true });

