
/* Version 20 – kontextbezogene Kopfaktionen */
.v20-page-header-context{grid-template-columns:minmax(0,1fr) auto;align-items:end}
.v20-page-copy{min-width:0;display:grid;gap:3px}
.v20-context-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px}
.v20-context-icon,.v20-context-primary,.v20-month-switcher button{min-width:39px;height:39px;padding:0;border:1px solid var(--v20-line);border-radius:13px;display:grid;place-items:center;color:var(--v20-text);background:var(--v20-card);box-shadow:0 7px 18px rgba(34,59,53,.06)}
.v20-context-primary{width:auto;min-width:78px;padding:0 11px;display:flex;align-items:center;justify-content:center;gap:5px;border-color:transparent;color:#fff;background:linear-gradient(145deg,var(--v20-primary),var(--v20-primary-strong));font-size:9px;font-weight:820;white-space:nowrap}
.v20-month-switcher{height:39px;padding:0 3px;border:1px solid var(--v20-line);border-radius:13px;display:grid;grid-template-columns:29px minmax(45px,auto) 29px;align-items:center;background:var(--v20-card);box-shadow:0 7px 18px rgba(34,59,53,.06)}
.v20-month-switcher button{min-width:29px;width:29px;height:31px;border:0;border-radius:10px;background:transparent;box-shadow:none}
.v20-month-switcher strong{padding:0 3px;font-size:9px;text-align:center;white-space:nowrap}
[data-v20-profile="comfort"] .v20-context-icon,[data-v20-profile="comfort"] .v20-context-primary{height:46px;min-width:46px}
[data-v20-profile="comfort"] .v20-context-primary{min-width:92px;font-size:11px}
[data-v20-profile="comfort"] .v20-month-switcher{height:46px}
@media(max-width:389px){.v20-page-header-context{grid-template-columns:minmax(0,1fr) auto}.v20-page-copy small{max-width:150px}.v20-context-actions{gap:5px}.v20-context-icon{min-width:36px;width:36px;height:36px}.v20-context-primary{min-width:68px;height:36px;padding-inline:8px}.v20-month-switcher{height:36px;grid-template-columns:25px minmax(38px,auto) 25px}.v20-month-switcher button{min-width:25px;width:25px}.v20-month-switcher strong{font-size:8px}}
@media(max-width:349px){.v20-page-copy small{display:none}.v20-context-actions>.v20-context-icon:first-child{display:none}}
