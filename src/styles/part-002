  position: relative;
  z-index: 6;
  height: 64px;
  padding: 4px 7px var(--safe-bottom);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  background: color-mix(in srgb, var(--card) 95%, transparent);
  border-top: 1px solid var(--line);
  backdrop-filter: blur(18px);
}
.tab-button {
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--muted);
  border-radius: 11px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  font-size: 8px;
  font-weight: 750;
}
.tab-button.active { color: var(--accent); background: var(--accent-soft); }
.tab-icon { position: relative; line-height: 0; }
.tab-badge {
  position: absolute;
  top: -5px;
  right: -9px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  background: var(--accent);
  color: #fff;
  box-shadow: 0 0 0 2px var(--card);
  font-size: 8px;
  font-weight: 850;
  line-height: 1;
}
.tab-button:nth-child(4) .tab-badge { background: var(--red); }

.field { display: grid; gap: 6px; }
.field label { color: var(--muted); font-size: 10px; font-weight: 800; }
.input, .select, .textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: var(--card);
  color: var(--text);
  padding: 0 12px;
  min-height: 42px;
  font-size: 13px;
}
.textarea { min-height: 118px; padding-top: 11px; resize: vertical; line-height: 1.45; }
.input::placeholder, .textarea::placeholder { color: var(--faint); }
.form-grid { display: grid; gap: 12px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.checkbox-row { min-height: 42px; display: flex; align-items: center; gap: 9px; }
.checkbox-row input { accent-color: var(--accent); width: 18px; height: 18px; }
.color-picker { display: flex; gap: 9px; flex-wrap: wrap; }
.color-dot { width: 28px; height: 28px; border-radius: 50%; border: 3px solid var(--card); box-shadow: 0 0 0 1px var(--line); }
.color-dot.selected { box-shadow: 0 0 0 2px var(--text); }

#dialog-root { position: fixed; inset: 0; z-index: 100; pointer-events: none; }
.dialog-backdrop {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0,0,0,.48);
  backdrop-filter: blur(3px);
  pointer-events: auto;
  animation: fade-in .16s ease-out;
}
.dialog {
  width: min(100%, 430px);
  max-height: min(86dvh, 760px);
  overflow-y: auto;
  padding: 10px 14px calc(18px + env(safe-area-inset-bottom));
  border-radius: 22px 22px 0 0;
  background: var(--app-bg);
  color: var(--text);
  box-shadow: 0 -20px 60px rgba(0,0,0,.28);
  animation: sheet-up .2s ease-out;
}
.dialog-handle { width: 42px; height: 4px; margin: 0 auto 12px; border-radius: 99px; background: var(--surface-3); }
.dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.dialog-title { margin: 0; font-size: 21px; font-weight: 850; letter-spacing: -.03em; }
.dialog-actions { display: flex; gap: 8px; margin-top: 18px; }
.dialog-actions .btn { flex: 1; }

#toast-root { position: fixed; left: 50%; top: calc(env(safe-area-inset-top, 0px) + 10px); z-index: 300; transform: translateX(-50%); width: min(calc(100% - 28px), 390px); pointer-events: none; display: grid; gap: 7px; }
.toast { padding: 10px 13px; min-height: 42px; border-radius: 14px; background: color-mix(in srgb, var(--text) 94%, transparent); color: var(--app-bg); box-shadow: 0 12px 30px rgba(15,23,42,.22); font-size: 12px; font-weight: 750; line-height: 1.25; animation: toast-in .18s ease-out; pointer-events: auto; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
.toast.error { background: var(--red); color: #fff; }

.empty-state { min-height: 170px; display: grid; place-content: center; gap: 8px; text-align: center; color: var(--muted); padding: 20px; }
.empty-icon { width: 48px; height: 48px; border-radius: 16px; margin: auto; display: grid; place-items: center; background: var(--surface); color: var(--accent); }
.empty-state strong { color: var(--text); }

.store-mode {
  position: absolute;
  inset: 0;
  z-index: 50;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  background: var(--app-bg);
}
.store-header { padding: 6px 14px 10px; }
.store-kicker { display: flex; align-items: center; justify-content: space-between; color: var(--accent); font-size: 10px; font-weight: 850; }
.store-progress { margin-top: 12px; display: flex; gap: 4px; }
.store-progress i { flex: 1; height: 3px; border-radius: 999px; background: var(--surface-2); }
.store-progress i.done { background: var(--accent); }
.store-progress i.current { background: var(--green); }
.store-content { min-height: 0; overflow-y: auto; padding: 10px 14px 20px; }
.store-title { margin: 4px 0 4px; font-size: 25px; line-height: 1; font-weight: 850; letter-spacing: -.04em; }
.store-subtitle { color: var(--muted); font-size: 9px; margin-bottom: 14px; }
.store-item { min-height: 74px; padding: 12px; border: 1px solid var(--line); border-radius: 13px; background: var(--card); display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.store-item.done { border-color: var(--green); background: var(--green-soft); }
.store-item .row-body { align-self: center; }
.price-input { width: 74px; min-height: 34px; border: 0; border-radius: 9px; background: var(--surface); text-align: right; padding: 0 8px; font-size: 11px; font-weight: 800; }
.store-cart { margin-top: 14px; }
.cart-row { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 10px; }
.cart-row:last-child { border-bottom: 0; }
.store-total { display: flex; justify-content: space-between; align-items: baseline; margin-top: 13px; font-weight: 850; }
.store-total strong { font-size: 17px; }
.store-footer { padding: 12px 14px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: var(--app-bg); }
.store-footer-row { display: grid; grid-template-columns: 42px 1fr; gap: 8px; }
.checkout-panel { padding: 15px; display: grid; gap: 12px; }
.checkout-total { font-size: 31px; font-weight: 900; letter-spacing: -.05em; }
.checkout-warning { color: var(--orange); font-size: 9px; font-weight: 750; }
.check-option { min-height: 40px; border-radius: 10px; padding: 9px 11px; display: flex; align-items: center; gap: 9px; background: var(--surface); font-size: 10px; font-weight: 750; }
.check-option .ok { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; background: var(--green); color: #fff; }

.skeleton { position: relative; overflow: hidden; background: var(--surface); }
.skeleton::after { content: ""; position: absolute; inset: 0; transform: translateX(-100%); background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--card) 70%, transparent), transparent); animation: shimmer 1.3s infinite; }

@keyframes shimmer { to { transform: translateX(100%); } }
@keyframes fade-in { from { opacity: 0; } }
@keyframes sheet-up { from { transform: translateY(18px); opacity: .6; } }
@keyframes toast-in { from { transform: translateY(-10px) scale(.98); opacity: 0; } to { transform: translateY(0) scale(1); opacity: 1; } }

@media (max-width: 360px) {
  .content-scroll { padding-left: 10px; padding-right: 10px; }
  .page-header { padding-left: 10px; padding-right: 10px; }
  .page-title { font-size: 23px; }
  .notes-grid { gap: 7px; }
  .note-card { padding: 10px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; }
}

