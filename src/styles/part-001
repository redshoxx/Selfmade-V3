.hero-month { color: var(--muted); font-size: 9px; font-weight: 750; }
.progress-track { height: 5px; border-radius: 999px; overflow: hidden; background: var(--surface-2); }
.progress-fill { height: 100%; border-radius: inherit; background: var(--accent); }
