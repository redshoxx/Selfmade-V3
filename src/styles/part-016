
/* Version 20 – Living Canvas Designsystem */
:root {
  --v20-bg: #edf3f1;
  --v20-bg-deep: #e4ece9;
  --v20-card: rgba(255,255,255,.9);
  --v20-card-solid: #ffffff;
  --v20-text: #15211f;
  --v20-muted: #66736f;
  --v20-line: rgba(39,64,58,.1);
  --v20-primary: #166d63;
  --v20-primary-strong: #0c554d;
  --v20-primary-soft: #dcefeb;
  --v20-secondary: #5e55c7;
  --v20-secondary-soft: #eeecff;
  --v20-warm: #d86a3d;
  --v20-warm-soft: #fff0e8;
  --v20-shadow: 0 18px 50px rgba(38,61,56,.11);
  --v20-shadow-soft: 0 8px 24px rgba(38,61,56,.07);
  --v20-radius-xl: 28px;
  --v20-radius-lg: 22px;
  --v20-radius-md: 17px;
}

[data-theme="dark"] {
  --v20-bg: #111715;
  --v20-bg-deep: #0b100f;
  --v20-card: rgba(27,36,33,.9);
  --v20-card-solid: #1b2421;
  --v20-text: #eff6f3;
  --v20-muted: #a1afaa;
  --v20-line: rgba(224,243,236,.1);
  --v20-primary: #63c7b9;
  --v20-primary-strong: #8cddd1;
  --v20-primary-soft: rgba(67,164,150,.17);
  --v20-secondary: #a9a2ff;
  --v20-secondary-soft: rgba(116,104,229,.17);
  --v20-warm: #f09a73;
  --v20-warm-soft: rgba(220,111,62,.16);
  --v20-shadow: 0 22px 58px rgba(0,0,0,.36);
  --v20-shadow-soft: 0 10px 28px rgba(0,0,0,.24);
}

html.haushaltklar-v20 body {
  color: var(--v20-text);
  background:
    radial-gradient(circle at 8% -4%, color-mix(in srgb,var(--v20-primary) 15%,transparent), transparent 29%),
    radial-gradient(circle at 98% 20%, color-mix(in srgb,var(--v20-secondary) 10%,transparent), transparent 28%),
    var(--v20-bg);
}

html.haushaltklar-v20 .app {
  grid-template-rows: auto minmax(0,1fr) calc(72px + var(--safe-bottom));
  background: transparent;
}

html.haushaltklar-v20 .card,
html.haushaltklar-v20 .dialog,
html.haushaltklar-v20 .sheet {
  border-color: var(--v20-line);
  box-shadow: var(--v20-shadow-soft);
}

html.haushaltklar-v20 .btn-primary,
html.haushaltklar-v20 .round-button.primary {
  border-color: transparent;
  color: #fff;
  background: linear-gradient(145deg,var(--v20-primary),var(--v20-primary-strong));
  box-shadow: 0 10px 22px color-mix(in srgb,var(--v20-primary) 27%,transparent);
}

html.haushaltklar-v20 .progress-fill { background: linear-gradient(90deg,var(--v20-primary),#49b9a7); }
html.haushaltklar-v20 .segmented .active { color:#fff; background:var(--v20-primary); }
html.haushaltklar-v20 .section-title { letter-spacing:-.025em; }

.v20-header {
  position: relative;
  z-index: 3;
  display: grid;
  color: var(--v20-text);
}

.v20-home-header {
  min-height: 160px;
  padding: calc(var(--safe-top) + 10px) 18px 18px;
  grid-template-columns: minmax(0,1fr) auto;
  gap: 18px 12px;
  background:
    radial-gradient(circle at 85% 5%, color-mix(in srgb,var(--v20-secondary) 17%,transparent), transparent 34%),
    radial-gradient(circle at 4% 100%, color-mix(in srgb,var(--v20-primary) 16%,transparent), transparent 36%);
}

.v20-brand { min-width:0; display:flex; align-items:center; gap:10px; }
.v20-brand img { width:39px; height:39px; border-radius:13px; box-shadow:0 9px 22px rgba(29,74,67,.18); }
.v20-brand > div { min-width:0; display:grid; gap:3px; }
.v20-brand strong { font-size:15px; line-height:1; letter-spacing:-.03em; }
.v20-brand span { overflow:hidden; color:var(--v20-muted); font-size:10px; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }

.v20-header-actions { display:flex; align-items:center; gap:7px; }
.v20-header-actions button {
  width:39px;
  height:39px;
  padding:0;
  border:1px solid var(--v20-line);
  border-radius:13px;
  display:grid;
  place-items:center;
  color:var(--v20-text);
  background:color-mix(in srgb,var(--v20-card-solid) 80%,transparent);
  box-shadow:0 7px 18px rgba(34,59,53,.06);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
}

.v20-greeting { grid-column:1/-1; display:grid; gap:4px; }
.v20-greeting small { color:var(--v20-primary); font-size:10px; font-weight:800; text-transform:capitalize; }
.v20-greeting h1 { margin:0; max-width:100%; font-size:30px; line-height:1.04; letter-spacing:-.055em; }
.v20-greeting p { margin:2px 0 0; color:var(--v20-muted); font-size:13px; }

.v20-page-header {
  min-height:90px;
  padding:calc(var(--safe-top) + 12px) 17px 12px;
  grid-template-columns:minmax(0,1fr) auto;
  align-items:end;
  gap:12px;
  background:linear-gradient(180deg,color-mix(in srgb,var(--v20-bg) 94%,transparent),color-mix(in srgb,var(--v20-bg) 78%,transparent));
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
}
.v20-page-header > div:first-child { min-width:0; display:grid; gap:3px; }
.v20-page-header small { overflow:hidden; color:var(--v20-muted); font-size:10px; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.v20-page-header h1 { margin:0; font-size:25px; line-height:1; letter-spacing:-.045em; }

.v20-dashboard {
  width:100%;
  max-width:760px;
  margin:0 auto;
  padding:0 14px 24px;
  display:grid;
  gap:19px;
}

.v20-focus-card {
  width:100%;
  min-height:140px;
  margin-top:-2px;
  padding:18px;
  border:1px solid color-mix(in srgb,var(--v20-primary) 13%,var(--v20-line));
  border-radius:var(--v20-radius-xl);
  display:grid;
  grid-template-columns:48px minmax(0,1fr);
  align-items:start;
  gap:12px;
  color:#f7fffc;
  text-align:left;
  background:
    radial-gradient(circle at 90% 10%,rgba(255,255,255,.16),transparent 34%),
    linear-gradient(145deg,#176e64,#104c47 72%,#143d3b);
  box-shadow:0 22px 48px rgba(18,78,71,.23);
}
.v20-focus-icon { width:48px; height:48px; border-radius:16px; display:grid; place-items:center; color:#fff; background:rgba(255,255,255,.15); box-shadow:inset 0 0 0 1px rgba(255,255,255,.1); }
.v20-focus-copy { min-width:0; display:grid; gap:5px; }
.v20-focus-copy small { color:rgba(255,255,255,.72); font-size:9px; font-weight:820; letter-spacing:.06em; text-transform:uppercase; }
.v20-focus-copy strong { font-size:19px; line-height:1.13; letter-spacing:-.035em; }
.v20-focus-copy > span { color:rgba(255,255,255,.72); font-size:11px; line-height:1.42; }
.v20-focus-card > b { grid-column:2; width:max-content; max-width:100%; min-height:32px; padding:0 11px; border-radius:999px; display:flex; align-items:center; gap:4px; color:#144a44; background:#e7faf5; font-size:9px; font-weight:820; }

.v20-activity-strip {
  margin-top:-8px;
  padding:5px;
  border:1px solid var(--v20-line);
  border-radius:19px;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  background:var(--v20-card);
  box-shadow:var(--v20-shadow-soft);
  backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);
}
.v20-activity-strip button { min-width:0; min-height:55px; padding:6px 2px; border:0; border-right:1px solid var(--v20-line); display:grid; place-content:center; gap:3px; color:var(--v20-text); background:transparent; }
.v20-activity-strip button:last-child { border-right:0; }
.v20-activity-strip strong { font-size:17px; line-height:1; }
.v20-activity-strip span { overflow:hidden; color:var(--v20-muted); font-size:8px; font-weight:670; text-overflow:ellipsis; white-space:nowrap; }

.v20-section { display:grid; gap:11px; }
.v20-section-head { min-height:38px; padding:0 2px; display:flex; align-items:end; justify-content:space-between; gap:12px; }
.v20-section-head > div { display:grid; gap:2px; }
.v20-section-head small { color:var(--v20-primary); font-size:8px; font-weight:830; letter-spacing:.07em; text-transform:uppercase; }
.v20-section-head h2 { margin:0; font-size:18px; line-height:1; letter-spacing:-.035em; }
.v20-section-head > button { min-height:32px; padding:0 10px; border:1px solid var(--v20-line); border-radius:11px; display:flex; align-items:center; gap:5px; color:var(--v20-primary); background:var(--v20-card); font-size:9px; font-weight:800; }

.v20-feature-grid { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr); gap:11px; }
.v20-money-card,.v20-kitchen-card { min-width:0; min-height:184px; padding:15px; border:1px solid var(--v20-line); border-radius:var(--v20-radius-lg); color:var(--v20-text); background:var(--v20-card); box-shadow:var(--v20-shadow-soft); text-align:left; }
.v20-money-card { display:grid; align-content:start; gap:5px; }
.v20-card-kicker { display:flex; align-items:center; gap:6px; color:var(--v20-primary); font-size:9px; font-weight:830; text-transform:uppercase; }
.v20-money-card > strong { margin-top:12px; overflow:hidden; font-size:24px; line-height:1; letter-spacing:-.05em; text-overflow:ellipsis; white-space:nowrap; }
.v20-money-card > small { color:var(--v20-muted); font-size:9px; }
.v20-progress { height:6px; margin-top:13px; overflow:hidden; border-radius:999px; background:var(--v20-primary-soft); }
.v20-progress i { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,var(--v20-primary),#59c2b1); }
.v20-money-meta { margin-top:8px; display:grid; gap:4px; }
.v20-money-meta b { overflow:hidden; color:var(--v20-muted); font-size:8px; font-weight:680; text-overflow:ellipsis; white-space:nowrap; }

.v20-kitchen-card { display:grid; grid-template-columns:1fr; align-content:start; gap:10px; }
.v20-kitchen-visual { width:100%; aspect-ratio:1.7; overflow:hidden; border-radius:15px; display:grid; place-items:center; color:var(--v20-warm); background:linear-gradient(145deg,var(--v20-warm-soft),color-mix(in srgb,var(--v20-secondary-soft) 42%,var(--v20-warm-soft))); }
.v20-kitchen-visual img { width:100%; height:100%; object-fit:cover; }
.v20-kitchen-copy { min-width:0; display:grid; gap:3px; }
.v20-kitchen-copy strong { overflow:hidden; font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
.v20-kitchen-copy small { display:-webkit-box; overflow:hidden; color:var(--v20-muted); font-size:8px; line-height:1.35; -webkit-box-orient:vertical; -webkit-line-clamp:2; }

.v20-action-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
.v20-action-grid button { min-width:0; min-height:91px; padding:10px 5px; border:1px solid var(--v20-line); border-radius:18px; display:grid; place-items:center; align-content:center; gap:5px; color:var(--v20-text); background:var(--v20-card); box-shadow:0 5px 15px rgba(35,58,53,.045); }
.v20-action-grid button > span { width:36px; height:36px; border-radius:12px; display:grid; place-items:center; color:var(--v20-primary); background:var(--v20-primary-soft); }
.v20-action-grid button:nth-child(3) > span { color:var(--v20-secondary); background:var(--v20-secondary-soft); }
.v20-action-grid button:nth-child(4) > span { color:var(--v20-warm); background:var(--v20-warm-soft); }
.v20-action-grid strong { overflow:hidden; max-width:100%; font-size:9px; text-overflow:ellipsis; white-space:nowrap; }
.v20-action-grid small { overflow:hidden; max-width:100%; color:var(--v20-muted); font-size:7px; text-overflow:ellipsis; white-space:nowrap; }

.v20-note-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; }
.v20-note-card,.v20-note-empty { min-width:0; min-height:106px; padding:14px; border:1px solid var(--v20-line); border-radius:19px; display:grid; align-content:start; gap:7px; color:var(--v20-text); background:var(--v20-card); box-shadow:var(--v20-shadow-soft); text-align:left; }
.v20-note-card > span,.v20-note-empty > span { width:32px; height:32px; border-radius:11px; display:grid; place-items:center; color:var(--v20-secondary); background:var(--v20-secondary-soft); }
.v20-note-card strong,.v20-note-empty strong { overflow:hidden; font-size:11px; text-overflow:ellipsis; white-space:nowrap; }
.v20-note-card small,.v20-note-empty small { display:-webkit-box; overflow:hidden; color:var(--v20-muted); font-size:8px; line-height:1.45; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.v20-note-empty { grid-column:1/-1; min-height:96px; grid-template-columns:38px minmax(0,1fr); align-items:center; }
.v20-note-empty > span { grid-row:1/3; }

.v20-tab-bar {
  position:relative;
  z-index:20;
  align-self:stretch;
  height:61px;
  margin:3px 9px calc(5px + var(--safe-bottom));
  padding:4px 5px;
  border:1px solid var(--v20-line);
  border-radius:22px;
  display:grid;
  grid-template-columns:repeat(6,minmax(0,1fr));
  background:color-mix(in srgb,var(--v20-card-solid) 88%,transparent);
  box-shadow:0 17px 38px rgba(29,52,47,.17);
  backdrop-filter:blur(26px) saturate(1.2);
  -webkit-backdrop-filter:blur(26px) saturate(1.2);
}
[data-theme="dark"] .v20-tab-bar { box-shadow:0 18px 42px rgba(0,0,0,.42); }
.v20-tab { min-width:0; min-height:52px; padding:3px 1px; border:0; border-radius:15px; display:grid; place-items:center; align-content:center; gap:2px; color:var(--v20-muted); background:transparent; }
.v20-tab > span { position:relative; width:31px; height:29px; border-radius:10px; display:grid; place-items:center; }
.v20-tab > span b { position:absolute; top:-4px; right:-6px; min-width:15px; height:15px; padding:0 3px; border:2px solid var(--v20-card-solid); border-radius:999px; display:grid; place-items:center; color:#fff; background:var(--v20-warm); font-size:7px; }
.v20-tab small { max-width:100%; overflow:hidden; font-size:8px; font-weight:720; text-overflow:ellipsis; white-space:nowrap; }
.v20-tab.active { color:var(--v20-primary); }
.v20-tab.active > span { color:#fff; background:linear-gradient(145deg,var(--v20-primary),var(--v20-primary-strong)); box-shadow:0 7px 16px color-mix(in srgb,var(--v20-primary) 28%,transparent); transform:translateY(-1px); }
.v20-floating-add { position:absolute; right:8px; top:-56px; width:47px; height:47px; padding:0; border:4px solid var(--v20-bg); border-radius:17px; display:grid; place-items:center; color:#fff; background:linear-gradient(145deg,var(--v20-warm),#b84d2b); box-shadow:0 13px 28px rgba(174,76,40,.28); }
.keyboard-open .v20-tab-bar { display:none; }

.v20-quick-sheet { display:grid; gap:16px; }
.v20-quick-sheet > p,.v20-experience-dialog > p { margin:0; color:var(--v20-muted); font-size:12px; line-height:1.45; }
.v20-quick-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; }
.v20-quick-grid button { min-width:0; min-height:106px; padding:13px; border:1px solid var(--v20-line); border-radius:18px; display:grid; align-content:start; gap:6px; color:var(--v20-text); background:var(--v20-card); text-align:left; }
.v20-quick-grid button > span { width:38px; height:38px; border-radius:13px; display:grid; place-items:center; color:var(--v20-primary); background:var(--v20-primary-soft); }
.v20-quick-grid button:nth-child(2n) > span { color:var(--v20-secondary); background:var(--v20-secondary-soft); }
.v20-quick-grid strong { font-size:12px; }
.v20-quick-grid small { color:var(--v20-muted); font-size:9px; line-height:1.35; }

.v20-experience-dialog { display:grid; gap:10px; }
.v20-profile-option { width:100%; min-height:76px; padding:11px; border:1px solid var(--v20-line); border-radius:17px; display:grid; grid-template-columns:39px minmax(0,1fr) 20px; align-items:center; gap:10px; color:var(--v20-text); background:var(--v20-card); text-align:left; }
.v20-profile-option > span { width:39px; height:39px; border-radius:13px; display:grid; place-items:center; color:var(--v20-primary); background:var(--v20-primary-soft); }
.v20-profile-option > div { min-width:0; display:grid; gap:3px; }
.v20-profile-option strong { font-size:12px; }
.v20-profile-option small { color:var(--v20-muted); font-size:9px; line-height:1.35; }
.v20-profile-option.active { border-color:color-mix(in srgb,var(--v20-primary) 48%,var(--v20-line)); background:color-mix(in srgb,var(--v20-primary-soft) 48%,var(--v20-card)); }
.v20-profile-option.active > svg { color:var(--v20-primary); }

.v20-settings-card { margin:10px 0; padding:12px; border:1px solid var(--v20-line); border-radius:18px; display:flex; align-items:center; justify-content:space-between; gap:10px; background:var(--v20-card); }
.v20-settings-card > div { min-width:0; display:flex; align-items:center; gap:10px; }
.v20-settings-card > div > span { width:38px; height:38px; flex:0 0 38px; border-radius:13px; display:grid; place-items:center; color:var(--v20-primary); background:var(--v20-primary-soft); }
.v20-settings-card > div > div { min-width:0; display:grid; gap:3px; }
.v20-settings-card strong { font-size:11px; }
.v20-settings-card small { color:var(--v20-muted); font-size:8px; }
.v20-settings-card > button { min-height:34px; padding:0 10px; border:0; border-radius:11px; color:var(--v20-primary); background:var(--v20-primary-soft); font-size:9px; font-weight:800; }

[data-v20-profile="comfort"] .v20-greeting h1 { font-size:34px; }
[data-v20-profile="comfort"] .v20-greeting p { font-size:15px; }
[data-v20-profile="comfort"] .v20-focus-card { min-height:160px; padding:20px; }
[data-v20-profile="comfort"] .v20-focus-copy strong { font-size:22px; }
[data-v20-profile="comfort"] .v20-focus-copy > span { font-size:13px; }
[data-v20-profile="comfort"] .v20-section-head h2 { font-size:21px; }
[data-v20-profile="comfort"] .v20-action-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
[data-v20-profile="comfort"] .v20-action-grid button { min-height:110px; }
[data-v20-profile="comfort"] .v20-action-grid strong { font-size:12px; }
[data-v20-profile="comfort"] .v20-action-grid small { font-size:9px; }
[data-v20-profile="comfort"] .v20-tab small { font-size:9px; }
[data-v20-profile="comfort"] .btn { min-height:50px; font-size:14px; }
[data-v20-profile="comfort"] .input,[data-v20-profile="comfort"] .textarea,[data-v20-profile="comfort"] select { min-height:50px; font-size:17px!important; }
[data-v20-profile="comfort"] .section-title { font-size:17px; }

[data-v20-profile="compact"] .v20-home-header { min-height:138px; padding-bottom:12px; }
[data-v20-profile="compact"] .v20-greeting h1 { font-size:26px; }
[data-v20-profile="compact"] .v20-dashboard { gap:13px; padding-inline:11px; }
[data-v20-profile="compact"] .v20-focus-card { min-height:118px; padding:14px; }
[data-v20-profile="compact"] .v20-feature-grid { gap:8px; }
[data-v20-profile="compact"] .v20-money-card,[data-v20-profile="compact"] .v20-kitchen-card { min-height:164px; padding:12px; }
[data-v20-profile="compact"] .v20-action-grid button { min-height:78px; }
[data-v20-profile="compact"] .v20-note-card { min-height:94px; }

@media (min-width:700px) {
  .v20-home-header,.v20-page-header { padding-left:max(24px,calc((100vw - 760px)/2)); padding-right:max(24px,calc((100vw - 760px)/2)); }
  .v20-tab-bar { width:min(720px,calc(100% - 28px)); justify-self:center; }
  .v20-feature-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}

@media (max-width:359px) {
  .v20-home-header { padding-inline:13px; }
  .v20-greeting h1 { font-size:27px; }
  .v20-dashboard { padding-inline:10px; }
  .v20-focus-card { grid-template-columns:42px minmax(0,1fr); padding:14px; }
  .v20-focus-icon { width:42px; height:42px; }
  .v20-focus-copy strong { font-size:17px; }
  .v20-feature-grid { grid-template-columns:1fr; }
  .v20-money-card,.v20-kitchen-card { min-height:150px; }
  .v20-action-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
  .v20-tab-bar { margin-inline:5px; }
  .v20-tab small { font-size:7px; }
}

@media (prefers-reduced-motion:reduce) {
  .v20-tab.active > span,.v20-focus-card,.v20-floating-add { transition:none; animation:none; }
}
