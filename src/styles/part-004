  border-radius: 20px;
  box-shadow: var(--shadow);
}
.auth-brand strong { display: block; font-size: 23px; letter-spacing: -.04em; }
.auth-brand small { display: block; margin-top: 5px; color: var(--muted); line-height: 1.4; }
.auth-card {
  width: min(100%, 420px);
  margin: 0 auto;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: color-mix(in srgb, var(--card) 92%, transparent);
  box-shadow: var(--shadow);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}
.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
  padding: 4px;
  margin-bottom: 16px;
  border-radius: 14px;
  background: var(--surface);
}
.auth-tabs button {
  min-height: 40px;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: var(--muted);
  font-weight: 800;
}
.auth-tabs button.active {
  background: var(--card);
  color: var(--text);
  box-shadow: var(--shadow-soft);
}
.auth-message {
  margin-bottom: 14px;
  padding: 11px 12px;
  border-radius: 12px;
  background: var(--orange-soft);
  color: var(--orange);
  font-size: 12px;
  line-height: 1.45;
}
.auth-footnote {
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.45;
}
.cloud-indicator {
  min-height: 28px;
  display: inline-flex;
  align-items: center;
  padding: 0 9px;
  border-radius: 999px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .03em;
  text-transform: uppercase;
}
.cloud-settings-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 13px;
  border: 1px solid var(--accent-line);
  border-radius: 15px;
  background: var(--accent-soft);
}
.cloud-settings-card.muted {
  border-color: var(--line);
  background: var(--surface);
}
.cloud-settings-card strong,
.cloud-settings-card small { display: block; }
.cloud-settings-card small { margin-top: 3px; color: var(--muted); font-size: 11px; }
.cloud-settings-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }


.scanner-idle {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 7px;
  padding: 24px;
  color: rgba(255,255,255,.92);
  text-align: center;
  background: radial-gradient(circle at 50% 35%, rgba(67,97,238,.32), transparent 46%);
}
.scanner-idle[hidden] { display: none; }
.scanner-idle strong, .scanner-idle small { display: block; }
.scanner-idle small { color: rgba(255,255,255,.68); font-size: 11px; }
.scanner-status {
  min-height: 42px;
  display: flex;
  align-items: center;
  margin: 0 0 12px;
  padding: 10px 12px;
  border-radius: 14px;
  color: var(--muted);
  background: var(--surface);
  border: 1px solid var(--line);
  font-size: 11px;
  line-height: 1.45;
}
.scanner-status.active { color: var(--accent); background: var(--accent-soft); border-color: var(--accent-line); }
.scanner-status.success { color: var(--green); background: var(--green-soft); }
.scanner-status.error { color: var(--red); background: var(--red-soft); }
.camera-capture-button { position: relative; overflow: hidden; cursor: pointer; }
.camera-capture-button input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.scanner-torch-button.active { color: #9a6200; background: #fff2b8; border-color: #f2d673; }
.scanner-panel video { background: #05070b; }


/* Version 13 – feste iPhone-PWA-Skalierung ohne Pinch-/Doppeltipp-Zoom */
.app,
.page-header,
.content-scroll,
.content-stack,
.section,
.card,
.form-grid,
.form-row,
.field,
.row-main,
.quick-tool,
.note-card,
.dialog,
.auth-screen,
.auth-card,
.store-mode {
  min-width: 0;
  max-width: 100%;
}

.app,
.dialog-backdrop,
.store-mode,
.auth-screen {
  touch-action: pan-y;
}

@supports (-webkit-touch-callout: none) {
  /* iOS zoomt Eingabefelder unter 16px beim Fokus automatisch. */
  input,
  select,
  textarea,
  .input,
  .select,
  .textarea,
  .price-input,
  .composer-input {
    font-size: 16px !important;
  }
}


.row-title,
.row-sub,
.note-title,
.note-content,
.auth-card,
.dialog {
  overflow-wrap: anywhere;
}

/* Version 14 – native iPhone-PWA, stabile Safe-Areas und hochwertige Formulare */
:root {
  --app-viewport-height: 100dvh;
  --app-viewport-offset: 0px;
  --keyboard-inset: 0px;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
}

html,
body {
  height: var(--app-viewport-height, 100dvh);
  min-height: var(--app-viewport-height, 100dvh);
  background: var(--app-bg);
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
}

body {
  position: fixed;
  inset: 0;
  width: 100%;
  place-items: stretch;
}

html.is-browser body {
  background: var(--frame-bg);
}

#app-shell {
  width: 100%;
  height: var(--app-viewport-height, 100dvh);
  max-width: 100vw;
  max-height: none;
  margin: 0;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

html.is-standalone #app-shell,
html.is-standalone body {
  background: var(--app-bg);
}

.app,
.store-mode {
  height: 100%;
  padding-top: var(--safe-top);
  padding-left: var(--safe-left);
  padding-right: var(--safe-right);
  grid-template-rows: auto minmax(0, 1fr) auto;
}

.page-header {
  min-height: 62px;
  padding: 10px 16px 9px;
  align-items: center;
}

.content-scroll {
  padding: 6px 16px 22px;
  scroll-padding-top: 16px;
  scroll-padding-bottom: calc(90px + var(--safe-bottom));
  -webkit-overflow-scrolling: touch;
}

.tab-bar {
  height: auto;
  min-height: calc(64px + var(--safe-bottom));
  padding: 6px 8px max(7px, var(--safe-bottom));
  background: color-mix(in srgb, var(--card) 94%, transparent);
  -webkit-backdrop-filter: saturate(180%) blur(22px);
  backdrop-filter: saturate(180%) blur(22px);
}

.tab-button {
  min-height: 50px;
  border-radius: 14px;
  font-size: 10px;
  gap: 3px;
}

.tab-button:active,
.btn:active,
.icon-button:active,
.round-button:active,
.pill:active,
.quick-tool:active,
.note-card:active {
  transform: scale(.975);
}

.icon-button,
.round-button {
  min-width: 44px;
  min-height: 44px;
}

.icon-button {
  width: 44px;
  height: 44px;
  border-radius: 14px;
}

.icon-button.small {
  width: 40px;
  height: 40px;
  border-radius: 13px;
}

.round-button {
  width: 44px;
  height: 44px;
}

.btn {
  min-height: 48px;
  padding-inline: 17px;
  border-radius: 14px;
  font-size: 15px;
}

.btn.small {
  min-height: 40px;
  font-size: 13px;
  border-radius: 12px;
}

.field {
  gap: 7px;
}

.field label {
  color: var(--text);
  font-size: 13px;
  line-height: 1.25;
  font-weight: 760;
}

.input,
.select,
.textarea,
.price-input,
.composer-input {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  border: 1px solid color-mix(in srgb, var(--line) 86%, var(--muted));
  border-radius: 15px;
  background: var(--card);
  padding: 0 14px;
  font-size: 16px;
  line-height: 1.25;
  box-shadow: 0 1px 0 rgba(255,255,255,.4) inset;
  transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
  -webkit-appearance: none;
  appearance: none;
}

.select {
  padding-right: 38px;
  background-image:
    linear-gradient(45deg, transparent 50%, var(--muted) 50%),
    linear-gradient(135deg, var(--muted) 50%, transparent 50%);
  background-position:
    calc(100% - 18px) calc(50% - 2px),
    calc(100% - 13px) calc(50% - 2px);
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
}

.textarea {
  min-height: 136px;
  padding: 13px 14px;
  line-height: 1.45;
  resize: none;
}

.input:focus,
.select:focus,
.textarea:focus,
.price-input:focus,
.composer-input:focus {
  outline: 0;
  border-color: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-soft);
  background: var(--card);
}

.input:disabled,
.select:disabled,
.textarea:disabled {
  opacity: .62;
  background: var(--surface);
}

