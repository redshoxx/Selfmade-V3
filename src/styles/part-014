
/* Version 19.2 – HaushaltKlar Markenauftritt */
:root {
  --accent: #2f6bff;
  --accent-soft: rgba(47, 107, 255, .12);
  --accent-line: rgba(47, 107, 255, .22);
  --accent-strong: #1f55d5;
  --app-bg: #f5f7fb;
  --frame-bg: #e9eef7;
}
[data-theme="dark"] {
  --app-bg: #0f0f12;
  --frame-bg: #08080a;
  --accent: #78a0ff;
  --accent-soft: rgba(120, 160, 255, .17);
  --accent-line: rgba(120, 160, 255, .26);
  --accent-strong: #a7c0ff;
}

.boot-screen-v192 { position: relative; overflow: hidden; padding: calc(var(--safe-top) + 36px) 28px calc(var(--safe-bottom) + 34px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; color: var(--text); background: radial-gradient(circle at 80% 16%, rgba(47,107,255,.13), transparent 31%), radial-gradient(circle at 14% 86%, rgba(31,180,244,.12), transparent 34%), linear-gradient(160deg,#fff 0%,#f4f8ff 58%,#eef6ff 100%); }
.boot-brand-mark-v192 { width:104px; height:104px; padding:8px; border-radius:28px; background:rgba(255,255,255,.8); box-shadow:0 22px 60px rgba(32,83,190,.18), inset 0 0 0 1px rgba(255,255,255,.9); animation:boot-mark-v192 .42s cubic-bezier(.2,.8,.2,1) both; }
.boot-brand-mark-v192 img { width:100%; height:100%; border-radius:22px; display:block; }
.boot-brand-v192 { margin-top:23px; font-size:29px; line-height:1; letter-spacing:-.045em; font-weight:870; }
.boot-tagline-v192 { margin-top:10px; color:#657083; font-size:12px; font-weight:650; letter-spacing:.01em; }
.boot-loader-v192 { width:84px; height:4px; margin-top:34px; overflow:hidden; border-radius:999px; background:rgba(47,107,255,.11); }
.boot-loader-v192 i { display:block; width:45%; height:100%; border-radius:inherit; background:linear-gradient(90deg,#255df2,#24aaf4); animation:boot-loader-v192 1.05s ease-in-out infinite alternate; }
.boot-version-v192 { position:absolute; bottom:calc(var(--safe-bottom) + 14px); color:rgba(58,69,89,.46); font-size:9px; font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
[data-theme="dark"] .boot-screen-v192 { background:radial-gradient(circle at 80% 16%,rgba(120,160,255,.17),transparent 31%),radial-gradient(circle at 14% 86%,rgba(31,180,244,.11),transparent 34%),linear-gradient(160deg,#10131a,#0d1119 60%,#0b1018); }
[data-theme="dark"] .boot-brand-mark-v192 { background:rgba(27,31,42,.82); box-shadow:0 24px 64px rgba(0,0,0,.4), inset 0 0 0 1px rgba(255,255,255,.07); }
[data-theme="dark"] .boot-tagline-v192 { color:var(--muted); }
[data-theme="dark"] .boot-version-v192 { color:rgba(255,255,255,.38); }
@keyframes boot-mark-v192 { from { opacity:0; transform:scale(.88) translateY(8px); } to { opacity:1; transform:none; } }
@keyframes boot-loader-v192 { from { transform:translateX(-70%); } to { transform:translateX(125%); } }

.app { grid-template-rows:auto minmax(0,1fr) calc(62px + var(--safe-bottom)); }
.tab-bar,.tab-bar-six-v19 { position:relative; align-self:stretch; height:54px; margin:4px 10px calc(4px + var(--safe-bottom)); padding:3px 4px; border:1px solid color-mix(in srgb,var(--line) 72%,transparent); border-radius:19px; grid-template-columns:repeat(6,minmax(0,1fr)); background:color-mix(in srgb,var(--card) 92%,transparent); box-shadow:0 12px 30px rgba(22,34,61,.13),0 2px 7px rgba(22,34,61,.06); backdrop-filter:blur(24px) saturate(1.25); -webkit-backdrop-filter:blur(24px) saturate(1.25); overflow:visible; }
[data-theme="dark"] .tab-bar,[data-theme="dark"] .tab-bar-six-v19 { background:color-mix(in srgb,var(--card) 90%,transparent); box-shadow:0 15px 34px rgba(0,0,0,.42); }
.tab-bar .tab-button,.tab-bar-six-v19 .tab-button { min-width:0; min-height:48px; padding:2px 1px 3px; gap:1px; border-radius:14px; color:var(--muted); font-size:7.5px; font-weight:720; background:transparent; transition:color .16s ease,transform .16s ease; }
.tab-bar .tab-button.active,.tab-bar-six-v19 .tab-button.active { color:var(--accent); background:transparent; }
.tab-bar .tab-button:active { transform:scale(.95); }
.tab-bar .tab-icon { width:31px; height:30px; display:grid; place-items:center; border-radius:11px; transition:background .16s ease,box-shadow .16s ease,transform .16s ease; }
.tab-bar .tab-icon svg,.tab-bar-six-v19 .tab-icon svg { width:19px; height:19px; }
.tab-bar .tab-button.active .tab-icon { color:#fff; background:linear-gradient(145deg,#255df2,#2f8cff); box-shadow:0 7px 16px rgba(47,107,255,.28); transform:translateY(-1px); }
.tab-bar .tab-badge { top:-4px; right:-6px; min-width:15px; height:15px; padding:0 3px; border:2px solid var(--card); box-shadow:none; font-size:7px; }
.keyboard-open .tab-bar { display:none; }

.brand-header-v192 { min-height:55px; padding:calc(var(--safe-top) + 5px) 14px 6px; align-items:center; }
.brand-lockup-v192 { min-width:0; display:flex; align-items:center; gap:9px; }
.brand-lockup-v192 img { width:35px; height:35px; border-radius:11px; box-shadow:0 6px 14px rgba(47,107,255,.16); }
.brand-lockup-v192 div { min-width:0; display:grid; gap:2px; }
.brand-lockup-v192 strong { font-size:15px; line-height:1; letter-spacing:-.025em; }
.brand-lockup-v192 span { overflow:hidden; color:var(--muted); font-size:8px; font-weight:670; text-overflow:ellipsis; white-space:nowrap; }

.home-dashboard-v192 { gap:11px; padding-bottom:8px; }
.home-welcome-v192 { padding:4px 2px 1px; display:flex; align-items:center; justify-content:space-between; gap:12px; }
.home-welcome-v192 p { margin:0 0 4px; color:var(--muted); font-size:8px; font-weight:720; text-transform:capitalize; }
.home-welcome-v192 h1 { margin:0; font-size:23px; line-height:1; letter-spacing:-.045em; }
.home-welcome-v192 div > span { display:block; margin-top:5px; color:var(--muted); font-size:10px; }
.home-scan-v192 { width:42px; height:42px; flex:0 0 42px; border:0; border-radius:14px; display:grid; place-items:center; color:var(--accent); background:var(--accent-soft); }
.home-overview-v192 { padding:14px; border-radius:18px; box-shadow:0 9px 25px rgba(28,45,82,.07); }
.home-overview-head-v192,.home-section-head-v192 { display:flex; align-items:center; justify-content:space-between; gap:12px; }
.home-overview-head-v192 strong,.home-section-head-v192 strong { font-size:12px; }
.home-overview-head-v192 > span { color:var(--muted); font-size:8px; font-weight:700; text-transform:capitalize; }
.home-budget-v192 { margin-top:14px; display:grid; grid-template-columns:minmax(0,1fr) 72px; align-items:center; gap:14px; }
.home-budget-v192 > div:first-child { display:grid; gap:3px; }
.home-budget-v192 small { color:var(--muted); font-size:8px; font-weight:720; }
.home-budget-v192 b { overflow:hidden; font-size:27px; line-height:1.05; letter-spacing:-.05em; text-overflow:ellipsis; white-space:nowrap; }
.home-budget-v192 span { color:var(--muted); font-size:9px; }
.home-budget-ring-v192 { width:67px; height:67px; border-radius:50%; display:grid; place-content:center; justify-items:center; background:radial-gradient(circle at center,var(--card) 62%,transparent 64%),conic-gradient(var(--accent) var(--budget-progress),var(--surface-2) 0); }
.home-budget-ring-v192 strong { font-size:14px; }
.home-budget-ring-v192 small { font-size:7px; }
.home-progress-v192 { height:4px; margin-top:13px; }
.home-shortcuts-v192 { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; }
.home-shortcut-v192 { min-width:0; min-height:69px; padding:10px; border:0; display:grid; grid-template-columns:34px minmax(0,1fr) 14px; align-items:center; gap:8px; color:inherit; text-align:left; }
.home-shortcut-v192 > span { width:34px; height:34px; border-radius:11px; display:grid; place-items:center; color:var(--accent); background:var(--accent-soft); }
.home-shortcut-v192 > div { min-width:0; display:grid; gap:3px; }
.home-shortcut-v192 strong { overflow:hidden; font-size:10px; text-overflow:ellipsis; white-space:nowrap; }
.home-shortcut-v192 small { color:var(--muted); font-size:8px; }
.home-shortcut-v192 > svg { color:var(--faint); }
.home-planner-v192,.home-alerts-v192 { padding:12px; border-radius:18px; }
.home-section-head-v192 > div { display:grid; gap:2px; }
.home-section-head-v192 small { color:var(--muted); font-size:8px; }
.home-section-head-v192 > button { min-height:30px; padding:0; border:0; display:flex; align-items:center; gap:3px; color:var(--accent); background:transparent; font-size:8px; font-weight:760; }
.home-meals-v192 { margin-top:10px; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:7px; }
.home-meal-card-v192 { min-width:0; padding:0; border:0; display:grid; gap:6px; color:inherit; background:transparent; text-align:left; }
.home-meal-image-v192 { aspect-ratio:1.5; overflow:hidden; border-radius:11px; display:grid; place-items:center; color:var(--accent); background:var(--surface); }
.home-meal-image-v192 img { width:100%; height:100%; object-fit:cover; }
.home-meal-card-v192 > span:last-child { min-width:0; display:grid; gap:2px; }
.home-meal-card-v192 b { color:var(--accent); font-size:7px; text-transform:uppercase; }
.home-meal-card-v192 strong { overflow:hidden; font-size:9px; line-height:1.15; text-overflow:ellipsis; white-space:nowrap; }
.home-meal-card-v192 small { overflow:hidden; color:var(--muted); font-size:7px; text-overflow:ellipsis; white-space:nowrap; }
.home-empty-action-v192 { width:100%; min-height:58px; margin-top:10px; padding:8px 9px; border:1px dashed var(--accent-line); border-radius:13px; display:grid; grid-template-columns:34px minmax(0,1fr) 14px; align-items:center; gap:9px; color:inherit; background:var(--accent-soft); text-align:left; }
.home-empty-action-v192 > span { width:34px; height:34px; border-radius:11px; display:grid; place-items:center; color:var(--accent); background:var(--card); }
.home-empty-action-v192 div { min-width:0; display:grid; gap:3px; }
.home-empty-action-v192 strong { font-size:9px; }
.home-empty-action-v192 small { color:var(--muted); font-size:7.5px; line-height:1.3; }
.home-alerts-v192 > button { width:100%; min-height:49px; padding:7px 0; border:0; border-top:1px solid var(--line); display:grid; grid-template-columns:31px minmax(0,1fr) auto; align-items:center; gap:8px; color:inherit; background:transparent; text-align:left; }
.home-alerts-v192 > button:first-of-type { margin-top:8px; }
.home-alerts-v192 > button > span { font-size:18px; }
.home-alerts-v192 > button div { min-width:0; display:grid; gap:2px; }
.home-alerts-v192 > button strong { font-size:9px; }
.home-alerts-v192 > button small { overflow:hidden; color:var(--muted); font-size:7px; text-overflow:ellipsis; white-space:nowrap; }
.home-alerts-v192 > button b { color:var(--orange); font-size:7.5px; }
.home-note-v192 { width:100%; min-height:59px; padding:10px 11px; border:0; display:grid; grid-template-columns:35px minmax(0,1fr) auto 14px; align-items:center; gap:9px; color:inherit; text-align:left; }
.home-note-v192 > span { width:35px; height:35px; border-radius:11px; display:grid; place-items:center; color:var(--accent); background:var(--accent-soft); }
.home-note-v192 > div { min-width:0; display:grid; gap:3px; }
.home-note-v192 strong { font-size:10px; }
.home-note-v192 small { overflow:hidden; color:var(--muted); font-size:8px; text-overflow:ellipsis; white-space:nowrap; }
.home-note-v192 b { min-width:20px; height:20px; padding:0 5px; border-radius:999px; display:grid; place-items:center; color:var(--accent); background:var(--accent-soft); font-size:8px; }
.home-note-v192 > svg { color:var(--faint); }
@media (max-width:359px) { .tab-bar,.tab-bar-six-v19 { margin-inline:7px; } .tab-bar .tab-button,.tab-bar-six-v19 .tab-button { font-size:7px; } .tab-bar .tab-icon { width:28px; } .home-budget-v192 { grid-template-columns:minmax(0,1fr) 62px; } .home-budget-ring-v192 { width:60px; height:60px; } .home-shortcut-v192 { grid-template-columns:31px minmax(0,1fr); } .home-shortcut-v192 > svg { display:none; } }
@media (prefers-reduced-motion:reduce) { .boot-brand-mark-v192,.boot-loader-v192 i,.tab-bar .tab-icon { animation:none; transition:none; } }
