.store-mode-v17 {
  background: var(--app-bg);
}

.store-header-v17 {
  padding: calc(var(--safe-top) + 10px) 16px 12px;
  background: color-mix(in srgb, var(--app-bg) 94%, transparent);
  border-bottom: 1px solid var(--line);
}

.store-nav-v17 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.store-nav-v17 > div {
  display: grid;
  gap: 2px;
}

.store-nav-v17 span {
  color: var(--accent);
  font-size: 9px;
  letter-spacing: .08em;
  font-weight: 900;
}

.store-nav-v17 strong {
  font-size: 13px;
  font-weight: 850;
}

.store-nav-v17 button {
  min-height: 38px;
  padding: 0 13px;
  border: 0;
  border-radius: 12px;
  background: var(--surface);
  color: var(--text);
  font-size: 11px;
  font-weight: 800;
}

.store-overall-progress-v17 {
  height: 4px;
  margin: 13px 0 14px;
  border-radius: 999px;
  overflow: hidden;
  background: var(--surface-2);
}

.store-overall-progress-v17 i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--green);
  transition: width .22s ease;
}

.store-section-heading-v17 {
  display: flex;
  align-items: center;
  gap: 11px;
}

.store-section-heading-v17 > span {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: var(--surface);
  font-size: 21px;
}

.store-section-heading-v17 h1 {
  margin: 0;
  font-size: 22px;
  line-height: 1.05;
  letter-spacing: -.035em;
}

.store-section-heading-v17 p {
  margin: 4px 0 0;
  color: var(--muted);
  font-size: 10px;
  font-weight: 680;
}

.store-content-v17,
.store-checkout-content-v17 {
  min-height: 0;
  overflow-y: auto;
  padding: 13px 16px 18px;
  -webkit-overflow-scrolling: touch;
}

.store-items-v17 {
  display: grid;
  gap: 8px;
}

.store-item-v17 {
  min-height: 66px;
  padding: 8px 9px;
  border: 1px solid var(--line);
  border-radius: 17px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.store-item-v17.is-done {
  background: color-mix(in srgb, var(--green-soft) 55%, var(--card));
  border-color: color-mix(in srgb, var(--green) 32%, var(--line));
}

.store-check-v17 {
  width: 36px;
  height: 36px;
  flex: 0 0 36px;
}

.store-item-main-v17 {
  min-width: 0;
  flex: 1;
  padding: 5px 0;
  border: 0;
  display: grid;
  gap: 3px;
  background: transparent;
  color: inherit;
  text-align: left;
}

.store-item-main-v17 strong,
.store-item-main-v17 small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-item-main-v17 strong {
  font-size: 14px;
  font-weight: 850;
}

.store-item-main-v17 small {
  color: var(--muted);
  font-size: 10px;
}

.store-item-v17.is-done .store-item-main-v17 strong {
  text-decoration: line-through;
  opacity: .68;
}

.store-price-button-v17 {
  min-width: 66px;
  min-height: 38px;
  padding: 0 9px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  color: var(--muted);
  font-size: 11px;
  font-weight: 850;
}

.store-price-button-v17.has-price {
  color: var(--text);
  background: var(--card);
}

.store-cart-summary-v17 {
  width: 100%;
  min-height: 50px;
  margin-top: 13px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: var(--surface);
  color: var(--text);
}

.store-cart-summary-v17 span {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11px;
  font-weight: 800;
}

.store-cart-summary-v17 strong {
  font-size: 13px;
}

.store-footer-v17 {
  padding: 10px 16px calc(10px + var(--safe-bottom));
  border-top: 1px solid var(--line);
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr);
  gap: 9px;
  background: color-mix(in srgb, var(--app-bg) 96%, transparent);
  box-shadow: 0 -10px 28px rgba(15, 23, 42, .08);
}

.store-back-v17 {
  width: 46px;
  min-height: 48px;
  border: 0;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: var(--surface);
  color: var(--text);
}

.store-back-v17:disabled {
  opacity: .35;
}

.store-next-v17 {
  min-height: 48px;
  border-radius: 14px;
}

.store-checkout-content-v17 {
  display: grid;
  align-content: start;
  gap: 12px;
}

.store-checkout-card-v17 {
  min-height: 260px;
  padding: 24px 20px;
  border: 1px solid var(--line);
  border-radius: 24px;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 7px;
  background: var(--card);
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.store-checkout-icon-v17 {
  width: 54px;
  height: 54px;
  margin-bottom: 5px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: var(--green-soft);
  color: var(--green);
}

.store-checkout-card-v17 h1 {
  margin: 0;
  font-size: 22px;
  letter-spacing: -.035em;
}

.store-checkout-card-v17 p {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
}

.store-checkout-total-v17 {
  margin: 8px 0 3px;
  font-size: 34px;
  letter-spacing: -.05em;
}

.store-missing-price-v17,
.store-ready-v17 {
  padding: 7px 10px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 750;
}

.store-missing-price-v17 {
  background: var(--orange-soft);
  color: var(--orange);
}

.store-ready-v17 {
  background: var(--green-soft);
  color: var(--green);
}

.store-checkout-list-v17 {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--card);
}

.store-checkout-list-v17 button {
  width: 100%;
  min-height: 49px;
  padding: 0 12px;
  border: 0;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  background: transparent;
  color: var(--text);
  font-size: 11px;
  text-align: left;
}

.store-checkout-list-v17 button:last-child {
  border-bottom: 0;
}

.store-price-product-v17 {
  min-height: 60px;
  padding: 9px 11px;
  border: 1px solid var(--line);
  border-radius: 15px;
  display: flex;
  align-items: center;
  gap: 11px;
  background: var(--surface);
}

.store-price-product-v17 > span {
  width: 39px;
  height: 39px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  background: var(--card);
  font-size: 20px;
}

.store-price-product-v17 > div {
  display: grid;
  gap: 3px;
}

.store-price-product-v17 small {
  color: var(--muted);
}

.store-price-sheet-v17 {
  display: grid;
  gap: 14px;
}

.store-price-input-v17 {
  min-height: 58px;
  padding: 0 14px;
  border: 1px solid var(--line);
  border-radius: 15px;
  display: flex;
  align-items: center;
  background: var(--surface);
}

.store-price-input-v17:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-soft);
}

.store-price-input-v17 input {
  min-width: 0;
  width: 100%;
  height: 56px;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: 28px;
  font-weight: 850;
  text-align: right;
}

.store-price-input-v17 span {
  margin-left: 8px;
  font-size: 19px;
  font-weight: 800;
}

@media (max-width: 370px) {
  .shopping-toolbar-v17 {
    grid-template-columns: 1fr;
  }

  .shopping-add-trigger-v17 {
    justify-content: center;
  }

  .shopping-row-v17 {
    gap: 8px;
  }

  .store-price-button-v17 {
    min-width: 60px;
  }
}

.shopping-group-header-v17 svg,
.shopping-completed-header-v17 svg {
  transition: transform .16s ease;
}

.shopping-group-header-v17[aria-expanded="true"] .shopping-group-count-v17 svg,
.shopping-completed-header-v17[aria-expanded="true"] > span:last-child svg {
  transform: rotate(90deg);
}
