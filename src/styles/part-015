

/* Version 19.3 – Rechte- und Datenschutzdarstellung */
.boot-rights-v193{margin-top:2px;font-size:9px;letter-spacing:.02em;color:var(--muted);opacity:.68}
.rights-card-v193{display:grid;gap:10px;padding:14px;border:1px solid color-mix(in srgb,var(--accent) 18%,var(--border));border-radius:18px;background:color-mix(in srgb,var(--accent) 5%,var(--card));box-shadow:0 8px 24px rgba(24,50,105,.06)}
.rights-card-v193 p,.legal-copy-v193 p{margin:0;color:var(--muted);font-size:12px;line-height:1.52}
.rights-card-title-v193{display:flex;align-items:center;gap:10px}.rights-card-title-v193 div{display:grid;gap:2px}.rights-card-title-v193 small{color:var(--muted);font-size:11px}
.rights-lock-v193{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:var(--accent);color:#fff;flex:0 0 auto}
.rights-actions-v193{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.rights-actions-v193 .btn{min-width:0}
.legal-copy-v193{display:grid;gap:14px}.legal-copy-v193 strong{color:var(--text)}.legal-copy-v193 code{font-size:11px;background:var(--soft);padding:2px 5px;border-radius:6px;color:var(--text)}
.legal-badge-v193{width:max-content;max-width:100%;padding:7px 10px;border-radius:999px;background:color-mix(in srgb,var(--accent) 12%,transparent);color:var(--accent);font-size:11px;font-weight:800}
.legal-owner-v193{padding-top:10px;border-top:1px solid var(--border);font-weight:750;color:var(--text)!important}
@media(max-width:359px){.rights-actions-v193{grid-template-columns:1fr}}
