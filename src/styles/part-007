
/* Version 16 – Einkaufsseite für iPhone 12 */
.shopping-page-header {
  align-items: flex-end;
}

.shopping-header-meta {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.shopping-store-button {
  min-height: 42px;
  gap: 7px;
  padding-inline: 14px;
}

.shopping-screen-v16 {
  gap: 16px;
  padding-bottom: 12px;
}

.shopping-add-card-v16 {
  padding: 15px;
  border-radius: 22px;
  display: grid;
  gap: 12px;
  overflow: visible;
}

.shopping-add-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.shopping-add-kicker {
  display: block;
  margin-bottom: 3px;
  color: var(--accent);
  font-size: 9px;
  line-height: 1;
  letter-spacing: .09em;
  font-weight: 900;
}

.shopping-add-heading h2 {
  margin: 0;
  font-size: 19px;
  line-height: 1.15;
  letter-spacing: -.025em;
}

.shopping-open-count {
  min-width: 34px;
  height: 34px;
  padding: 0 9px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 14px;
  font-weight: 900;
}

.shopping-quick-form-v16 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: stretch;
}

.shopping-input-shell-v16 {
  min-width: 0;
  min-height: 50px;
  padding: 0 13px;
  border: 1px solid var(--line);
  border-radius: 15px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: var(--surface);
  color: var(--muted);
  transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
}

.shopping-input-shell-v16:focus-within {
  border-color: var(--accent);
  background: var(--card);
  box-shadow: 0 0 0 4px var(--accent-soft);
}

.shopping-input-shell-v16 input {
  width: 100%;
  min-width: 0;
  height: 48px;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: 16px;
}

.shopping-input-shell-v16 input::placeholder {
  color: color-mix(in srgb, var(--muted) 82%, transparent);
}

.shopping-add-submit-v16 {
  min-width: 104px;
  min-height: 50px;
  padding-inline: 13px;
}

.shopping-add-actions-v16 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
}

.shopping-add-actions-v16 button {
  min-width: 0;
  min-height: 42px;
  padding: 5px 7px;
  border: 1px solid var(--line);
  border-radius: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--surface);
  color: var(--text);
  font-size: 11px;
  font-weight: 800;
}

.shopping-add-actions-v16 button:disabled {
  opacity: .42;
}

.shopping-inline-results {
  margin-top: -4px;
  border: 1px solid var(--line);
  border-radius: 15px;
  overflow: hidden;
  background: var(--card);
  box-shadow: 0 14px 32px rgba(15, 23, 42, .12);
}

.shopping-inline-result {
  width: 100%;
  min-height: 53px;
  padding: 8px 10px;
  border: 0;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  gap: 10px;
  background: transparent;
  color: var(--text);
  text-align: left;
}

.shopping-inline-result:last-child {
  border-bottom: 0;
}

.shopping-result-emoji {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--surface);
  font-size: 17px;
}

.shopping-result-copy {
  min-width: 0;
  flex: 1;
  display: grid;
  gap: 2px;
}

.shopping-result-copy strong,
.shopping-result-copy small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shopping-result-copy strong {
  font-size: 13px;
}

.shopping-result-copy small {
  color: var(--muted);
  font-size: 10px;
}

.shopping-result-add {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: var(--accent-soft);
  color: var(--accent);
}

.shopping-progress-card-v16 {
  display: grid;
  grid-template-columns: auto minmax(90px, 1fr);
  align-items: center;
  gap: 14px;
  padding: 0 2px;
}

.shopping-progress-card-v16 > div:first-child {
  display: grid;
  gap: 2px;
}

.shopping-progress-card-v16 strong {
  font-size: 13px;
}

.shopping-progress-card-v16 span {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
}

.shopping-progress-card-v16 .progress-track {
  height: 5px;
}

.shopping-suggestions-v16 {
  display: grid;
  gap: 8px;
}

.shopping-suggestion-list-v16 {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 1px 1px 5px;
  scrollbar-width: none;
}

.shopping-suggestion-list-v16::-webkit-scrollbar {
  display: none;
}

.shopping-suggestion-v16 {
  min-width: 170px;
  max-width: 210px;
  min-height: 56px;
  padding: 9px 10px;
  border: 1px solid var(--line);
  border-radius: 16px;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) 22px;
  align-items: center;
  gap: 8px;
  background: var(--card);
  color: var(--text);
  text-align: left;
}

.shopping-suggestion-v16 > span:nth-child(2) {
  min-width: 0;
  display: grid;
  gap: 2px;
}

.shopping-suggestion-v16 strong,
.shopping-suggestion-v16 small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shopping-suggestion-v16 strong {
  font-size: 12px;
}

.shopping-suggestion-v16 small {
  color: var(--muted);
  font-size: 9px;
}

.shopping-category-v16 {
  display: grid;
  gap: 8px;
}

.shopping-category-heading-v16 {
  padding: 0 3px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shopping-category-heading-v16 > span {
  display: flex;
  align-items: center;
  gap: 8px;
}

.shopping-category-heading-v16 i {
  width: 24px;
  height: 24px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  background: var(--surface);
  font-style: normal;
  font-size: 13px;
}

.shopping-category-heading-v16 strong {
  font-size: 12px;
  font-weight: 850;
}

.shopping-category-heading-v16 small {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
}

.shopping-items-v16 {
  display: grid;
  gap: 8px;
}

.shopping-item-v16 {
  min-width: 0;
  min-height: 65px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 18px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--card);
  box-shadow: var(--shadow-sm);
}

.shopping-check-v16 {
  width: 31px;
  height: 31px;
  border-width: 2px;
}

.shopping-item-main {
  min-width: 0;
  flex: 1;
  padding: 4px 0;
  border: 0;
  display: grid;
  gap: 3px;
  background: transparent;
  color: inherit;
  text-align: left;
}

.shopping-item-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 15px;
  font-weight: 830;
}

.shopping-item-details {
  overflow: hidden;
  color: var(--muted);
  font-size: 10px;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shopping-stepper-v16 {
  gap: 3px;
  padding: 3px;
  border-radius: 12px;
  background: var(--surface);
}

.shopping-stepper-v16 .step-button {
  width: 31px;
  height: 31px;
  border-radius: 10px;
  background: var(--card);
  font-size: 17px;
}

.shopping-stepper-v16 .step-value {
  min-width: 24px;
  font-size: 12px;
}

.shopping-edit-v16 {
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: var(--surface);
  color: var(--muted);
}

.shopping-empty-v16 {
  min-height: 230px;
  padding: 28px 22px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  text-align: center;
}

.shopping-empty-v16 > span:not(.shopping-empty-icon-v16) {
  max-width: 260px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.shopping-empty-icon-v16 {
  width: 52px;
  height: 52px;
  margin-bottom: 3px;
  border-radius: 17px;
  display: grid;
  place-items: center;
  background: var(--accent-soft);
  color: var(--accent);
}

.shopping-empty-v16 .btn {
  margin-top: 8px;
}

.shopping-completed-v16 {
  display: grid;
  gap: 8px;
  padding-top: 4px;
}

.shopping-completed-toggle-v16 {
  width: 100%;
  min-height: 46px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--surface);
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.shopping-completed-toggle-v16 span {
  display: flex;
  align-items: center;
  gap: 7px;
}

.shopping-item-v16.is-completed {
  min-height: 57px;
  opacity: .66;
  box-shadow: none;
}

.shopping-item-v16.is-completed .shopping-item-title {
  text-decoration: line-through;
}

.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

@media (max-width: 359px) {
  .shopping-quick-form-v16 {
    grid-template-columns: 1fr;
  }

  .shopping-add-submit-v16 {
    width: 100%;
  }

  .shopping-add-actions-v16 button span {
    display: none;
  }
}
