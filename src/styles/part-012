
/* Version 19 – Vollbild-Kochmodus */
body.cooking-active-v19 { overflow: hidden; background: var(--app-bg); }
body.cooking-active-v19 #dialog-root, body.cooking-active-v19 #toast-root { z-index: 10000; }
.cook-mode-v19 { position: fixed; inset: 0; z-index: 9000; height: var(--app-viewport-height, 100dvh); display: grid; grid-template-rows: auto 4px auto minmax(0,1fr) auto auto; background: var(--app-bg); color: var(--text); }
.cook-header-v19 { padding: calc(var(--safe-top) + 8px) 14px 9px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 10px; background: color-mix(in srgb, var(--app-bg) 96%, transparent); }
.cook-header-v19 > div { min-width: 0; display: grid; gap: 2px; }
.cook-header-v19 span { color: var(--accent); font-size: 8px; letter-spacing: .12em; font-weight: 900; }
.cook-header-v19 strong { overflow: hidden; font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
.cook-header-v19 button { min-height: 38px; padding: 0 12px; border: 0; border-radius: 12px; background: var(--surface); color: var(--text); font-size: 9px; font-weight: 800; }
.cook-progress-v19 { overflow: hidden; background: var(--surface-2); }
.cook-progress-v19 i { display: block; height: 100%; border-radius: 999px; background: var(--green); transition: width .2s ease; }
.cook-tabs-v19 { padding: 7px 12px; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr 42px 42px; gap: 6px; background: var(--card); }
.cook-tabs-v19 button { min-height: 38px; border: 0; border-radius: 11px; background: var(--surface); color: var(--muted); font-size: 9px; font-weight: 780; }
.cook-tabs-v19 button.active { background: var(--accent); color: #fff; }
.cook-content-v19 { min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
.cook-step-v19 { min-height: 100%; padding: 22px 17px 28px; display: grid; align-content: start; gap: 15px; }
.cook-step-count-v19 { width: 44px; height: 44px; border-radius: 15px; display: grid; place-items: center; background: var(--accent); color: #fff; font-size: 17px; font-weight: 900; box-shadow: 0 10px 24px color-mix(in srgb, var(--accent) 28%, transparent); }
.cook-step-v19 h1 { margin: 0; max-width: 92%; font-size: clamp(25px, 8vw, 34px); line-height: 1.06; letter-spacing: -.045em; }
.cook-step-v19 > p { margin: 0; font-size: clamp(19px, 5.7vw, 24px); line-height: 1.5; font-weight: 590; }
.cook-step-v19 > img, .cook-step-v19 > video { width: 100%; max-height: 260px; border-radius: 20px; object-fit: cover; background: var(--surface); }
.step-needed-v19 { padding: 13px; border: 1px solid var(--line); border-radius: 17px; display: grid; gap: 8px; background: var(--card); }
.step-needed-v19 > strong { color: var(--accent); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; }
.step-needed-v19 > span { font-size: 13px; }
.step-needed-v19 b { margin-right: 5px; }
.detected-timers-v19 { display: grid; gap: 8px; }
.detected-timers-v19 button { min-height: 50px; padding: 0 13px; border: 1px solid color-mix(in srgb, var(--orange) 30%, var(--line)); border-radius: 15px; display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--orange-soft); color: var(--orange); font-size: 11px; font-weight: 850; }
.cook-note-inline-v19 { display: grid; gap: 5px; }
.cook-note-inline-v19 > span { color: var(--muted); font-size: 9px; font-weight: 750; }
.cook-note-inline-v19 textarea { min-height: 82px; padding: 11px; border: 1px solid var(--line); border-radius: 15px; resize: vertical; background: var(--card); color: var(--text); font: inherit; font-size: 16px; }
.cook-ingredients-v19 { padding: 14px; display: grid; gap: 8px; }
.cook-ingredients-head-v19 { min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.cook-ingredients-head-v19 h1 { margin: 0; font-size: 25px; letter-spacing: -.04em; }
.cook-ingredients-head-v19 p { margin: 3px 0 0; color: var(--muted); font-size: 9px; }
.cook-ingredients-head-v19 > div:last-child { display: flex; align-items: center; gap: 7px; }
.cook-ingredients-head-v19 button { width: 39px; height: 39px; border: 0; border-radius: 12px; background: var(--surface); color: var(--text); font-size: 19px; }
.cook-ingredient-v19 { min-height: 62px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 16px; display: grid; grid-template-columns: 34px minmax(0,1fr) auto; align-items: center; gap: 9px; background: var(--card); color: var(--text); text-align: left; }
.cook-ingredient-v19.used { opacity: .56; }
.cook-ingredient-v19.used strong { text-decoration: line-through; }
.cook-ingredient-v19 .check { width: 32px; height: 32px; }
.cook-ingredient-v19 > div { min-width: 0; display: grid; gap: 2px; }
.cook-ingredient-v19 strong { font-size: 12px; }
.cook-ingredient-v19 small { color: var(--muted); font-size: 8px; }
.cook-ingredient-v19 em { width: max-content; padding: 2px 5px; border-radius: 999px; background: var(--green-soft); color: var(--green); font-size: 7px; font-style: normal; font-weight: 780; }
.cook-ingredient-v19 em.missing { background: var(--orange-soft); color: var(--orange); }
.cook-ingredient-v19 > b { font-size: 11px; white-space: nowrap; }
.active-timers-v19 { max-height: 160px; overflow-y: auto; padding: 7px 10px; border-top: 1px solid var(--line); display: grid; gap: 5px; background: var(--card); }
.active-timer-v19 { min-height: 48px; padding: 5px 7px; border: 1px solid var(--line); border-radius: 13px; display: grid; grid-template-columns: 24px minmax(0,1fr) auto auto 32px; align-items: center; gap: 5px; background: var(--surface); }
.active-timer-v19 > span { color: var(--orange); }
.active-timer-v19 > div { min-width: 0; display: flex; align-items: baseline; justify-content: space-between; gap: 6px; }
.active-timer-v19 strong { overflow: hidden; font-size: 9px; text-overflow: ellipsis; white-space: nowrap; }
.active-timer-v19 b { font-variant-numeric: tabular-nums; font-size: 14px; }
.active-timer-v19 button { min-height: 32px; padding: 0 7px; border: 0; border-radius: 9px; background: var(--card); color: var(--text); font-size: 7px; font-weight: 760; }
.active-timer-v19 button:last-child { width: 32px; padding: 0; }
.cook-footer-v19 { padding: 8px 10px calc(8px + var(--safe-bottom)); border-top: 1px solid var(--line); display: grid; grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); align-items: center; gap: 7px; background: color-mix(in srgb, var(--app-bg) 97%, transparent); box-shadow: 0 -10px 28px rgba(15,23,42,.08); }
.cook-footer-v19 > button { min-height: 52px; padding: 0 12px; border: 0; border-radius: 15px; display: flex; align-items: center; justify-content: center; gap: 5px; background: var(--surface); color: var(--text); font-size: 10px; font-weight: 850; }
.cook-footer-v19 > button.primary { background: var(--accent); color: #fff; }
.cook-footer-v19 > button:disabled { opacity: .35; }
.cook-footer-v19 > div { min-width: 58px; display: grid; gap: 1px; text-align: center; }
.cook-footer-v19 span { font-size: 8px; font-weight: 800; }
.cook-footer-v19 small { color: var(--muted); font-size: 7px; }
.cook-complete-v19 { grid-template-rows: auto minmax(0,1fr); }
.cook-complete-v19 > main { overflow-y: auto; padding: 24px 16px calc(24px + var(--safe-bottom)); display: grid; align-content: start; justify-items: center; gap: 10px; text-align: center; }
.cook-complete-icon-v19 { width: 72px; height: 72px; border-radius: 24px; display: grid; place-items: center; background: var(--green-soft); color: var(--green); }
.cook-complete-v19 h1 { margin: 2px 0 0; font-size: 30px; letter-spacing: -.05em; }
.cook-complete-v19 p { margin: 0; color: var(--muted); font-size: 11px; }
.cook-complete-form-v19 { width: 100%; display: grid; gap: 10px; text-align: left; }
.rating-stars-v19 { display: flex; justify-content: center; gap: 4px; }
.rating-stars-v19 label { cursor: pointer; }
.rating-stars-v19 input { position: absolute; opacity: 0; }
.rating-stars-v19 span { width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; background: var(--surface); color: #f1a60a; }
.rating-stars-v19 input:checked ~ span { background: color-mix(in srgb, #f1a60a 18%, var(--surface)); box-shadow: 0 0 0 2px #f1a60a; }
.cook-photo-v19 { min-height: 82px; padding: 9px; border: 1px dashed var(--line); border-radius: 16px; display: flex; align-items: center; gap: 11px; background: var(--card); }
.cook-photo-v19 > span { width: 62px; height: 62px; overflow: hidden; border-radius: 14px; display: grid; place-items: center; background: var(--surface); color: var(--muted); }
.cook-photo-v19 img { width: 100%; height: 100%; object-fit: cover; }
.cook-photo-v19 strong { font-size: 10px; }
@media (max-width: 370px) { .active-timer-v19 { grid-template-columns: 22px minmax(0,1fr) 32px; } .active-timer-v19 button:not(:last-child) { display: none; } .cook-step-v19 { padding-inline: 14px; } }

.custom-timer-trigger-v19 { min-height: 46px; border: 1px dashed var(--line); border-radius: 14px; display:flex; align-items:center; justify-content:center; gap:7px; background:transparent; color:var(--muted); font-size:10px; font-weight:780; }
