input[type="time"],
input[type="month"],
input[type="number"] {
  min-width: 0;
  width: 100%;
}

input[type="date"]::-webkit-date-and-time-value,
input[type="time"]::-webkit-date-and-time-value,
input[type="month"]::-webkit-date-and-time-value {
  text-align: left;
}

.checkbox-row {
  min-height: 50px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--card);
  font-size: 14px;
  line-height: 1.35;
}

.checkbox-row input {
  width: 22px;
  height: 22px;
  flex: 0 0 auto;
}

.form-grid {
  gap: 16px;
}

.form-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.form-grid.was-validated :is(input, select, textarea):invalid {
  border-color: var(--red);
  box-shadow: 0 0 0 3px var(--red-soft);
}

.form-grid[data-submitting="true"] {
  pointer-events: none;
}

.form-grid[data-submitting="true"] .btn-primary {
  opacity: .72;
}

.form-grid[data-submitting="true"] .btn-primary::after {
  content: "";
  width: 15px;
  height: 15px;
  border: 2px solid rgba(255,255,255,.45);
  border-top-color: #fff;
  border-radius: 50%;
  animation: native-spin .7s linear infinite;
}

#dialog-root {
  top: var(--app-viewport-offset, 0px);
  bottom: auto;
  height: var(--app-viewport-height, 100dvh);
}

.dialog-backdrop {
  height: 100%;
  padding-top: 8px;
  overscroll-behavior: none;
}

.dialog {
  width: 100%;
  max-width: 520px;
  max-height: calc(100% - 8px);
  padding: 10px 16px calc(18px + var(--safe-bottom));
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  scroll-padding-bottom: calc(90px + var(--safe-bottom));
}

.dialog-header {
  position: sticky;
  top: -10px;
  z-index: 5;
  margin: 0 -2px 14px;
  padding: 8px 2px 10px;
  background: color-mix(in srgb, var(--app-bg) 92%, transparent);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
}

.dialog-actions {
  position: sticky;
  bottom: calc(-18px - var(--safe-bottom));
  z-index: 6;
  margin: 6px -16px calc(-18px - var(--safe-bottom));
  padding: 12px 16px calc(12px + var(--safe-bottom));
  background: color-mix(in srgb, var(--app-bg) 94%, transparent);
  border-top: 1px solid var(--line);
  -webkit-backdrop-filter: saturate(180%) blur(22px);
  backdrop-filter: saturate(180%) blur(22px);
}

.dialog-actions:has(.btn-danger) {
  flex-wrap: wrap;
}

.dialog-actions:has(.btn-danger) .btn-primary {
  order: 1;
  flex: 1 1 100%;
}

.dialog-actions:has(.btn-danger) .btn-danger {
  order: 2;
  flex: 1 1 100%;
  background: transparent;
  border-color: var(--red-soft);
}

.store-header {
  padding: 10px 16px 12px;
}

.store-content {
  padding: 10px 16px 24px;
  -webkit-overflow-scrolling: touch;
}

.store-footer {
  padding: 12px 16px calc(12px + var(--safe-bottom));
}

.price-input {
  width: 94px;
  min-height: 46px;
  text-align: right;
}

.auth-screen {
  min-height: 100%;
  height: 100%;
  padding: calc(var(--safe-top) + 28px) 18px calc(var(--safe-bottom) + 24px);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.auth-card {
  width: min(100%, 440px);
}

.keyboard-open .app {
  grid-template-rows: auto minmax(0, 1fr);
}

.keyboard-open .tab-bar {
  display: none;
}

.keyboard-open .content-scroll {
  padding-bottom: 16px;
  scroll-padding-bottom: 120px;
}

.keyboard-open #toast-root {
  display: none;
}

.keyboard-open .dialog {
  max-height: 100%;
  border-radius: 20px 20px 0 0;
}

.keyboard-open .dialog-actions {
  bottom: -18px;
  padding-bottom: 12px;
  margin-bottom: -18px;
}

img,
video,
canvas,
svg {
  -webkit-user-drag: none;
  user-drag: none;
}

@media (max-width: 430px) {
  .form-row {
    grid-template-columns: 1fr;
  }

  .dialog {
    border-radius: 24px 24px 0 0;
  }

  .settings-tools,
  .money-actions {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 640px) and (min-height: 700px) {
  html.is-browser #app-shell {
    width: min(100%, 430px);
    height: min(900px, calc(100dvh - 28px));
    margin: 14px auto;
    border-radius: 24px;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
    overflow: hidden;
  }
}

@keyframes native-spin {
  to { transform: rotate(360deg); }
}

.required-mark {
  margin-left: 3px;
  color: var(--red);
  font-weight: 850;
}

:is(input, select, textarea)[aria-invalid="true"] {
  border-color: var(--red);
  box-shadow: 0 0 0 3px var(--red-soft);
}
