:root {
  color-scheme: light;
  --app-bg: #f0eee9;
  --frame-bg: #e5e2dc;
  --card: #ffffff;
  --surface: #f2f1ec;
  --surface-2: #e8e6e0;
  --surface-3: #dedcd5;
  --text: #14141a;
  --muted: #6b6b74;
  --faint: #9b9ba4;
  --line: #e8e6e0;
  --accent: #4a5bd6;
  --accent-soft: rgba(74, 91, 214, .12);
  --accent-line: rgba(74, 91, 214, .22);
  --accent-strong: #3446c5;
  --red: #d93f36;
  --red-soft: rgba(217, 63, 54, .12);
  --orange: #c2760f;
  --orange-soft: rgba(194, 118, 15, .12);
  --green: #17915a;
  --green-soft: rgba(23, 145, 90, .12);
  --purple: #7c5cf0;
  --yellow: #c99400;
  --shadow: 0 12px 38px rgba(20, 20, 26, .12);
  --shadow-soft: 0 1px 2px rgba(20, 20, 26, .05);
  --radius-xl: 18px;
  --radius-lg: 14px;
  --radius-md: 11px;
  --radius-sm: 8px;
  --safe-top: max(0px, env(safe-area-inset-top));
  --safe-bottom: max(10px, env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  font-synthesis: none;
}

[data-theme="dark"] {
  color-scheme: dark;
  --app-bg: #0f0f12;
  --frame-bg: #08080a;
  --card: #1b1b20;
  --surface: #26262c;
  --surface-2: #2f2f37;
  --surface-3: #3a3a44;
  --text: #f1f1f3;
  --muted: #a2a2ab;
  --faint: #7e7e88;
  --line: #2f2f37;
  --accent: #7b8cff;
  --accent-soft: rgba(123, 140, 255, .18);
  --accent-line: rgba(123, 140, 255, .25);
  --accent-strong: #9aa6ff;
  --red: #ff6259;
  --red-soft: rgba(255, 98, 89, .16);
  --orange: #f0a83c;
  --orange-soft: rgba(240, 168, 60, .16);
  --green: #3fc47c;
  --green-soft: rgba(63, 196, 124, .16);
  --purple: #9b82ff;
  --yellow: #f3cb55;
  --shadow: 0 18px 46px rgba(0, 0, 0, .42);
  --shadow-soft: 0 1px 1px rgba(0, 0, 0, .18);
}

* { box-sizing: border-box; }
html {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  touch-action: pan-y;
  overscroll-behavior: none;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}
body {
  width: 100%;
  min-width: 0;
  max-width: 100vw;
  min-height: 100%;
  height: 100dvh;
  margin: 0;
  background: var(--frame-bg);
  color: var(--text);
  display: grid;
  place-items: center;
  overflow: hidden;
  touch-action: pan-y;
  overscroll-behavior: none;
  -webkit-user-select: none;
  user-select: none;
}
button, input, select, textarea { font: inherit; color: inherit; }
input, select, textarea { -webkit-user-select: text; user-select: text; }
img, video, canvas, svg { max-width: 100%; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
::selection { background: var(--accent-soft); }

#app-shell {
  position: relative;
  width: min(100%, 430px);
  max-width: 100vw;
  min-width: 0;
  height: 100dvh;
  max-height: 920px;
  overflow: hidden;
  background: var(--app-bg);
  isolation: isolate;
  touch-action: pan-y;
}

@media (min-width: 640px) and (min-height: 700px) {
  #app-shell {
    height: min(900px, calc(100dvh - 28px));
    border-radius: 22px;
    box-shadow: var(--shadow);
    border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
  }
}

.boot-screen {
  height: 100%;
  display: grid;
  place-content: center;
  gap: 14px;
  text-align: center;
  color: var(--muted);
}
.boot-logo {
  width: 54px;
  height: 54px;
  margin: 0 auto;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: var(--accent);
  color: white;
  font-size: 28px;
  font-weight: 850;
}

.app {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) 64px;
  background: var(--app-bg);
}
.page-header {
  min-height: 56px;
  padding: 6px 14px 7px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  background: var(--app-bg);
}
.page-title-wrap { min-width: 0; }
.eyebrow {
  margin: 0 0 5px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .02em;
}
.page-title {
  margin: 0;
  font-size: 25px;
  line-height: .98;
  font-weight: 850;
  letter-spacing: -.045em;
}
.page-title.compact { font-size: 23px; }
.header-actions { display: flex; align-items: center; gap: 7px; }

.content-scroll {
  min-width: 0;
  max-width: 100%;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  touch-action: pan-y;
  overscroll-behavior: contain;
  scrollbar-width: none;
  padding: 4px 14px 18px;
}
.content-scroll::-webkit-scrollbar { display: none; }
.content-stack { display: grid; gap: 12px; }
.section { display: grid; gap: 8px; }
.section-title-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.section-title {
  margin: 0;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: -.01em;
}
.section-meta { color: var(--muted); font-size: 10px; font-weight: 700; }
.section-meta.danger { color: var(--red); }

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}
.card.pad { padding: 14px; }
.card.flat { box-shadow: none; }
.card.dark-card {
  background: var(--text);
  color: var(--app-bg);
  border-color: transparent;
}
[data-theme="dark"] .card.dark-card {
  background: var(--surface-2);
  color: var(--text);
  border-color: var(--surface-3);
}

.icon-button, .round-button {
  border: 0;
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  background: var(--surface);
  color: var(--muted);
}
.icon-button { width: 34px; height: 34px; border-radius: 11px; }
.round-button { width: 35px; height: 35px; border-radius: 50%; }
.icon-button:hover, .round-button:hover { background: var(--surface-2); color: var(--text); }
.round-button.primary, .icon-button.primary { background: var(--accent); color: white; }
.icon-button.small { width: 29px; height: 29px; border-radius: 9px; }

.btn {
  min-height: 40px;
  padding: 0 15px;
  border: 1px solid transparent;
  border-radius: 11px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}
.btn-primary { background: var(--accent); color: #fff; }
.btn-primary:hover { background: var(--accent-strong); }
.btn-secondary { background: var(--card); border-color: var(--line); }
.btn-secondary:hover { background: var(--surface); }
.btn-soft { background: var(--surface); color: var(--text); }
.btn-soft:hover { background: var(--surface-2); }
.btn-danger { background: var(--red-soft); color: var(--red); }
.btn-success { background: var(--green); color: #fff; }
.btn.block { width: 100%; }
.btn.small { min-height: 31px; padding: 0 10px; font-size: 11px; border-radius: 9px; }
.btn:disabled { opacity: .45; cursor: not-allowed; }

.pill {
  min-height: 27px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--card);
  padding: 0 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 750;
}
.pill.active { border-color: var(--accent-line); background: var(--accent); color: #fff; }
.pill.dashed { border-style: dashed; background: transparent; }

.segmented {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: 1fr;
  gap: 3px;
  padding: 3px;
  background: var(--surface);
  border-radius: 12px;
}
.segmented button {
  min-height: 33px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
}
.segmented button.active { background: var(--card); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.06); }

.metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
.metric-card { padding: 13px 14px; }
.metric-label { color: var(--muted); font-size: 10px; font-weight: 750; margin-bottom: 5px; }
.metric-value { font-size: 18px; font-weight: 850; letter-spacing: -.035em; }
.metric-value.big { font-size: 27px; line-height: 1; }
