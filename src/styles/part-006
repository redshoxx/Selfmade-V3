

/* Version 15 – iPhone-12 Layoutkorrekturen und kompakte native Dialoge */
:root {
  --iphone-tab-content-height: 49px;
}

.tab-bar {
  margin: 0;
  min-height: calc(var(--iphone-tab-content-height) + var(--safe-bottom));
  padding: 3px 8px max(3px, var(--safe-bottom));
  border: 0;
  border-top: 1px solid var(--line);
  border-radius: 0;
  box-shadow: 0 -8px 28px rgba(15, 23, 42, .08);
  align-items: stretch;
}

.tab-button {
  min-height: 46px;
  border-radius: 12px;
  gap: 2px;
  font-size: 9px;
  line-height: 1.05;
}

.tab-icon svg {
  width: 21px;
  height: 21px;
}

.content-scroll {
  scroll-padding-bottom: calc(68px + var(--safe-bottom));
}

.dialog-backdrop {
  padding-top: max(8px, var(--safe-top));
}

.dialog {
  width: 100%;
  max-height: calc(100% - max(8px, var(--safe-top)));
  padding: 8px 14px 0;
  border-radius: 24px 24px 0 0;
  scroll-padding-top: 58px;
  scroll-padding-bottom: calc(76px + var(--safe-bottom));
}

.dialog-handle {
  margin-bottom: 8px;
}

.dialog-header {
  top: -8px;
  min-height: 52px;
  margin: 0 -2px 10px;
  padding: 6px 2px 8px;
}

.dialog-title {
  font-size: 20px;
  line-height: 1.08;
}

.form-grid {
  gap: 12px;
}

.field {
  gap: 5px;
}

.field label {
  font-size: 12px;
  line-height: 1.2;
}

.input,
.select,
.textarea,
.price-input,
.composer-input {
  min-height: 48px;
  border-radius: 13px;
  padding-inline: 13px;
}

.textarea {
  min-height: 108px;
  padding-block: 11px;
}

.form-row {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.checkbox-row {
  min-height: 48px;
  padding: 9px 11px;
}

.dialog-actions {
  position: sticky;
  bottom: 0;
  margin: 8px -14px 0;
  padding: 10px 14px calc(10px + var(--safe-bottom));
  gap: 8px;
}

.dialog-actions .btn {
  min-width: 0;
  min-height: 46px;
}

.dialog-actions:has(.btn-danger) {
  flex-wrap: nowrap;
}

.dialog-actions:has(.btn-danger) .btn-primary,
.dialog-actions:has(.btn-danger) .btn-danger {
  order: initial;
  flex: 1 1 0;
}

.dialog-actions:has(.btn-danger) .btn-danger {
  background: transparent;
  border-color: color-mix(in srgb, var(--red) 28%, var(--line));
}

.dialog:has(.scanner-panel) {
  overflow-x: hidden;
}

.dialog:has(.scanner-panel) .scanner-panel {
  width: 100%;
  height: clamp(220px, 34svh, 286px);
  min-height: 0;
  max-height: 286px;
  flex: 0 0 auto;
  margin-bottom: 10px;
  border-radius: 18px;
}

.dialog:has(.scanner-panel) .scanner-panel video {
  width: 100%;
  height: 100%;
  min-height: 0;
  max-height: none;
  aspect-ratio: auto;
  object-fit: cover;
}

.dialog:has(.scanner-panel) .scanner-frame {
  inset: auto 24px;
  top: 50%;
  height: 108px;
  transform: translateY(-50%);
  border-radius: 16px;
}

.dialog:has(.scanner-panel) .scanner-status {
  min-height: 40px;
  margin-bottom: 10px;
  padding: 9px 11px;
  font-size: 10.5px;
}

.dialog:has(.scanner-panel) .dialog-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.dialog:has(.scanner-panel) .dialog-actions .btn-primary {
  grid-column: 1 / -1;
}

.dialog:has(.scanner-panel) .camera-capture-button,
.dialog:has(.scanner-panel) .dialog-actions .btn {
  width: 100%;
  justify-content: center;
  text-align: center;
}

.keyboard-open .dialog {
  max-height: 100%;
}

.keyboard-open .dialog-actions {
  bottom: 0;
  margin-bottom: 0;
  padding-bottom: 10px;
}

@media (max-width: 359px) {
  .form-row {
    grid-template-columns: 1fr;
  }

  .dialog-actions:has(.btn-danger) {
    flex-wrap: wrap;
  }

  .dialog-actions:has(.btn-danger) .btn-primary,
  .dialog-actions:has(.btn-danger) .btn-danger {
    flex: 1 1 100%;
  }
}

@media (min-width: 360px) and (max-width: 430px) {
  .settings-tools,
  .money-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.dialog:has(.scanner-panel) .scanner-torch-button[hidden] {
  display: none !important;
}
